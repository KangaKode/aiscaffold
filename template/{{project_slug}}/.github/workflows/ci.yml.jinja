name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# Four jobs: test/lint/security run in parallel; summary is the single
# required check to configure in branch protection (see docs/OPERATIONS.md).
# Every GitHub Actions expression in this file is wrapped in a Jinja
# raw block so Copier does not consume the leading dollar-brace pair
# during rendering into the generated project.

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["{{ python_version }}"]

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python {% raw %}${{ matrix.python-version }}{% endraw %}
        uses: actions/setup-python@v5
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}

      - name: Cache pip
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: {% raw %}${{ runner.os }}-pip-${{ hashFiles('requirements.txt') }}{% endraw %}

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install -e .

      - name: Architecture tests (P0)
        run: python -m pytest tests/test_architecture.py -v --tb=short -m "p0"

      - name: P0 critical tests
        run: python -m pytest tests/ -v --tb=short -m "p0"

      - name: P1 important tests
        run: python -m pytest tests/ -v --tb=short -m "p1"

      - name: Full test suite with coverage
        run: python -m pytest tests/ --cov --cov-report=term-missing --tb=short -q

  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "{{ python_version }}"

      - name: Install linters
        run: pip install ruff black

      - name: Check formatting
        run: black --check --diff .

      - name: Lint
        run: ruff check .

  security:
    runs-on: ubuntu-latest
    steps:
      # fetch-depth: 0 is REQUIRED for Gitleaks to walk full local history
      # of the generated project; a shallow clone would only scan the head
      # commit and reintroduced secrets from older commits would slip past.
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: actions/setup-python@v5
        with:
          python-version: "{{ python_version }}"

      # Bandit stays in the security job (moved out of lint). Formatting
      # and lint checks live in `lint`; scanners live here so a security
      # regression can be gated independently in branch protection via
      # the `summary` job (which needs test + lint + security).
      - name: Install security tooling
        run: |
          python -m pip install --upgrade pip
          pip install bandit pip-audit==2.10.1

      # Install the same base + development set the test job installs,
      # PLUS every rendered optional extra from pyproject.toml, so
      # pip-audit sees the resolved dependency graph that a generated
      # project actually uses in production. The `load` extra is only
      # rendered into pyproject.toml.jinja when the API gateway is
      # present, so it is only installed conditionally here; the
      # unconditional extras (postgres, mcp, metrics, otel) always
      # install. The bracket-form extras spec is preceded by ``.`` (the
      # project source) so this survives the "must be preceded by a
      # package target" contract check in tests/test_ci_security.py.
      - name: Install project with all rendered extras
        run: |
          pip install -r requirements.txt
          pip install ".[postgres,mcp,metrics,otel{% if include_api_gateway %},load{% endif %}]"

      - name: Run Bandit (medium+ severity)
        run: bandit -r src/{{ project_slug }} -ll --quiet

      # Gitleaks: full-history secret scan pinned to a commit SHA (not a
      # tag) so a compromised or moved tag cannot ship a different
      # scanner into this workflow.
      #
      # GITLEAKS_LICENSE: this action is license-free for public repos
      # and personal accounts. If your generated project lives inside a
      # GitHub *organization*, register a Gitleaks license and expose it
      # to CI as a repository secret named GITLEAKS_LICENSE -- documented
      # in docs/OPERATIONS.md; the scaffold cannot solve this for you.
      - name: Run Gitleaks (full history)
        uses: gitleaks/gitleaks-action@ff98106e4c7b2bc287b24eaf42907196329070c7
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      # pip-audit runs through the fail-closed exceptions gate: any
      # exception row must declare id/reason/owner/compensating_control/
      # expires, unexpired, no duplicates. An empty list is fine; the
      # gate then invokes pip-audit with no --ignore-vuln pairs.
      - name: Audit dependencies with pip-audit gate
        run: |
          python scripts/pip_audit_gate.py \
            --exceptions .github/pip-audit-exceptions.json

  summary:
    # `summary` is the SINGLE check to require in branch protection: it
    # aggregates test + lint + security. `if: always()` runs even when
    # a dependency fails, and the run script exits nonzero unless every
    # dependency reports `success`, so a scanner failure blocks the
    # merge without the maintainer having to enumerate each job in the
    # protection rule.
    runs-on: ubuntu-latest
    needs: [test, lint, security]
    if: always()
    steps:
      - name: Check results
        run: |
          if [ "{% raw %}${{ needs.test.result }}{% endraw %}" != "success" ] || \
             [ "{% raw %}${{ needs.lint.result }}{% endraw %}" != "success" ] || \
             [ "{% raw %}${{ needs.security.result }}{% endraw %}" != "success" ]; then
            echo "CI FAILED"
            echo "  test: {% raw %}${{ needs.test.result }}{% endraw %}"
            echo "  lint: {% raw %}${{ needs.lint.result }}{% endraw %}"
            echo "  security: {% raw %}${{ needs.security.result }}{% endraw %}"
            exit 1
          fi
          echo "All CI checks passed"
