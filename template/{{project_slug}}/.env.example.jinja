# {{ project_name }} Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

{% if llm_provider == 'anthropic' -%}
# Anthropic (Claude)
ANTHROPIC_API_KEY=your-key-here
{% elif llm_provider == 'openai' -%}
# OpenAI
OPENAI_API_KEY=your-key-here
{% elif llm_provider == 'google' -%}
# Google (Gemini)
GOOGLE_API_KEY=your-key-here
{% elif llm_provider == 'multi' -%}
# LLM Providers (configure at least one)
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here
{% endif -%}

{% if persistence == 'postgres' -%}
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/{{ project_slug }}
{% elif persistence == 'sqlite' -%}
# Database (SQLite - default path)
# DATABASE_PATH=data/{{ project_slug }}.db
{% endif -%}

{% if include_api_gateway -%}
# API Gateway
# Set API_KEY to enable authentication. Leave empty to disable (dev mode).
# CRITICAL: Always set API_KEY in production.
# API_KEY=your-secret-api-key
API_HOST=0.0.0.0
API_PORT=8000

# CORS (comma-separated origins, default: localhost only)
# CORS_ORIGINS=https://myapp.com,https://admin.myapp.com

# Rate limiting (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60

# Webhook signing secret (HMAC-SHA256). Set to verify webhook payloads.
# WEBHOOK_SECRET=your-webhook-secret

# Environment (set to 'production' to enforce security checks)
# ENV=development
{% endif -%}

# Learning system storage backend: "sqlite" (default) or "postgres".
# Postgres requires the optional extra: pip install '.[postgres]'
LEARNING_BACKEND={{ learning_backend }}
{% if learning_backend == 'postgres' -%}
LEARNING_POSTGRES_DSN=postgresql://user:password@localhost:5432/{{ project_slug }}_learning
{% else -%}
# LEARNING_POSTGRES_DSN=postgresql://user:password@localhost:5432/{{ project_slug }}_learning
{% endif -%}
# Character budget for the approved-corrections prompt block (default 4000).
# CORRECTION_CONTEXT_BUDGET=4000
# Max GDPR correction erasures per tenant per 24h (default 10).
# ERASURE_DAILY_CAP=10

# Per-request activity tracking + anomaly review API (default enabled).
# Degrades to no-op when the learning store is unavailable.
# ACTIVITY_TRACKING_ENABLED=true

# Agent Identity (JWT tokens for agent verification at dispatch)
# Signing key for agent identity tokens. Required in production (64+ chars).
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# AGENT_IDENTITY_SIGNING_KEY=your-64-char-hex-key
# Kill switch: set to 'false' to skip cryptographic verification (dev only;
# token expiry is still enforced, and 'false' is ignored in production).
# AGENT_IDENTITY_ENABLED=true
# Days without dispatch activity before an agent is flagged dormant (default 30).
# AGENT_DORMANT_AFTER_DAYS=30

# Model routing: map call roles to cost tiers (nano/budget/standard/frontier)
# with cascade fallback, a circuit breaker, and budget-aware downgrades.
# Off by default (single-model path unchanged).
# MODEL_ROUTING_ENABLED=true
# Override the example tier -> models map (cheapest first per tier):
# MODEL_TIER_MAP_JSON={"nano":["my-cheap-model"],"standard":["my-model"]}
# Override role -> tier assignments:
# ROLE_TIER_MAP_JSON={"chat_synthesis":"standard","my_role":"budget"}

# MCP connectors: persist registered servers to a JSON file (in-memory
# only when unset). Real transport needs the extra: pip install '.[mcp]'
# MCP_REGISTRY_PATH=data/mcp_servers.json
# Server credentials are env var REFERENCES named MCP_* -- register a
# server with credential_env_var=MCP_TICKETS_TOKEN, then set:
# MCP_TICKETS_TOKEN=your-secret-token

# Output signing (HMAC-SHA256 attestation of synthesized outputs).
# Required in production (64+ chars); dev auto-generates an ephemeral key.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# OUTPUT_SIGNING_KEY=your-64-char-hex-key

# Logging
LOG_LEVEL=INFO
