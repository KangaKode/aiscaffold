# {{ project_name }} Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

{% if llm_provider == 'anthropic' -%}
# Anthropic (Claude)
ANTHROPIC_API_KEY=your-key-here
{% elif llm_provider == 'openai' -%}
# OpenAI
OPENAI_API_KEY=your-key-here
{% elif llm_provider == 'google' -%}
# Google (Gemini)
GOOGLE_API_KEY=your-key-here
{% elif llm_provider == 'multi' -%}
# LLM Providers (configure at least one)
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here
{% endif -%}

{% if persistence == 'postgres' -%}
# App database FOR YOUR OWN CODE (docker-compose provisions the server and
# injects this URL; no shipped runtime module reads it -- the built-in
# learning store is configured by LEARNING_BACKEND below).
DATABASE_URL=postgresql://user:password@localhost:5432/{{ project_slug }}
{% elif persistence == 'sqlite' -%}
# App database path FOR YOUR OWN CODE (docker-compose injects it; no shipped
# runtime module reads it -- the built-in learning store is configured by
# LEARNING_BACKEND below).
# DATABASE_PATH=data/{{ project_slug }}.db
{% endif -%}

# Environment (set to 'production' to enforce security checks: API auth,
# agent-identity and output-signing keys). Read as ENV, then ENVIRONMENT.
# ENV=development

{% if include_api_gateway -%}
# API Gateway
# Set API_KEY to enable authentication. Leave empty to disable (dev mode).
# CRITICAL: Always set API_KEY in production.
# API_KEY=your-secret-api-key
# Dev-only kill switch: skip API-key auth even when API_KEY is set
# (ignored in production).
# AUTH_DISABLED=false

# Bind address/port for `python -m {{ project_slug }}` (the Docker CMD).
# `make serve` passes its own explicit --host/--port flags.
# Defaults: 127.0.0.1:8000. Keep API_HOST commented out for container use:
# docker-compose loads this file via env_file, and an active
# API_HOST=127.0.0.1 here would override the image's API_HOST=0.0.0.0 and
# bind uvicorn to the container's loopback (published port goes dead).
# API_HOST=127.0.0.1
# API_PORT=8000

# CORS (comma-separated origins, default: localhost only)
# CORS_ORIGINS=https://myapp.com,https://admin.myapp.com

# Rate limiting (requests per minute per client IP). Per process: N
# workers/replicas effectively multiply this -- see docs/OPERATIONS.md.
RATE_LIMIT_PER_MINUTE=60
{% endif -%}

# LLM provider override. "mock" runs the deterministic offline
# MockLLMClient (no API key, zero cost){% if include_api_gateway and include_deployment %} -- used by the load harness
# (docker-compose.load.yml) and{% elif include_api_gateway %} -- used by the load harness
# (see docs/OPERATIONS.md) and{% else %},{% endif %} useful for demos/local development.
# LLM_PROVIDER=mock

# Learning system storage backend: "sqlite" (default) or "postgres".
# Postgres requires the optional extra: pip install '.[postgres]'
LEARNING_BACKEND={{ learning_backend }}
{% if learning_backend == 'postgres' -%}
LEARNING_POSTGRES_DSN=postgresql://user:password@localhost:5432/{{ project_slug }}_learning
{% else -%}
# LEARNING_POSTGRES_DSN=postgresql://user:password@localhost:5432/{{ project_slug }}_learning
{% endif -%}
# Character budget for the approved-corrections prompt block (default 4000).
# CORRECTION_CONTEXT_BUDGET=4000
# Max approved corrections fetched (newest first) when building that block
# (default 500). A one-time warning fires if a fetch saturates the cap --
# older corrections are then absent from prompt grounding.
# CORRECTION_CONTEXT_FETCH_CAP=500
# Max GDPR correction erasures per tenant per 24h (default 10).
# ERASURE_DAILY_CAP=10
# Days before an approved correction counts as stale (knowledge aging;
# freshness = last_validated_at, falling back to updated_at). Default 90.
# CORRECTION_STALE_DAYS=90
# Max governance reports per user per 24h (default 10).
# REPORT_DAILY_CAP=10
# Seconds a cached per-tenant budget-cap config is trusted before being
# re-read from the store (default 60). Cross-replica cap changes converge
# within this TTL.
# BUDGET_CONFIG_TTL_SECONDS=60

# Per-request activity tracking + anomaly review API (default enabled).
# Degrades to no-op when the learning store is unavailable.
# ACTIVITY_TRACKING_ENABLED=true
# Opt-in retention: prune activity_events older than N days (default OFF --
# unset/0 keeps every event forever). Runs best-effort on the sampled
# detection pass, bounded batches; see docs/OPERATIONS.md.
# ACTIVITY_RETENTION_DAYS=90

# Extraction defense (detection-first: findings become integrity flags).
# Run burst-threshold + timing checks every Nth recorded request (default 25).
# ACTIVITY_CHECK_SAMPLE_N=25
# Min inter-request intervals before the timing CV check gives a verdict.
# TIMING_MIN_SAMPLES=20
# Flag when interval CV (stddev/mean) falls BELOW this (machine-like cadence).
# TIMING_CV_THRESHOLD=0.1
# Rolling window for the timing CV series, in minutes.
# TIMING_WINDOW_MINUTES=60
# Knowledge-read volume guard: per-user and tenant-wide read counts per window.
# EXTRACTION_USER_THRESHOLD=60
# EXTRACTION_TENANT_THRESHOLD=300
# EXTRACTION_WINDOW_MINUTES=60
# Opt-in enforcement: GET /corrections returns 429 + Retry-After while capped.
# EXTRACTION_GUARD_ENFORCE=false
# Directed proposer->approver pairs flagged above this count per window.
# PAIR_APPROVAL_THRESHOLD=5
# PAIR_WINDOW_DAYS=7
# User-message injection scan (detect-only): escalate the unresolved
# per-(surface, tenant) integrity flag to error severity after this many
# repeated hits (minimum 2).
# USER_SCAN_ESCALATE_AFTER=10

# Agent Identity (JWT tokens for agent verification at dispatch)
# Signing key for agent identity tokens. Required in production (64+ chars).
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# AGENT_IDENTITY_SIGNING_KEY=your-64-char-hex-key
# Kill switch: set to 'false' to skip cryptographic verification (dev only;
# token expiry is still enforced, and 'false' is ignored in production).
# AGENT_IDENTITY_ENABLED=true
# Days without dispatch activity before an agent is flagged dormant (default 30).
# AGENT_DORMANT_AFTER_DAYS=30
# Identity token lifetime: default and maximum TTL in days (defaults 7 / 30).
# AGENT_DEFAULT_TTL_DAYS=7
# AGENT_MAX_TTL_DAYS=30

# Autonomy policy overrides: JSON mapping of autonomy level -> partial policy
# fields (parsed once per process; invalid entries are logged and ignored).
# AUTONOMY_POLICIES={"2": {"max_actions_per_run": 5}}

# RAG (learning system semantic search). Both default off/fallback:
# EMBEDDING_PROVIDER: fallback (deterministic hash) | local | openai | auto
# NOTE: with "fallback" the vectors carry no meaning; the default
# in-memory store then ranks by keyword matching instead. Chroma has no
# keyword path (fallback vectors are stored as-is; ranking is noise) --
# set local/openai/auto for real semantic search.
# ("openai"/"auto" use OPENAI_API_KEY; "local" needs sentence-transformers).
# EMBEDDING_PROVIDER=fallback
# Vector store: set USE_CHROMA=1 to persist with chromadb (pip install
# chromadb); default is a deterministic in-memory store, except that an
# existing data/chroma directory is reused automatically.
# USE_CHROMA=0

# Model routing: map call roles to cost tiers (nano/budget/standard/frontier)
# with cascade fallback, a circuit breaker, and budget-aware downgrades.
# Off by default (single-model path unchanged).
# MODEL_ROUTING_ENABLED=true
# Override the example tier -> models map (cheapest first per tier):
# MODEL_TIER_MAP_JSON={"nano":["my-cheap-model"],"standard":["my-model"]}
# Override role -> tier assignments:
# ROLE_TIER_MAP_JSON={"chat_synthesis":"standard","my_role":"budget"}

# MCP connectors: persist registered servers to a JSON file (in-memory
# only when unset). Real transport needs the extra: pip install '.[mcp]'
# MCP_REGISTRY_PATH=data/mcp_servers.json
# Server credentials are env var REFERENCES named MCP_* -- register a
# server with credential_env_var=MCP_TICKETS_TOKEN, then set:
# MCP_TICKETS_TOKEN=your-secret-token

{% if include_evals -%}
# Evals: set to 1 to run the LLM-dependent eval suites against a real
# provider (costs money; default 0 keeps them skipped/mocked).
# EVAL_USE_REAL_LLM=0

{% endif -%}
# Output signing (HMAC-SHA256 attestation of synthesized outputs).
# Required in production (64+ chars); dev auto-generates an ephemeral key.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# OUTPUT_SIGNING_KEY=your-64-char-hex-key

# Root logging level (read by `python -m {{ project_slug }}`{% if include_api_gateway %} and the API
# gateway app factory{% endif %}; docker-compose forwards it into the container).
LOG_LEVEL=INFO
