[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_description }}"
requires-python = ">={{ python_version }}"
dependencies = [
{% if include_api_gateway -%}
    "fastapi>=0.115",
    "uvicorn>=0.32",
    "pydantic>=2.0",
{% endif -%}
    # httpx is unconditional: the agent registry's remote-agent adapter
    # (agents/remote.py) speaks HTTP regardless of the API gateway toggle.
    "httpx>=0.27",
{% if llm_provider == 'anthropic' -%}
    "anthropic>=0.40",
{% elif llm_provider == 'openai' -%}
    "openai>=1.50",
{% elif llm_provider == 'google' -%}
    "google-generativeai>=0.8",
{% elif llm_provider == 'multi' -%}
    "anthropic>=0.40",
    "openai>=1.50",
{% endif -%}
{% if project_type == 'cli-tool' -%}
    "typer>=0.12",
    "rich>=13.0",
{% endif -%}
{% if persistence == 'postgres' -%}
    "psycopg2-binary>=2.9",
{% endif -%}
    "python-dotenv>=1.0",
    "pyjwt>=2.8",
]

[project.optional-dependencies]
# Learning store Postgres backend (LEARNING_BACKEND=postgres)
postgres = ["psycopg[binary]>=3.1"]
# MCP connectors real transport (connectors/mcp_client.py)
mcp = ["mcp>=1.0"]
# Prometheus exposition at GET /metrics/prometheus (observability/metrics.py)
metrics = ["prometheus_client>=0.20"]
# Locust load harness (tests/load/locustfile.py) -- never a base dependency
load = ["locust>=2.20"]

[build-system]
requires = ["setuptools>=69", "wheel"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]
include = ["{{ project_slug }}*"]

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
python_functions = ["test_*"]
markers = [
    "p0: Critical path tests (run on every commit)",
    "p1: Important tests (run on every PR)",
    "smoke: Quick sanity checks",
    "slow: Tests taking >10s (nightly only)",
]
asyncio_mode = "auto"

[tool.black]
line-length = 120

[tool.ruff]
line-length = 120
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "W", "N", "UP"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"__init__.py" = ["F401"]

[tool.ruff.lint.isort]
known-first-party = ["{{ project_slug }}"]

[tool.bandit]
exclude_dirs = ["tests", "scripts", "venv"]

[tool.coverage.run]
source = ["src"]
omit = ["*/tests/*", "*/__pycache__/*"]
