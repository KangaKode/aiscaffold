# --- Governance report API ----------------------------------------------------


class TestGovernanceReportAPI:
    @pytest.fixture
    async def api(self, tmp_path, monkeypatch):
        """(client, store) pair -- gateway wired to a tmp-path learning store."""
        from httpx import ASGITransport, AsyncClient

        from {{project_slug}}.agents.registry import AgentRegistry
        from {{project_slug}}.api.gateway import create_app

        monkeypatch.delenv("API_KEY", raising=False)
        monkeypatch.delenv("ENV", raising=False)
        monkeypatch.setenv("ACTIVITY_TRACKING_ENABLED", "false")
        monkeypatch.chdir(tmp_path)

        app = create_app(registry=AgentRegistry(persist_path=tmp_path / "agents.json"))
        api_store = SqliteLearningStore(db_path=tmp_path / "api_learning.db")
        app.state.learning_store = api_store

        transport = ASGITransport(app=app)
        async with AsyncClient(transport=transport, base_url="http://test") as client:
            yield client, api_store

    async def test_report_round_trip_and_audit_event(self, api):
        client, api_store = api
        api_store.insert("corrections", correction_row(1))

        r = await client.get("/api/v1/reports/governance")
        assert r.status_code == 200
        body = r.json()
        assert body["tenant_id"] == "default"
        assert body["sections"]["corrections"]["by_status"] == {"approved": 1}
        assert body["reports_today"] == 1
        assert "SECRET-" not in r.text

        events = api_store.query("audit_events", {"event_type": REPORT_EVENT_TYPE})
        assert len(events) == 1

    async def test_tenant_scoping_via_api(self, api):
        client, api_store = api
        api_store.insert("corrections", correction_row(1, tenant="team-b"))

        r = await client.get("/api/v1/reports/governance")
        assert r.status_code == 200
        assert r.json()["sections"]["corrections"]["by_status"] == {}

    async def test_date_validation(self, api):
        client, _ = api
        r = await client.get("/api/v1/reports/governance?from_date=not-a-date")
        assert r.status_code == 422
        r = await client.get(
            "/api/v1/reports/governance?from_date=2026-02-01&to_date=2026-01-01"
        )
        assert r.status_code == 422
        r = await client.get(
            "/api/v1/reports/governance?from_date=2020-01-01&to_date=2026-01-01"
        )
        assert r.status_code == 422

    async def test_daily_cap_returns_429(self, api, monkeypatch):
        client, _ = api
        monkeypatch.setenv("REPORT_DAILY_CAP", "2")
        assert (await client.get("/api/v1/reports/governance")).status_code == 200
        assert (await client.get("/api/v1/reports/governance")).status_code == 200
        r = await client.get("/api/v1/reports/governance")
        assert r.status_code == 429
        assert "cap" in r.json()["detail"].lower()
