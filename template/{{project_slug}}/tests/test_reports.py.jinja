# --- Governance report API ----------------------------------------------------


class TestGovernanceReportAPI:
    @pytest.fixture
    async def api(self, tmp_path, monkeypatch):
        """(client, store) pair -- gateway wired to a tmp-path learning
        store, with the corrections manager rebound to the SAME store so
        lifecycle endpoints and the report see one database."""
        from httpx import ASGITransport, AsyncClient

        from {{project_slug}}.agents.registry import AgentRegistry
        from {{project_slug}}.api.gateway import create_app
        from {{project_slug}}.learning.corrections import CorrectionsManager

        monkeypatch.delenv("API_KEY", raising=False)
        monkeypatch.delenv("ENV", raising=False)
        monkeypatch.setenv("ACTIVITY_TRACKING_ENABLED", "false")
        monkeypatch.chdir(tmp_path)

        app = create_app(registry=AgentRegistry(persist_path=tmp_path / "agents.json"))
        api_store = SqliteLearningStore(db_path=tmp_path / "api_learning.db")
        app.state.learning_store = api_store
        app.state.corrections_manager = CorrectionsManager(api_store)

        transport = ASGITransport(app=app)
        async with AsyncClient(transport=transport, base_url="http://test") as client:
            yield client, api_store

    async def test_report_round_trip_and_audit_event(self, api):
        client, api_store = api
        api_store.insert("corrections", correction_row(1))

        r = await client.get("/api/v1/reports/governance")
        assert r.status_code == 200
        body = r.json()
        assert body["tenant_id"] == "default"
        assert body["sections"]["corrections"]["lifecycle_activity_by_status"] == {
            "approved": 1,
        }
        assert body["reports_today"] == 1
        assert "SECRET-" not in r.text

        events = api_store.query("audit_events", {"event_type": REPORT_EVENT_TYPE})
        assert len(events) == 1

    async def test_tenant_scoping_via_api(self, api):
        client, api_store = api
        api_store.insert("corrections", correction_row(1, tenant="team-b"))

        r = await client.get("/api/v1/reports/governance")
        assert r.status_code == 200
        assert r.json()["sections"]["corrections"][
            "lifecycle_activity_by_status"] == {}

    async def test_date_validation(self, api):
        client, _ = api
        r = await client.get("/api/v1/reports/governance?from_date=not-a-date")
        assert r.status_code == 422
        r = await client.get(
            "/api/v1/reports/governance?from_date=2026-02-01&to_date=2026-01-01"
        )
        assert r.status_code == 422
        r = await client.get(
            "/api/v1/reports/governance?from_date=2020-01-01&to_date=2026-01-01"
        )
        assert r.status_code == 422

    async def test_timezone_aware_dates_rejected_not_500(self, api):
        client, _ = api
        r = await client.get(
            "/api/v1/reports/governance"
            "?from_date=2026-01-01T00:00:00%2B00:00&to_date=2026-01-31"
        )
        assert r.status_code == 422
        r = await client.get(
            "/api/v1/reports/governance"
            "?from_date=2026-01-01&to_date=2026-01-31T00:00:00Z"
        )
        assert r.status_code == 422

    async def test_to_date_echoes_requested_value(self, api):
        client, _ = api
        r = await client.get(
            "/api/v1/reports/governance?from_date=2026-01-01&to_date=2026-01-15"
        )
        assert r.status_code == 200
        # The caller's bound, not the internal exclusive next-midnight one.
        assert r.json()["to_date"] == "2026-01-15"

    async def test_fresh_only_via_revalidation_through_api(self, api):
        """approve -> (time passes) -> revalidate via the endpoint: the
        metric must reflect it, which requires revalidate to leave
        updated_at untouched."""
        client, api_store = api
        from {{project_slug}}.learning.corrections import CorrectionsManager

        # Same store the fixture wired into the app -- propose/approve
        # directly, then drive revalidation over HTTP.
        manager = CorrectionsManager(api_store)
        correction = manager.propose(
            agent_id="analyst", original_claim="a", corrected_claim="b",
            reason="", evidence_level="documented", created_by="alice",
        )
        manager.approve(correction.id, approved_by="bob")
        # Simulate the approval having happened long ago.
        old = "2020-01-01T00:00:00"
        api_store.update(
            "corrections", correction.id,
            {"created_at": old, "updated_at": old},
        )

        r = await client.get("/api/v1/reports/governance")
        assert r.json()["sections"]["corrections"][
            "fresh_only_via_revalidation"] == 0

        # Revalidate through the real endpoint.
        r = await client.post(f"/api/v1/corrections/{correction.id}/revalidate")
        assert r.status_code == 200

        row = api_store.query("corrections", {"id": correction.id})[0]
        assert row["updated_at"] == old  # revalidate must not bump it
        assert row["last_validated_at"] != ""

        r = await client.get("/api/v1/reports/governance")
        section = r.json()["sections"]["corrections"]
        assert section["fresh_only_via_revalidation"] == 1
        assert section["revalidations_in_window"] == 1

    async def test_daily_cap_returns_429(self, api, monkeypatch):
        client, _ = api
        monkeypatch.setenv("REPORT_DAILY_CAP", "2")
        assert (await client.get("/api/v1/reports/governance")).status_code == 200
        assert (await client.get("/api/v1/reports/governance")).status_code == 200
        r = await client.get("/api/v1/reports/governance")
        assert r.status_code == 429
        assert "cap" in r.json()["detail"].lower()
