        r = await api.get("/api/v1/budgets/acme")
        assert r.status_code == 200
        data = r.json()
        assert data["tenant_id"] == "acme"
        assert data["max_budget_usd"] == 5.0
        assert data["warn_at"] == pytest.approx(0.5)

    async def test_audit_timeline_404_when_empty(self, api):
