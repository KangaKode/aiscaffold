class TestTracingNoop:
    def test_phase_span_without_otel_is_nullcontext(self):
        from contextlib import nullcontext

        from {{project_slug}}.observability import tracing

        if tracing.OTEL_AVAILABLE:
            pytest.skip("opentelemetry installed in this env; no-op branch untestable")
        span = tracing.phase_span("deliberation.phase.independent", agent_count=2)
        assert isinstance(span, nullcontext)
        with span:
            pass  # wrapped code runs unchanged

    def test_phase_span_with_otel_but_no_provider_is_inert(self):
        from {{project_slug}}.observability import tracing

        if not tracing.OTEL_AVAILABLE:
            pytest.skip("opentelemetry not installed; provider branch untestable")
        # The OTel API default (no provider configured) yields
        # non-recording spans; the wrapped block still runs and nothing
        # raises.
        ran = False
        with tracing.phase_span("chat.phase.synthesize", agent_count=1):
            ran = True
        assert ran

    @pytest.mark.asyncio
    async def test_instrumented_orchestrators_run_without_otel(self, mock_agents):
        """The span wrappers in RoundTable.run must be inert pass-throughs."""
        from {{project_slug}}.orchestration.round_table import (
            RoundTable,
            RoundTableConfig,
        )

        rt = RoundTable(
            agents=mock_agents,
            config=RoundTableConfig(
                enable_strategy_phase=False,
                enable_challenge_phase=False,
                include_core_agents=False,
            ),
        )
        result = await rt.run(RoundTableTask(id="span-test", content="x"))
        assert result.task_id == "span-test"
        assert len(result.analyses) == 2


