class TestMemoryWriteProvenance:
    def test_propose_defaults_to_library_surface(self, store):
        from {{project_slug}}.learning.corrections import CorrectionsManager

        correction = CorrectionsManager(store).propose(
            agent_id="analyst", original_claim="a", corrected_claim="b",
            reason="c", evidence_level="documented",
        )
        row = store.query("corrections", {"id": correction.id})[0]
        assert row["source_surface"] == "library"

    def test_propose_records_api_surface_when_told(self, store):
        from {{project_slug}}.learning.corrections import CorrectionsManager

        correction = CorrectionsManager(store).propose(
            agent_id="analyst", original_claim="a", corrected_claim="b",
            reason="c", evidence_level="documented", source_surface="api",
        )
        row = store.query("corrections", {"id": correction.id})[0]
        assert row["source_surface"] == "api"
        assert correction.source_surface == "api"

    def _result_with_findings(self):
        return SimpleNamespace(
            task_id="t1",
            synthesis=SynthesisResult(
                key_findings=[
                    {"agent_name": "analyst_a", "finding": "f1", "evidence": "e1"},
                    {"agent_name": "analyst_a", "finding": "f2", "evidence": "e2"},
                ],
            ),
            analyses=[], challenges=[], votes=[],
        )

    def test_reflect_threads_created_by(self, store):
        from {{project_slug}}.learning.reflector import reflect

        stored = reflect(
            self._result_with_findings(), tenant_id="default", store=store,
            created_by="alice",
        )
        assert stored
        rows = store.query("reflections", {"tenant_id": "default"})
        assert rows and all(r["created_by"] == "alice" for r in rows)

    def test_reflect_defaults_created_by_empty(self, store):
        from {{project_slug}}.learning.reflector import reflect

        reflect(self._result_with_findings(), tenant_id="default", store=store)
        rows = store.query("reflections", {"tenant_id": "default"})
        assert rows and all(r["created_by"] == "" for r in rows)


