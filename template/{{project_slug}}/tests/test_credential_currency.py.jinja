class TestExpiryVisibilityLibrary:
    def test_register_local_stores_iso_utc_expiry(self, mock_agent, tmp_path):
        from {{project_slug}}.agents.registry import AgentRegistry

        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        registry.register_local(mock_agent)
        entry = registry.get_entry(mock_agent.name)
        expires = datetime.fromisoformat(entry.identity_expires_at)
        assert expires.tzinfo is not None
        assert expires > datetime.now(UTC)
        assert entry.to_dict()["expires_at"] == entry.identity_expires_at

    def test_rotate_refreshes_and_revoke_clears_expiry(self, mock_agent, tmp_path):
        from {{project_slug}}.agents.registry import AgentRegistry

        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        registry.register_local(mock_agent)
        assert registry.rotate_credentials(mock_agent.name) is not None
        entry = registry.get_entry(mock_agent.name)
        assert entry.identity_expires_at
        registry.revoke_credentials(mock_agent.name)
        assert entry.identity_expires_at is None
        assert entry.to_dict()["expires_at"] is None

    def test_token_expires_at_matches_exp_claim(self):
        from {{project_slug}}.agents.identity import issue_token, token_expires_at

        token, ttl_days = issue_token("a1", "default", [])
        expires = datetime.fromisoformat(token_expires_at(token))
        remaining_days = (expires - datetime.now(UTC)).total_seconds() / 86400
        assert remaining_days == pytest.approx(ttl_days, abs=0.01)

    def test_unreadable_token_yields_empty_string(self):
        from {{project_slug}}.agents.identity import token_expires_at

        assert token_expires_at("not-a-jwt") == ""


