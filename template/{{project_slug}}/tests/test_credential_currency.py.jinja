class SuspendedRegistry:
    """Every agent resolves to a suspended entry -> identity gate blocks."""

    rate_limiter = None

    def entry_for_agent(self, agent):
        return SimpleNamespace(
            suspended=True,
            identity_token=None,
            agent_type="remote",
            capability=None,
            tenant_id="default",
        )

    def name_registered(self, name):
        return True


async def _drain_flag_writes():
    """Await any identity-flag writes still in flight on the loop."""
    pending = list(_pending_flag_writes)
    if pending:
        await asyncio.gather(*pending, return_exceptions=True)


def _identity_flags(store):
    return store.query("integrity_flags", {"flag_type": FLAG_TYPE_IDENTITY_BLOCKED})


# =============================================================================
# WS1a: identity-block integrity flag at the dispatch gates
# =============================================================================


class TestIdentityBlockFlag:
    def test_blocked_agent_records_flag_sync_path(self, mock_agents, sample_task, store):
        """No running loop (library sync caller): the flag lands inline."""
        gated, skipped = gate_agents(
            mock_agents, sample_task, SuspendedRegistry(), None, "Test", store=store
        )
        assert gated == [] and skipped == 2
        flags = _identity_flags(store)
        assert {f["subject_id"] for f in flags} == {"analyst_a", "analyst_b"}
        assert all(f["tenant_id"] == "default" for f in flags)
        assert "dispatch_gate_identity_block" in flags[0]["detail_json"]

    @pytest.mark.asyncio
    async def test_blocked_agent_records_flag_off_loop(
        self, mock_agents, sample_task, store
    ):
        """Inside a running loop the write is scheduled off-loop."""
        analyses, skipped, failed = await dispatch_with_gates(
            mock_agents, sample_task, SuspendedRegistry(), None, "Test", store=store
        )
        assert analyses == [] and skipped == 2
        await _drain_flag_writes()
        assert {f["subject_id"] for f in _identity_flags(store)} == {
            "analyst_a", "analyst_b",
        }

    def test_repeat_blocks_dedupe_into_hit_counter(self, mock_agent, sample_task, store):
        """record_flag_hit semantics: repeats update the one unresolved flag."""
        for _ in range(3):
            gate_agents(
                [mock_agent], sample_task, SuspendedRegistry(), None, "Test",
                store=store,
            )
        flags = _identity_flags(store)
        assert len(flags) == 1
        assert '"hits": 3' in flags[0]["detail_json"]

    def test_no_store_is_silent_noop(self, mock_agents, sample_task, store):
        gated, skipped = gate_agents(
            mock_agents, sample_task, SuspendedRegistry(), None, "Test"
        )
        assert gated == [] and skipped == 2
        assert _identity_flags(store) == []

    def test_unblocked_agents_record_nothing(self, mock_agents, sample_task, store):
        gated, skipped = gate_agents(
            mock_agents, sample_task, None, None, "Test", store=store
        )
        assert len(gated) == 2 and skipped == 0
        assert _identity_flags(store) == []

    def test_broken_store_never_fails_the_gate(self, mock_agents, sample_task):
        class ExplodingStore:
            def query(self, *a, **k):
                raise RuntimeError("db down")

            def insert(self, *a, **k):
                raise RuntimeError("db down")

        gated, skipped = gate_agents(
            mock_agents, sample_task, SuspendedRegistry(), None, "Test",
            store=ExplodingStore(),
        )
        assert gated == [] and skipped == 2  # gate outcome unchanged


