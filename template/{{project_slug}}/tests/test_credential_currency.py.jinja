        self, mock_agents, sample_task, recorder, store
    ):
        await run_voting_phase(
            mock_agents, sample_task, SynthesisResult(recommended_direction="go"),
            None, delegation_recorder=recorder,
        )
        rows = store.query("delegation_records", {"phase": "vote"})
        assert len(rows) == 2
        assert all(r["derived_from_json"] == '["synthesis"]' for r in rows)

    @pytest.mark.asyncio
    async def test_rows_land_in_callers_tenant(self, mock_agents, recorder, store):
        task = RoundTableTask(id="t-acme", content="x", tenant_id="acme")
        await dispatch_with_gates(
            mock_agents, task, None, None, "Test", delegation_recorder=recorder
        )
        rows = store.query("delegation_records", {"tenant_id": "acme"})
        assert len(rows) == 2

    @pytest.mark.asyncio
    async def test_broken_store_never_breaks_dispatch(self, mock_agents, sample_task):
        class ExplodingStore:
            def insert(self, *a, **k):
                raise RuntimeError("db down")

        analyses, skipped, failed = await dispatch_with_gates(
            mock_agents, sample_task, None, None, "Test",
            delegation_recorder=DelegationRecorder(ExplodingStore()),
        )
        assert len(analyses) == 2 and skipped == 0 and failed == 0

    @pytest.mark.asyncio
    async def test_record_dispatches_none_recorder_is_noop(self, sample_task):
        # Must not raise -- None recorder means the toggle is off.
        await record_dispatches(None, sample_task, "analyze", ["a"], [])


