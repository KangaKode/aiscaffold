# =============================================================================
# v8 migration correctness
# =============================================================================


class TestV8Migration:
    def test_baseline_ddl_is_frozen_pre_v8(self):
        """The v1 baseline must not learn the v8 columns (see tables.py)."""
        from {{project_slug}}.learning.tables import MIGRATIONS

        baseline = MIGRATIONS[0]
        audit_ddl = next(s for s in baseline if "audit_events" in s)
        assert "user_id" not in audit_ddl
        reflections_ddl = next(s for s in baseline if "reflections" in s)
        assert "created_by" not in reflections_ddl
        corrections_ddl = next(s for s in baseline if "corrections" in s)
        assert "source_surface" not in corrections_ddl

    def test_v7_database_upgrades_cleanly_to_v8(self, tmp_path):
        """A DB stamped at v7 (pre identity/provenance) gains the new
        columns, the delegation_records table, and its index -- and a
        legacy audit row reads back with user_id '' (mirrors the v4->v5
        upgrade precedent in test_learning_store)."""
        import sqlite3

        from {{project_slug}}.learning.tables import MIGRATIONS, SCHEMA_VERSION_DDL

        db_path = tmp_path / "pre_v8.db"
        conn = sqlite3.connect(str(db_path))
        conn.execute(SCHEMA_VERSION_DDL)
        for version, statements in enumerate(MIGRATIONS[:7], start=1):
            for stmt in statements:
                conn.execute(stmt)
            conn.execute(
                "INSERT INTO schema_version (version, applied_at) VALUES (?, ?)",
                (version, "2026-01-01T00:00:00"),
            )
        conn.execute(
            "INSERT INTO audit_events (id, correlation_id, event_type, created_at)"
            " VALUES ('legacy1', 'corr-legacy', 'deliberation_started',"
            " '2026-01-01T00:00:00')"
        )
        # The replayed baseline uses today's TABLE_COLUMNS, which already
        # includes delegation_records (budget_configs/v6 precedent); a
        # REAL v7 production DB was created before the table existed, so
        # drop it to reproduce that shape exactly.
        conn.execute("DROP TABLE IF EXISTS delegation_records")
        conn.commit()
        # Genuinely pre-v8: no column, no table.
        cols = {r[1] for r in conn.execute("PRAGMA table_info(audit_events)")}
        assert "user_id" not in cols
        tables = {
            r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")
        }
        assert "delegation_records" not in tables
        conn.close()

        upgraded = SqliteLearningStore(db_path=db_path)  # applies v8

        legacy = upgraded.query("audit_events", {"id": "legacy1"})[0]
        assert legacy["user_id"] == ""
        conn = sqlite3.connect(str(db_path))
        for table, column in (
            ("corrections", "source_surface"),
            ("reflections", "created_by"),
        ):
            cols = {r[1] for r in conn.execute(f"PRAGMA table_info({table})")}
            assert column in cols, f"{table}.{column} missing after upgrade"
        names = {r[0] for r in conn.execute("SELECT name FROM sqlite_master")}
        assert "delegation_records" in names
        assert "idx_delegation_tenant" in names
        versions = {r[0] for r in conn.execute("SELECT version FROM schema_version")}
        conn.close()
        assert len(MIGRATIONS) in versions


