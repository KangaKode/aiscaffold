    def test_factory_degrades_without_store(self, monkeypatch):
        monkeypatch.setenv("DELEGATION_RECORDS_ENABLED", "true")
        assert create_delegation_recorder(None) is None

    @pytest.mark.asyncio
    async def test_toggle_off_writes_zero_rows(self, mock_agents, sample_task, store):
        await dispatch_with_gates(mock_agents, sample_task, None, None, "Test")
        assert store.query("delegation_records", {}) == []

    @pytest.mark.asyncio
    async def test_analyze_rows_derive_from_nothing(
        self, mock_agents, sample_task, recorder, store
    ):
        await dispatch_with_gates(
            mock_agents, sample_task, None, None, "Test",
            delegation_recorder=recorder,
        )
        rows = store.query("delegation_records", {"phase": "analyze"})
        assert {r["agent_id"] for r in rows} == {"analyst_a", "analyst_b"}
        assert all(r["derived_from_json"] == "[]" for r in rows)
        assert all(r["correlation_id"] == sample_task.id for r in rows)

    @pytest.mark.asyncio
    async def test_challenge_rows_name_consumed_analysts(
        self, mock_agents, sample_task, recorder, store
    ):
        analyses = [
            AgentAnalysis(agent_name="analyst_a", domain="d"),
            AgentAnalysis(agent_name="analyst_b", domain="d"),
        ]
        await run_challenge_phase(
            mock_agents, sample_task, analyses, None,
            delegation_recorder=recorder,
        )
        rows = store.query("delegation_records", {"phase": "challenge"})
        assert len(rows) == 2
        for row in rows:
            assert '"analyst_a"' in row["derived_from_json"]
            assert '"analyst_b"' in row["derived_from_json"]

    @pytest.mark.asyncio
