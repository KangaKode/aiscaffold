"""Unit tests for the agents module -- registry, remote agent, protocol."""

import json
import pytest
from pathlib import Path
from {{project_slug}}.agents.registry import AgentRegistry
from {{project_slug}}.agents.remote import RemoteAgent
from {{project_slug}}.orchestration.round_table import AgentProtocol


class TestAgentRegistry:
    def test_register_local_increments_count(self, mock_agent, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        registry.register_local(mock_agent)
        assert registry.count == 1
        assert registry.local_count == 1

    def test_register_remote_persists(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        registry.register_remote("remote_a", "testing", "https://example.com")
        assert registry.count == 1
        assert registry.remote_count == 1
        assert (tmp_path / "agents.json").exists()

    def test_register_remote_preserves_agents_saved_by_other_registry(self, tmp_path):
        persist_path = tmp_path / "agents.json"
        registry_a = AgentRegistry(persist_path=persist_path)
        registry_b = AgentRegistry(persist_path=persist_path)

        registry_a.register_remote("remote_a", "testing", "https://example.com")
        registry_b.register_remote("remote_b", "testing", "https://example.org")

        reloaded = AgentRegistry(persist_path=persist_path)
        assert reloaded.get("remote_a") is not None
        assert reloaded.get("remote_b") is not None
        assert reloaded.remote_count == 2

    def test_get_remote_refreshes_agents_saved_by_other_registry(self, tmp_path):
        persist_path = tmp_path / "agents.json"
        registry_a = AgentRegistry(persist_path=persist_path)
        registry_b = AgentRegistry(persist_path=persist_path)

        registry_a.register_remote("remote_a", "testing", "https://example.com")

        assert registry_b.get("remote_a") is not None

    def test_unregister_refreshes_agents_saved_by_other_registry(self, tmp_path):
        persist_path = tmp_path / "agents.json"
        registry_a = AgentRegistry(persist_path=persist_path)
        registry_b = AgentRegistry(persist_path=persist_path)

        registry_a.register_remote("remote_a", "testing", "https://example.com")
        registry_b.register_remote("remote_b", "testing", "https://example.org")

        assert registry_b.unregister("remote_a") is True
        reloaded = AgentRegistry(persist_path=persist_path)
        assert reloaded.get("remote_a") is None
        assert reloaded.get("remote_b") is not None

    def test_unregister_does_not_resurrect_stale_remote_agents(self, tmp_path):
        persist_path = tmp_path / "agents.json"
        stale_registry = AgentRegistry(persist_path=persist_path)
        stale_registry.register_remote("remote_a", "testing", "https://example.com")
        stale_registry.register_remote("remote_b", "testing", "https://example.org")

        persist_path.write_text(json.dumps({
            "remote_agents": [
                {
                    "name": "remote_a",
                    "domain": "testing",
                    "base_url": "https://example.com",
                },
            ],
        }))
        stale_registry._persist_mtime_ns = persist_path.stat().st_mtime_ns

        assert stale_registry.unregister("remote_a") is True
        reloaded = AgentRegistry(persist_path=persist_path)
        assert reloaded.remote_count == 0

    def test_persist_merge_drops_unsafe_legacy_fields(self, tmp_path):
        persist_path = tmp_path / "agents.json"
        persist_path.write_text(json.dumps({
            "remote_agents": [
                {
                    "name": "remote_a",
                    "domain": "testing",
                    "base_url": "https://example.com",
                    "api_key": "raw-secret",
                    "unexpected": "legacy-field",
                },
            ],
        }))

        registry = AgentRegistry(persist_path=persist_path)
        registry.register_remote("remote_b", "testing", "https://example.org")

        data = json.loads(persist_path.read_text())
        saved_a = next(
            agent for agent in data["remote_agents"] if agent["name"] == "remote_a"
        )
        assert "api_key" not in saved_a
        assert "unexpected" not in saved_a

    def test_persist_merge_sanitizes_allowed_legacy_fields(self, tmp_path):
        persist_path = tmp_path / "agents.json"
        persist_path.write_text(json.dumps({
            "remote_agents": [
                {
                    "name": "remote_a",
                    "domain": "testing",
                    "base_url": "https://example.com",
                    "api_key_env": "GITHUB_TOKEN",
                    "timeout": {"api_key": "raw-secret"},
                    "mode": {"unexpected": "value"},
                    "capabilities": [{"api_key": "raw-secret"}, "safe"],
                },
            ],
        }))

        registry = AgentRegistry(persist_path=persist_path)
        registry.register_remote("remote_b", "testing", "https://example.org")

        data = json.loads(persist_path.read_text())
        saved_a = next(
            agent for agent in data["remote_agents"] if agent["name"] == "remote_a"
        )
        assert saved_a["api_key_env"] == "AGENT_REMOTE_A_API_KEY"
        assert saved_a["timeout"] == 120
        assert saved_a["mode"] == "sync"
        assert saved_a["capabilities"] == ["safe"]

    def test_persist_merge_rejects_cross_agent_api_key_env(self, tmp_path):
        persist_path = tmp_path / "agents.json"
        persist_path.write_text(json.dumps({
            "remote_agents": [
                {
                    "name": "remote_a",
                    "domain": "testing",
                    "base_url": "https://example.com",
                    "api_key_env": "AGENT_REMOTE_B_API_KEY",
                },
            ],
        }))

        registry = AgentRegistry(persist_path=persist_path)
        registry.register_remote("remote_b", "testing", "https://example.org")

        data = json.loads(persist_path.read_text())
        saved_a = next(
            agent for agent in data["remote_agents"] if agent["name"] == "remote_a"
        )
        assert saved_a["api_key_env"] == "AGENT_REMOTE_A_API_KEY"

    def test_persist_merge_rejects_unbounded_timeout(self, tmp_path):
        persist_path = tmp_path / "agents.json"
        persist_path.write_text(json.dumps({
            "remote_agents": [
                {
                    "name": "remote_a",
                    "domain": "testing",
                    "base_url": "https://example.com",
                    "timeout": float("inf"),
                },
            ],
        }))

        registry = AgentRegistry(persist_path=persist_path)
        registry.register_remote("remote_b", "testing", "https://example.org")

        data = json.loads(persist_path.read_text())
        saved_a = next(
            agent for agent in data["remote_agents"] if agent["name"] == "remote_a"
        )
        assert saved_a["timeout"] == 120

    def test_register_remote_validates_direct_url(self, tmp_path):
        from {{project_slug}}.security import ValidationError

        persist_path = tmp_path / "agents.json"
        registry = AgentRegistry(persist_path=persist_path)

        with pytest.raises(ValidationError):
            registry.register_remote(
                "metadata_agent",
                "testing",
                "http://169.254.169.254",
            )
        assert not persist_path.exists()

    def test_load_remote_agents_skips_private_urls(self, tmp_path):
        persist_path = tmp_path / "agents.json"
        persist_path.write_text(json.dumps({
            "remote_agents": [
                {
                    "name": "safe_agent",
                    "domain": "testing",
                    "base_url": "https://example.com",
                },
                {
                    "name": "metadata_agent",
                    "domain": "testing",
                    "base_url": "http://169.254.169.254",
                },
            ],
        }))

        registry = AgentRegistry(persist_path=persist_path)

        assert registry.get("safe_agent") is not None
        assert registry.get("metadata_agent") is None
        assert registry.remote_count == 1

    def test_unregister_removes(self, mock_agent, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        registry.register_local(mock_agent)
        assert registry.unregister(mock_agent.name) is True
        assert registry.count == 0

    def test_get_returns_none_for_unknown(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        assert registry.get("nonexistent") is None

    def test_get_by_capability(self, mock_agent, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        registry.register_local(mock_agent, capabilities=["code_review"])
        found = registry.get_by_capability("code_review")
        assert len(found) == 1
        assert found[0].name == mock_agent.name

    def test_get_by_capability_empty(self, mock_agent, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        registry.register_local(mock_agent, capabilities=["code_review"])
        found = registry.get_by_capability("nonexistent")
        assert len(found) == 0


class TestAgentVisibility:
    def test_default_visibility_is_public(self, mock_agent, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        registry.register_local(mock_agent)
        entry = registry.get_entry(mock_agent.name)
        assert entry.visibility == "public"
        assert entry.tenant_id == "default"

    def test_list_for_tenant_returns_public_agents(self, mock_agents, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        for agent in mock_agents:
            registry.register_local(agent)
        visible = registry.list_for_tenant("any_tenant")
        assert len(visible) == 2

    def test_list_for_tenant_includes_same_tenant_team_agents(self, mock_agent, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        entry = registry._agents  # direct access for test setup
        from {{project_slug}}.agents.registry import AgentEntry
        entry[mock_agent.name] = AgentEntry(
            agent=mock_agent, visibility="team", tenant_id="acme",
        )
        visible = registry.list_for_tenant("acme")
        assert len(visible) == 1
        assert visible[0].agent.name == mock_agent.name

    def test_list_for_tenant_excludes_other_tenant_team_agents(self, mock_agent, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        from {{project_slug}}.agents.registry import AgentEntry
        registry._agents[mock_agent.name] = AgentEntry(
            agent=mock_agent, visibility="team", tenant_id="acme",
        )
        visible = registry.list_for_tenant("other_corp")
        assert len(visible) == 0


class TestRemoteAgent:
    def test_to_dict_uses_env_var_not_raw_key(self):
        agent = RemoteAgent(
            name="test_agent",
            domain="testing",
            base_url="https://example.com",
            api_key="secret-key-123",
        )
        data = agent.to_dict()
        assert "api_key" not in data
        assert "api_key_env" in data
        assert data["api_key_env"] == "AGENT_TEST_AGENT_API_KEY"

    def test_sanitize_string_strips_nulls(self):
        agent = RemoteAgent(name="t", domain="t", base_url="https://example.com")
        result = agent._sanitize_string("hello\x00world")
        assert "\x00" not in result


class TestAgentProtocol:
    def test_mock_agent_implements_protocol(self, mock_agent):
        assert isinstance(mock_agent, AgentProtocol)

    def test_non_agent_fails_protocol(self):
        class NotAnAgent:
            pass
        assert not isinstance(NotAnAgent(), AgentProtocol)
