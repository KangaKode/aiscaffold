class TestSentinelAgent:
    @pytest.mark.asyncio
    async def test_analyze_without_llm_fails_closed(self, sample_task):
        """Without an LLM the input gate must flag, never silently pass."""
        from {{project_slug}}.agents.core import SentinelAgent
        agent = SentinelAgent(llm_client=None)
        analysis = await agent.analyze(sample_task)
        assert analysis.premise_valid is False
        assert analysis.refusal_reason == "sentinel_unavailable"
        assert len(analysis.observations) > 0

    @pytest.mark.asyncio
    async def test_vote_without_llm_dissents(self, sample_task):
        from {{project_slug}}.agents.core import SentinelAgent
        from {{project_slug}}.orchestration.round_table import SynthesisResult
        agent = SentinelAgent(llm_client=None)
        result = await agent.vote(sample_task, SynthesisResult())
        assert result.approve is False


