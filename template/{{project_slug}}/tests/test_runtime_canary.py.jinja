class TestChatSurface:
    @pytest.mark.asyncio
    async def test_enforce_short_circuits_no_history(self, store, monkeypatch):
        from {{project_slug}}.orchestration.chat_orchestrator import (
            ChatConfig,
            ChatOrchestrator,
        )

        monkeypatch.setenv(DETECTION_ENV, "true")
        monkeypatch.setenv(ENFORCEMENT_ENV, "true")
        orch = ChatOrchestrator(
            llm=_LeakLLM("leak"),
            router=_NoEscalateRouter(),
            config=ChatConfig(
                include_safety_agents=False,
                enable_cross_check=False,
                max_agents=0,
            ),
            learning_store=store,
            session_key="sess-1",
        )
        resp = await orch.chat("hello", tenant_id="t-chat")
        assert resp.refused is True
        assert resp.refusal_source == REFUSAL_SOURCE
        assert resp.refusal_reason == REFUSAL_REASON
        assert resp.content == ""
        # User turn kept; leaked assistant text must not enter history.
        assert orch.history_length == 1
        assert orch.conversation_history[0]["role"] == "user"
        assert orch.conversation_history[0]["content"] == "hello"
        assert _flags(store, "t-chat")

    @pytest.mark.asyncio
    async def test_detect_only_keeps_content(self, store, monkeypatch):
        from {{project_slug}}.orchestration.chat_orchestrator import (
            ChatConfig,
            ChatOrchestrator,
        )

        monkeypatch.setenv(DETECTION_ENV, "true")
        orch = ChatOrchestrator(
            llm=_LeakLLM("leak"),
            router=_NoEscalateRouter(),
            config=ChatConfig(
                include_safety_agents=False,
                enable_cross_check=False,
                max_agents=0,
            ),
            learning_store=store,
        )
        resp = await orch.chat("hello", tenant_id="t-det")
        assert resp.refused is False
        assert "SEC_CANARY_" in resp.content
        assert orch.history_length == 2


class TestRoundTableSurface:
    @pytest.mark.asyncio
    async def test_enforce_skips_voting(self, monkeypatch, store):
        from {{project_slug}}.orchestration.round_table import (
            AgentAnalysis,
            RoundTableResult,
        )
        from {{project_slug}}.orchestration.round_table_helpers import phase_synthesis
        from {{project_slug}}.orchestration.runtime_canary import CanaryRefusal

        monkeypatch.setenv(DETECTION_ENV, "true")
        monkeypatch.setenv(ENFORCEMENT_ENV, "true")

        partial = RoundTableResult(task_id="t1")
        partial.analyses = [
            AgentAnalysis(
                agent_name="a", domain="d",
                observations=[{"finding": "x"}],
                recommendations=[{"action": "y"}],
                confidence=0.9,
            )
        ]

        class CtxLeakLLM:
            async def call(self, prompt=None, role="", **kwargs):
                ctx = getattr(prompt, "context", "") or ""
                import re
                m = re.search(r"\[SEC_CANARY_[0-9a-f]+\]", ctx)
                token = m.group(0) if m else ""
                return LLMResponse(
                    content=json.dumps({
                        "recommended_direction": f"go {token}",
                        "key_findings": [],
                        "trade_offs": [],
                        "minority_views": [],
                    }),
                    provider="test", model="test",
                )

        synthesis, refusal = await phase_synthesis(
            partial, CtxLeakLLM(), "system",
            learning_store=store, tenant_id="t-rt",
        )
        assert isinstance(refusal, CanaryRefusal)
        assert refusal.reason == REFUSAL_REASON
        assert synthesis.recommended_direction == ""
        assert _flags(store, "t-rt")
        assert _flags(store, "t-rt")[0]["subject_id"] == SURFACE_ROUND_TABLE


