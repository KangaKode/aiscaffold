"""Tests for the corrections HTTP API (API-first lifecycle) and GDPR
erasure -- store hard-delete, daily caps, tenant scoping, and the
four-eyes rule enforced from the authenticated caller."""

import pytest

from {{project_slug}}.learning.corrections import (
    STATUS_APPROVED,
    STATUS_PROPOSED,
    CorrectionsManager,
)
from {{project_slug}}.learning.erasure import (
    ERASURE_EVENT_TYPE,
    ErasureCapExceededError,
    erase_correction,
)
from {{project_slug}}.learning.store import SqliteLearningStore


@pytest.fixture
def store(tmp_path):
    return SqliteLearningStore(db_path=tmp_path / "learning_store.db")


@pytest.fixture
def manager(store):
    return CorrectionsManager(store)


def propose(mgr, original="rate limit is 100", corrected="rate limit is 60",
            created_by="alice", tenant_id="default"):
    return mgr.propose(agent_id="analyst", original_claim=original,
                       corrected_claim=corrected, reason="vendor docs",
                       evidence_level="documented", created_by=created_by,
                       tenant_id=tenant_id)


# --- Store hard-delete -------------------------------------------------------


class TestStoreDelete:
    def test_delete_removes_row(self, store, manager):
        correction = propose(manager)
        assert store.delete("corrections", correction.id) is True
        assert store.query("corrections", {"id": correction.id}) == []

    def test_delete_missing_returns_false(self, store):
        assert store.delete("corrections", "no-such-id") is False

    def test_delete_validates_table(self, store):
        with pytest.raises(ValueError):
            store.delete("not_a_table", "some-id")


# --- Erasure (GDPR Art. 17) --------------------------------------------------


class TestErasure:
    def test_erase_removes_correction_and_audits(self, store, manager):
        correction = propose(manager)
        result = erase_correction(store, correction.id, actor="dpo-user")

        assert result["erased"] is True
        assert result["erasures_today"] == 1
        assert manager.get(correction.id) is None
        events = store.query(
            "audit_events", {"event_type": ERASURE_EVENT_TYPE}
        )
        assert len(events) == 1
        assert correction.id in events[0]["correlation_id"]
        # The erased text must not survive in the audit trail.
        assert "rate limit" not in events[0]["detail_json"]

    def test_erase_missing_raises(self, store):
        with pytest.raises(ValueError):
            erase_correction(store, "no-such-id")

    def test_erase_is_tenant_scoped(self, store, manager):
        correction = propose(manager, tenant_id="team-a")
        with pytest.raises(ValueError):
            erase_correction(store, correction.id, tenant_id="team-b")
        assert manager.get(correction.id) is not None

    def test_daily_cap_blocks_bulk_erasure(self, store, manager, monkeypatch):
        monkeypatch.setenv("ERASURE_DAILY_CAP", "2")
        ids = [propose(manager, original=f"claim {i}").id for i in range(3)]
        erase_correction(store, ids[0])
        erase_correction(store, ids[1])
        with pytest.raises(ErasureCapExceededError):
            erase_correction(store, ids[2])
        assert manager.get(ids[2]) is not None

    def test_erased_correction_leaves_prompt_context(self, store, manager):
        correction = propose(manager)
        manager.approve(correction.id, approved_by="bob")
        assert "rate limit is 60" in manager.get_approved_for_context()

        erase_correction(store, correction.id)
        assert manager.get_approved_for_context() == ""


# --- Revalidation + staleness (knowledge aging) ------------------------------


class TestRevalidation:
    def test_revalidate_sets_freshness_fields(self, manager):
        correction = propose(manager)
        manager.approve(correction.id, approved_by="bob")
        updated_at_after_approval = manager.get(correction.id).updated_at

        revalidated = manager.revalidate(correction.id, validated_by="carol")
        assert revalidated.last_validated_by == "carol"
        assert revalidated.last_validated_at != ""

        stored = manager.get(correction.id)
        assert stored.status == STATUS_APPROVED
        assert stored.last_validated_by == "carol"
        # Revalidation is not a lifecycle change: updated_at must not move
        # (the report's fresh_only_via_revalidation metric and the
        # updated_at-windowed pattern checks depend on this).
        assert stored.updated_at == updated_at_after_approval

    def test_revalidate_requires_approved(self, manager):
        correction = propose(manager)
        with pytest.raises(ValueError, match="can be revalidated"):
            manager.revalidate(correction.id, validated_by="carol")

    def test_staleness_uses_updated_at_fallback(self):
        from datetime import datetime

        from {{project_slug}}.learning.aging import is_stale

        now = datetime.now().isoformat()
        # Legacy pre-aging row with an old updated_at -> stale.
        assert is_stale("", "2020-01-01T00:00:00") is True
        # Recently revalidated -> fresh, even with an ancient updated_at.
        assert is_stale(now, "2020-01-01T00:00:00") is False
        # Young legacy row -> not stale on day one.
        assert is_stale("", now) is False
        # Undatable rows are never flagged.
        assert is_stale("", "not-a-timestamp") is False


# --- Manager list helper -----------------------------------------------------


class TestManagerList:
    def test_list_filters_by_status_and_agent(self, manager):
        first = propose(manager)
        second = propose(manager, original="other claim")
        manager.approve(second.id, approved_by="bob")

        proposed = manager.list(status=STATUS_PROPOSED)
        approved = manager.list(status=STATUS_APPROVED)
        assert [c.id for c in proposed] == [first.id]
        assert [c.id for c in approved] == [second.id]
        assert manager.list(agent_id="nobody") == []

    def test_list_is_tenant_scoped(self, manager):
        propose(manager, tenant_id="team-a")
        assert manager.list(tenant_id="team-b") == []


