# =============================================================================
# Finding 5: round-table route must set the budget tenant context
# =============================================================================


class TestRoundTableRouteTenantContext:
    @pytest.mark.asyncio
    async def test_deliberation_runs_under_callers_budget_tenant(
        self, tmp_path, monkeypatch
    ):
        """With MODEL_ROUTING_ENABLED, route_for_call reads the budget
        contextvar for tier downgrades. The round-table route must set it
        to the caller's tenant before deliberating -- otherwise every
        round-table LLM call budgets/routes against "default"."""
        from fastapi import Request
        from httpx import ASGITransport, AsyncClient

        from {{project_slug}}.agents.registry import AgentRegistry
        from {{project_slug}}.api.gateway import create_app
        from {{project_slug}}.api.middleware.auth import AuthContext, verify_api_key
        from {{project_slug}}.api.routes import round_table as rt_route
        from {{project_slug}}.llm.budget_manager import get_tenant_context
        from {{project_slug}}.orchestration.round_table import RoundTableResult

        seen_tenants: list[str] = []

        class StubRoundTable:
            """Records the tenant context visible where LLM calls happen."""

            def __init__(self, *args, **kwargs):
                self.agents = kwargs.get("agents", [])

            async def run(self, task):
                seen_tenants.append(get_tenant_context())
                return RoundTableResult(task_id=task.id)

        monkeypatch.delenv("API_KEY", raising=False)
        monkeypatch.delenv("ENV", raising=False)
        app = create_app(registry=AgentRegistry(persist_path=tmp_path / "agents.json"))

        async def auth_override(request: Request) -> AuthContext:
            context = AuthContext(api_key="k", user_id="alice", tenant_id="acme")
            request.state.auth_context = context
            return context

        app.dependency_overrides[verify_api_key] = auth_override
        monkeypatch.setattr(rt_route, "RoundTable", StubRoundTable)

        transport = ASGITransport(app=app)
        async with AsyncClient(transport=transport, base_url="http://test") as client:
            r = await client.post("/api/v1/agents", json={
                "name": "ctx_agent", "domain": "testing",
                "base_url": "https://example.com",
            })
            assert r.status_code == 200
            r = await client.post(
                "/api/v1/round-table/tasks", json={"content": "route me"}
            )
        app.dependency_overrides.clear()

        assert r.status_code == 200
        assert seen_tenants == ["acme"]
