@pytest.mark.asyncio
async def test_isa_closure_surfaced_on_completed_response(tmp_path, monkeypatch):
    import os

    from httpx import ASGITransport, AsyncClient

    from {{ project_slug }}.agents.registry import AgentRegistry
    from {{ project_slug }}.api.gateway import create_app
    from {{ project_slug }}.api.routes import round_table as rt_route
    from {{ project_slug }}.orchestration.round_table import RoundTableResult
    from {{ project_slug }}.orchestration.task_isa import ClaimClosure, IsaClosureReport

    class _Local:
        name = "isa_api_agent"
        domain = "testing"

        async def analyze(self, task):
            raise NotImplementedError

        async def challenge(self, task, other_analyses):
            raise NotImplementedError

        async def vote(self, task, synthesis):
            raise NotImplementedError

    class _FakeRT:
        canned = None

        def __init__(self, agents, config, **kwargs):
            pass

        async def run(self, task):
            result = _FakeRT.canned
            result.task_id = task.id
            return result

    os.environ.pop("API_KEY", None)
    os.environ.pop("ENV", None)
    registry = AgentRegistry(persist_path=tmp_path / "agents.json")
    registry.register_local(_Local(), capabilities=["testing"])
    app = create_app(registry=registry)
    app.state.deliberation_auditor = None
    monkeypatch.setattr(rt_route, "RoundTable", _FakeRT)
    monkeypatch.setattr(rt_route, "record_deliberation", lambda o, d: None)
    _FakeRT.canned = RoundTableResult(
        task_id="pending",
        consensus_reached=True,
        isa_closure=IsaClosureReport(
            claim_closures=[
                ClaimClosure(claim_id="c1", status="open", detail="missing")
            ],
            all_required_closed=False,
        ),
    )
    transport = ASGITransport(app=app)
    async with AsyncClient(transport=transport, base_url="http://test") as client:
        r = await client.post(
            "/api/v1/round-table/tasks",
            json={
                "content": "task",
                "isa": {
                    "version": "1",
                    "ideal_summary": "Done when rate limited",
                    "claims": [
                        {
                            "id": "c1",
                            "statement": "Login rate limited",
                            "evidence_kind": "citation",
                            "required": True,
                        }
                    ],
                },
            },
        )
    assert r.status_code == 200
    data = r.json()
    assert data["status"] == "completed"
    assert data["isa_closure"]["all_required_closed"] is False
    assert data["isa_closure"]["claim_closures"][0]["claim_id"] == "c1"
