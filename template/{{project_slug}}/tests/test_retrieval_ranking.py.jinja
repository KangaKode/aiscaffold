from {{ project_slug }}.learning.rag.vector_store import VectorStore

FLAG = "LEXICAL_RANKING_ENABLED"


# ---------------------------------------------------------------------------
# Labeled fixture: 25 docs, 12 queries. Constructed with clearly separated
# relevance so no two docs score within float noise of each other (SRE
# advisory: no near-ties). Includes one PREFIX-RECALL query (q12) where
# whole-token BM25 loses the substring match legacy provided -- the loss is
# priced into the measured metrics, not hidden.
#
# The three STUFFER docs (s01-s03) sit FIRST in insertion order: they are
# broad-coverage dictionaries covering the full token sets of queries q1,
# q4, q6, and q8. Under the legacy binary-presence scorer each stuffer ties
# the genuine doc at 1.0 and insertion order breaks ties, so the genuine
# doc lands at rank 4 (outside P@3). This is the documented legacy
# weakness (broad-coverage stuffing) expressed in the measured metrics,
# not a synthetic trick -- BM25's IDF + length normalization demote them.
# ---------------------------------------------------------------------------
_STUFFER_TERMS = (
    "postgres connection pooling canary analysis before rollout cache "
    "invalidation pricing index bloat vacuum tenant alert consensus "
    "embedding backups timeout rollback schema secrets incident metric"
)
CORPUS = [
    ("s01", _STUFFER_TERMS + " extra filler alpha"),
    ("s02", _STUFFER_TERMS + " extra filler bravo"),
    ("s03", _STUFFER_TERMS + " extra filler charlie"),
    ("d01", "Postgres connection pooling keeps latency low under load"),
    ("d02", "Use concise responses when the user asks short questions"),
    ("d03", "Rotate API keys quarterly and store them in the vault"),
    ("d04", "The deployment pipeline runs canary analysis before rollout"),
    ("d05", "Prefer structured logging with correlation identifiers"),
    ("d06", "Cache invalidation strategy for the pricing service"),
    ("d07", "Timeout budgets: upstream calls get three second ceilings"),
    ("d08", "Postgres index bloat is monitored with weekly vacuum stats"),
    ("d09", "User prefers metric units in all measurement output"),
    ("d10", "Incident retrospectives are blameless and time-boxed"),
    ("d11", "Rate limiting uses a token bucket per tenant"),
    ("d12", "Schema migrations require a rollback script in review"),
    ("d13", "The style guide bans passive voice in error messages"),
    ("d14", "Secrets never appear in logs or exception traces"),
    ("d15", "Latency dashboards alert at the ninety ninth percentile"),
    ("d16", "Consensus votes are recorded with agent identifiers"),
    ("d17", "Embedding providers must be configured for semantic search"),
    ("d18", "Backups run nightly and restores are tested monthly"),
    ("d19", "Feature flags default off and expire after two releases"),
    ("d20", "The pricing service rounds to two decimal places"),
    ("d22", "Deployment freezes apply during the holiday change window"),
    # TF-stuffed doc: one relevant rare term repeated many times (T6b target)
    ("d25", "canary canary canary canary canary canary canary canary "
            "canary canary canary canary canary canary canary canary"),
]

# (query, ordered relevant doc ids -- first is the single best answer)
QUERIES = [
    ("postgres connection pooling", ["d01"]),
    ("concise responses to short questions", ["d02"]),
    ("rotate api keys", ["d03"]),
    ("canary analysis before rollout", ["d04"]),
    ("structured logging correlation", ["d05"]),
    ("cache invalidation pricing", ["d06"]),
    ("timeout budgets upstream", ["d07"]),
    ("postgres index bloat vacuum", ["d08"]),
    ("metric units preference", ["d09"]),
    ("schema migration rollback script", ["d12"]),
    ("nightly backups restore testing", ["d18"]),
    # prefix-recall case: legacy substring matching finds "deployment" for
    # query token "deploy"; whole-token BM25 does not. d22 contains the
    # token "deployment" too -- the intended answer d04 must win on the
    # other terms.
    ("deploy pipeline canary", ["d04"]),
]


def legacy_score(query: str, content: str) -> float:
    """Independent reimplementation of the shipped binary-presence scorer
    (vector_store legacy path): fraction of unique query words present as
    substrings. Used to pin byte-equivalence without trusting the code
    under test."""
    query_words = set(query.lower().split())
    doc_lower = content.lower()
    matches = sum(1 for w in query_words if w in doc_lower)
    return matches / max(len(query_words), 1)


def make_store(docs=None) -> VectorStore:
    store = VectorStore(project_id="ranking_test", use_chroma=False)
    for doc_id, content in (docs or CORPUS):
        store.add(doc_id, content)
    return store


def rank_ids(store: VectorStore, query: str, limit: int = 10) -> list[str]:
    return [r.id for r in store.search(query, limit=limit).results]


def mrr_and_p3(store: VectorStore) -> tuple[float, float]:
    rr_total, hits3 = 0.0, 0
    for query, relevant in QUERIES:
        ids = rank_ids(store, query)
        best = relevant[0]
        if best in ids:
            rr_total += 1.0 / (ids.index(best) + 1)
        if best in ids[:3]:
            hits3 += 1
    return rr_total / len(QUERIES), hits3 / len(QUERIES)


