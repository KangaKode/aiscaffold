class TestBM25Properties:
    """T1-T3."""

    def test_t1_rare_terms_outrank_common(self):
        docs = [
            tokenize("the quick brown fox jumps over the lazy dog"),
            tokenize("the the the the zyzzyva appears here"),
            tokenize("the cat sat on the mat"),
        ]
        common = bm25_scores(tokenize("the"), docs)
        rare = bm25_scores(tokenize("zyzzyva"), docs)
        # "the" appears in all docs -> minimal IDF weight everywhere;
        # "zyzzyva" appears in one doc -> that doc scores decisively higher.
        assert rare[1] > max(common)

    def test_t2_term_frequency_saturates(self):
        base = tokenize("canary deploy check")
        five = tokenize("canary " * 5 + "padding words here")
        fifty = tokenize("canary " * 50 + "padding words here")
        q = tokenize("canary")
        s_one, s_five, s_fifty = bm25_scores(q, [base, five, fifty])
        assert s_five > s_one
        # 10x more repetitions must yield only marginal gain (saturation):
        assert s_fifty < s_five * 1.5

    def test_t3_length_normalization_penalizes_padding(self):
        concise = tokenize("canary rollout analysis")
        padded = tokenize(
            "canary rollout analysis " + "unrelated filler words " * 30
        )
        q = tokenize("canary rollout")
        s_concise, s_padded = bm25_scores(q, [concise, padded])
        assert s_concise > s_padded


class TestTokenizer:
    """T4."""

    def test_case_folding(self):
        assert tokenize("Canary DEPLOY") == ["canary", "deploy"]

    def test_nfkc_compatibility_fold(self):
        # fullwidth latin folds to ascii under NFKC
        assert tokenize("\uff43\uff41\uff54") == ["cat"]

    def test_whole_token_no_substring_collision(self):
        docs = [tokenize("category theory notes"), tokenize("the cat sat")]
        scores = bm25_scores(tokenize("cat"), docs)
        assert scores[0] == 0.0
        assert scores[1] > 0.0

    def test_punctuation_split_and_empty(self):
        assert tokenize("a,b;c") == ["a", "b", "c"]
        assert tokenize("") == []
        assert tokenize("   ") == []


class TestRRFFusion:
    """T5."""

    def test_dual_arm_winner_beats_single_arm(self):
        fused = rrf_fuse(["a", "b", "c"], ["a", "d", "e"])
        assert max(fused, key=lambda i: (fused[i], i)) == "a"

    def test_tiebreak_is_deterministic_by_doc_id(self):
        # b and c receive identical contributions -> doc-id breaks the tie
        fused = rrf_fuse(["b", "c"], ["c", "b"])
        assert fused["b"] == fused["c"]
        ordered = sorted(fused, key=lambda i: (-fused[i], i))
        assert ordered == ["b", "c"]


class TestAdversarialRanking:
    """T6a/T6b -- the memo's amplification amendment, redesigned per
    security review: legacy is binary presence, so the genuine legacy
    failure mode is BROAD-COVERAGE stuffing, and BM25's new TF surface
    needs its own bound."""

    def test_t6a_broad_coverage_stuffing_beats_legacy_loses_to_bm25(
        self, monkeypatch
    ):
        store = make_store()
        query = "postgres index bloat vacuum"
        monkeypatch.setenv(FLAG, "false")
        legacy_ids = rank_ids(store, query)
        # the dictionary stuffers tie the genuine d08 at 1.0 and win on
        # insertion order -- d08 is pushed out of the legacy top-3
        assert legacy_ids[0] == "s01"
        assert legacy_ids.index("d08") == 3
        monkeypatch.setenv(FLAG, "true")
        bm25_ids = rank_ids(store, query)
        # BM25's IDF + length penalty demote the stuffed docs below the
        # genuinely relevant d08
        assert bm25_ids[0] == "d08"
        assert bm25_ids.index("s01") > bm25_ids.index("d08")

    def test_t6b_single_term_repetition_bounded(self, flag_on):
        store = make_store()
        # d25 repeats "canary" 16x; d04 is the genuinely relevant doc
        ids = rank_ids(store, "canary analysis before rollout")
        assert "d04" in ids[:3]
        assert ids.index("d04") < ids.index("d25")


class TestMeasuredGain:
    """T7 -- fixture-scale measurement, pinned. NOT a benchmark claim."""

    def test_bm25_strictly_beats_legacy_on_both_metrics(self, monkeypatch):
        store = make_store()
        monkeypatch.setenv(FLAG, "false")
        legacy_mrr, legacy_p3 = mrr_and_p3(store)
        monkeypatch.setenv(FLAG, "true")
        bm25_mrr, bm25_p3 = mrr_and_p3(store)
        assert bm25_mrr > legacy_mrr
        assert bm25_p3 > legacy_p3

    def test_measured_values_pinned(self, monkeypatch):
        """Frozen-baseline style: review these numbers downward never
        silently. Update requires editing this pin in a reviewed PR."""
        store = make_store()
        monkeypatch.setenv(FLAG, "false")
        legacy_mrr, legacy_p3 = mrr_and_p3(store)
        monkeypatch.setenv(FLAG, "true")
        bm25_mrr, bm25_p3 = mrr_and_p3(store)
        assert legacy_mrr == pytest.approx(PINNED["legacy_mrr"], abs=1e-9)
        assert legacy_p3 == pytest.approx(PINNED["legacy_p3"], abs=1e-9)
        assert bm25_mrr == pytest.approx(PINNED["bm25_mrr"], abs=1e-9)
        assert bm25_p3 == pytest.approx(PINNED["bm25_p3"], abs=1e-9)


# Measured on the shipped fixture (12 queries, 25 docs) at implementation
# time. FIXTURE-SCALE numbers, not a benchmark claim. The legacy scorer
# loses reciprocal rank and top-3 precision to the broad-coverage stuffers
# on queries q1/q4/q6/q8; BM25 answers every query at rank 1 here.
PINNED = {
    "legacy_mrr": 0.75,
    "legacy_p3": 8 / 12,
    "bm25_mrr": 1.0,
    "bm25_p3": 1.0,
}


class TestKillSwitch:
    """T8."""

    def test_flag_off_matches_independent_legacy_reimplementation(
        self, flag_off
    ):
        store = make_store()
        for query, _ in QUERIES:
            results = store.search(query, limit=10).results
            expected = sorted(
                (
                    (legacy_score(query, content), doc_id)
                    for doc_id, content in CORPUS
                    if legacy_score(query, content) > 0
                ),
                key=lambda t: -t[0],
            )
            assert [r.id for r in results] == [
                doc_id for _, doc_id in expected[:10]
            ]
            for r, (score, _) in zip(results, expected):
                assert r.score == pytest.approx(score, abs=1e-12)

    def test_flag_off_mixed_embedding_branch_preserved(self, flag_off):
        store = VectorStore(project_id="mixed", use_chroma=False)
        store.add("with_emb", "alpha beta", embedding=[1.0, 0.0])
        store.add("no_emb", "alpha beta gamma")
        results = store.search(
            "alpha", limit=10, query_embedding=[1.0, 0.0]
        ).results
        by_id = {r.id: r.score for r in results}
        # legacy per-doc branch: embedded doc scored by cosine (1.0),
        # unembedded doc scored by keyword fraction (1.0 here)
        assert by_id["with_emb"] == pytest.approx(1.0)
        assert by_id["no_emb"] == pytest.approx(1.0)

    @pytest.mark.parametrize(
        ("value", "expect_bm25"),
        [
            (None, True),        # unset -> ON
            ("true", True),
            ("garbage", True),   # falsy-list parse: garbage preserves ON
            ("1", True),
            ("false", False),
            ("0", False),
            ("no", False),
        ],
    )
    def test_flag_parse_falsy_list(self, monkeypatch, value, expect_bm25):
        if value is None:
            monkeypatch.delenv(FLAG, raising=False)
        else:
            monkeypatch.setenv(FLAG, value)
        store = make_store()
        # discriminator: whole-token BM25 gives "cat" no hit on "category"
        # (d-x below); legacy substring matching does.
        store.add("dx_category", "category theory notes")
        ids = rank_ids(store, "cat")
        if expect_bm25:
            assert "dx_category" not in ids
        else:
            assert "dx_category" in ids


class TestFilterClasses:
    """T10a -- where-filters are pre-rank and cannot be outscored."""

    def test_where_filtered_docs_never_appear(self, flag_on):
        store = VectorStore(project_id="scoped", use_chroma=False)
        store.add("mine", "canary rollout notes", metadata={"owner": "a"})
        store.add(
            "theirs",
            "canary " * 30 + "rollout " * 30,
            metadata={"owner": "b"},
        )
        ids = [
            r.id
            for r in store.search(
                "canary rollout", limit=10, where={"owner": "a"}
            ).results
        ]
        assert ids == ["mine"]


class TestScopedIDFInvariant:
    """T11 -- BM25 corpus statistics are computed only over the
    where-passing candidate set (security invariant)."""

    def test_flooding_one_scope_leaves_other_scope_ranking_identical(
        self, flag_on
    ):
        def scope_a_docs(store):
            store.add("a1", "canary rollout analysis", metadata={"owner": "a"})
            store.add("a2", "canary in the coal mine", metadata={"owner": "a"})
            store.add("a3", "rollout freeze window", metadata={"owner": "a"})

        baseline = VectorStore(project_id="idf_base", use_chroma=False)
        scope_a_docs(baseline)
        base_results = baseline.search(
            "canary rollout", limit=10, where={"owner": "a"}
        )

        flooded = VectorStore(project_id="idf_flood", use_chroma=False)
        scope_a_docs(flooded)
        for i in range(40):
            flooded.add(
                f"b{i}", "canary canary rollout rollout",
                metadata={"owner": "b"},
            )
        flood_results = flooded.search(
            "canary rollout", limit=10, where={"owner": "a"}
        )

        assert [r.id for r in flood_results.results] == [
            r.id for r in base_results.results
        ]
        for got, want in zip(flood_results.results, base_results.results):
            assert got.score == pytest.approx(want.score, abs=1e-12)


class TestMembershipAndTotal:
    """T12 -- RRF must not admit zero-arm filler; totals are eligible-only."""

    @pytest.mark.parametrize("flag", ["true", "false"])
    def test_zero_match_query_returns_empty(self, monkeypatch, flag):
        monkeypatch.setenv(FLAG, flag)
        store = make_store()
        results = store.search("xylophone quixotic zephyr", limit=10)
        assert results.results == []
        assert results.total == 0

    def test_hybrid_membership_requires_positive_arm(self, flag_on):
        store = VectorStore(project_id="member", use_chroma=False)
        store.add("lex_hit", "canary rollout", embedding=[0.0, 1.0])
        store.add("sem_hit", "unrelated words", embedding=[1.0, 0.0])
        store.add("no_hit", "unrelated words", embedding=[-1.0, 0.0])
        results = store.search(
            "canary", limit=10, query_embedding=[1.0, 0.0]
        )
        ids = {r.id for r in results.results}
        # lex_hit: lexical > 0. sem_hit: cosine > 0. no_hit: neither.
        assert ids == {"lex_hit", "sem_hit"}
        assert results.total == 2

    def test_total_counts_eligible_not_corpus(self, flag_on):
        store = make_store()
        results = store.search("canary", limit=2)
        # s01-s03, d04, d25 contain the token -> eligible 5, results capped
        assert len(results.results) == 2
        assert results.total == 5
