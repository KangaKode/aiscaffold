    @pytest.mark.asyncio
    async def test_round_table_results_reject_delimiter_collisions(self, scoped_client):
        round_table._results_cache.clear()
        task_id = "task_private_collision"
        owner_auth = AuthContext(user_id="alice:bob", tenant_id="tenant-a")
        round_table._cache_result(
