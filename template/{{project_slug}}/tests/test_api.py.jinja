class TestPreferencesAPI:
    @pytest.mark.asyncio
    async def test_preferences_and_profile_are_scoped_to_auth_context(self, scoped_client):
        alice_headers = {"X-Test-User": "alice", "X-Test-Tenant": "tenant-a"}
        bob_headers = {"X-Test-User": "bob", "X-Test-Tenant": "tenant-a"}

        save_r = await scoped_client.post(
            "/api/v1/preferences",
            json={
                "preference_type": "style",
                "key": "confidential-codename",
                "value": "project-nightjar",
                "source": "explicit",
            },
            headers=alice_headers,
        )
        assert save_r.status_code == 200

        bob_list = await scoped_client.get("/api/v1/preferences", headers=bob_headers)
        bob_profile = await scoped_client.get("/api/v1/profile", headers=bob_headers)

        assert bob_list.status_code == 200
        assert "project-nightjar" not in [
            pref["value"] for pref in bob_list.json()["preferences"]
        ]
        assert bob_profile.status_code == 200
        assert "project-nightjar" not in bob_profile.json()["context_bundle"]


