class TestTrustGuardFeedbackRoute:
    @pytest.mark.asyncio
    async def test_feedback_route_unchanged_flag_off(self, feedback_app, monkeypatch):
        """T3: with TRUST_* unset the route behaves exactly as before --
        the burst path is never entered and the store is never touched."""
        from {{ project_slug }}.learning.trust_guard import TRUST_BURST_ENV

        monkeypatch.delenv(TRUST_BURST_ENV, raising=False)
        app, client = feedback_app
        app.state.learning_store = _UntouchableStore()
        r = await client.post("/api/v1/feedback", json={
            "signal_type": "accept",
            "agent_id": "trusted_agent",
            "context_type": "chat",
        })
        assert r.status_code == 200
