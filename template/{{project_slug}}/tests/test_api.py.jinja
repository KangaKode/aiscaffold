        assert r.status_code == 400

    @pytest.mark.asyncio
    async def test_sessions_are_scoped_to_auth_context(self, scoped_client):
        alice_headers = {"X-Test-User": "alice", "X-Test-Tenant": "tenant-a"}
        bob_headers = {"X-Test-User": "bob", "X-Test-Tenant": "tenant-a"}

        create_r = await scoped_client.post(
            "/api/v1/sessions",
            json={"metadata": {"case": "private"}},
            headers=alice_headers,
        )
        assert create_r.status_code == 200
        sid = create_r.json()["session_id"]

        bob_get = await scoped_client.get(
            f"/api/v1/sessions/{sid}",
            headers=bob_headers,
        )
        assert bob_get.status_code == 404

        bob_add = await scoped_client.post(
            f"/api/v1/sessions/{sid}/turns",
            json={"content": "should not be accepted"},
            headers=bob_headers,
        )
        assert bob_add.status_code == 404

        alice_list = await scoped_client.get("/api/v1/sessions", headers=alice_headers)
        bob_list = await scoped_client.get("/api/v1/sessions", headers=bob_headers)
        assert alice_list.json()["total"] == 1
        assert bob_list.json()["total"] == 0

    @pytest.mark.asyncio
    async def test_sessions_reject_delimiter_collisions(self, scoped_client):
        owner_headers = {"X-Test-User": "alice:bob", "X-Test-Tenant": "tenant-a"}
        colliding_headers = {"X-Test-User": "bob", "X-Test-Tenant": "tenant-a:alice"}

        create_r = await scoped_client.post(
            "/api/v1/sessions",
            json={"metadata": {"case": "delimiter-collision"}},
            headers=owner_headers,
        )
        assert create_r.status_code == 200
        sid = create_r.json()["session_id"]

        colliding_get = await scoped_client.get(
            f"/api/v1/sessions/{sid}",
            headers=colliding_headers,
        )
        assert colliding_get.status_code == 404

        colliding_add = await scoped_client.post(
            f"/api/v1/sessions/{sid}/turns",
            json={"content": "must not attach to another principal's session"},
            headers=colliding_headers,
        )
        assert colliding_add.status_code == 404

        owner_list = await scoped_client.get("/api/v1/sessions", headers=owner_headers)
        colliding_list = await scoped_client.get(
            "/api/v1/sessions",
            headers=colliding_headers,
        )
        assert owner_list.json()["total"] == 1
        assert colliding_list.json()["total"] == 0

    @pytest.mark.asyncio
    async def test_round_table_results_are_scoped_to_auth_context(self, scoped_client):
        round_table._results_cache.clear()
        task_id = "task_private"
