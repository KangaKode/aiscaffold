    async def test_feedback_route_nonfatal_when_store_down(
        self, feedback_app, monkeypatch
    ):
        """T10 (route variant): burst enabled + broken portable store ->
        feedback recording still succeeds (fire-and-forget seam)."""
        from {{ project_slug }}.learning.trust_guard import TRUST_BURST_ENV

        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        app, client = feedback_app
        app.state.learning_store = _DownStore()
        r = await client.post("/api/v1/feedback", json={
