    @pytest.mark.asyncio
    async def test_config_overrides_cannot_drop_safety_fields(
        self, enforcement_client
    ):
        """THE bypass finding: pre-fix, config_overrides rebuilt
        RoundTableConfig from only five fields, silently resetting every
        other field (sentinel_enforcement, enforce_evidence, ...) to its
        dataclass default. Overrides must replace only the allowlisted
        fields and ignore everything else in the payload."""
        from {{ project_slug }}.orchestration.round_table import (
            RoundTableConfig, RoundTableResult, SynthesisResult,
        )

        client, app = enforcement_client
        app.state.round_table_config = RoundTableConfig(
            sentinel_enforcement=True,
            enforce_evidence=False,
            refusal_threshold=4,
        )
        _FakeRoundTable.canned_result = RoundTableResult(
            task_id="pending", synthesis=SynthesisResult(recommended_direction="ok"),
        )
        r = await client.post("/api/v1/round-table/tasks", json={
            "content": "task",
            "config_overrides": {
                "consensus_threshold": 0.9,
                "sentinel_enforcement": False,
                "enforce_evidence": True,
            },
        })
        assert r.status_code == 200
        config = _FakeRoundTable.captured["config"]
        # Allowlisted override applied.
        assert config.consensus_threshold == 0.9
        # Safety fields are NOT caller-tunable: payload values ignored.
        assert config.sentinel_enforcement is True
        assert config.enforce_evidence is False
        # Non-allowlisted app config survives the rebuild.
        assert config.refusal_threshold == 4


