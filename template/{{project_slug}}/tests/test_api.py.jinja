class _LocalAgent:
    name = "api_test_agent"
    domain = "testing"

    async def analyze(self, task):
        raise NotImplementedError  # never dispatched (RoundTable is faked)

    async def challenge(self, task, other_analyses):
        raise NotImplementedError

    async def vote(self, task, synthesis):
        raise NotImplementedError


class _FakeRoundTable:
    """Captures the config the route built and returns a canned result."""

    captured: dict = {}
    canned_result = None

    def __init__(self, agents, config, **kwargs):
        _FakeRoundTable.captured["config"] = config
        _FakeRoundTable.captured["agents"] = agents

    async def run(self, task):
        result = _FakeRoundTable.canned_result
        result.task_id = task.id
        return result


