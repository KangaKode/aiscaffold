class _UntouchableStore:
    """Any access means the flag-off gate leaked -- fail loudly."""

    def query(self, *a, **k):
        raise AssertionError("learning store touched with TRUST_* off")

    insert = update = query


class _DownStore:
    """Portable store that is down (every operation raises)."""

    def query(self, *a, **k):
        raise RuntimeError("store down")

    insert = update = query


