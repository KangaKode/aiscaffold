class TestFeedbackAPI:
    @pytest.mark.asyncio
    async def test_record_feedback(self, client):
        r = await client.post("/api/v1/feedback", json={
            "signal_type": "accept",
            "agent_id": "test_agent",
            "context_type": "chat",
        })
        assert r.status_code == 200
        assert r.json()["signal_type"] == "accept"

    @pytest.mark.asyncio
    async def test_reject_invalid_signal_type(self, client):
        r = await client.post("/api/v1/feedback", json={
            "signal_type": "invalid_type",
        })
        assert r.status_code == 400

    @pytest.mark.asyncio
    async def test_acceptance_rates(self, client):
        r = await client.get("/api/v1/feedback/rates")
        assert r.status_code == 200
        assert "rates" in r.json()

    @pytest.mark.asyncio
    async def test_feedback_and_trust_are_scoped_to_auth_context(self, scoped_client):
        alice_headers = {"X-Test-User": "alice", "X-Test-Tenant": "tenant-a"}
        bob_headers = {"X-Test-User": "bob", "X-Test-Tenant": "tenant-a"}
        agent_id = "alice_private_agent"

        record_r = await scoped_client.post(
            "/api/v1/feedback",
            json={
                "signal_type": "accept",
                "agent_id": agent_id,
                "context_type": "chat",
            },
            headers=alice_headers,
        )
        assert record_r.status_code == 200

        bob_feedback = await scoped_client.get(
            "/api/v1/feedback",
            headers=bob_headers,
        )
        bob_rates = await scoped_client.get(
            "/api/v1/feedback/rates",
            headers=bob_headers,
        )

        assert bob_feedback.status_code == 200
        assert agent_id not in [s["agent_id"] for s in bob_feedback.json()["signals"]]
        assert bob_rates.status_code == 200
        assert agent_id not in bob_rates.json()["rates"]


