class TestChatAPI:
    @pytest.mark.asyncio
    async def test_chat_validates_empty_message(self, client):
        r = await client.post("/api/v1/chat", json={
            "message": "",
        })
        assert r.status_code == 400

    @pytest.mark.asyncio
    async def test_clear_history(self, client):
        r = await client.post("/api/v1/chat/clear", params={"session_id": "test"})
        assert r.status_code == 200
        assert r.json()["status"] == "cleared"

    @pytest.mark.asyncio
    async def test_chat_profile_context_is_scoped_to_auth_context(self, scoped_client, monkeypatch):
        captured: dict[str, str] = {}
        alice_headers = {"X-Test-User": "alice", "X-Test-Tenant": "tenant-a"}
        bob_headers = {"X-Test-User": "bob", "X-Test-Tenant": "tenant-a"}

        await scoped_client.post(
            "/api/v1/preferences",
            json={
                "preference_type": "style",
                "key": "alice-only-context",
                "value": "alice-secret-value",
                "source": "explicit",
            },
            headers=alice_headers,
        )
        await scoped_client.post(
            "/api/v1/preferences",
            json={
                "preference_type": "style",
                "key": "bob-only-context",
                "value": "bob-private-value",
                "source": "explicit",
            },
            headers=bob_headers,
        )

        class CaptureOrchestrator:
            async def chat(self, message, trust_scores=None, context=""):
                captured["context"] = context or ""
                return ChatResponse(content="ok")

        monkeypatch.setattr(
            chat,
            "_get_or_create_orchestrator",
            lambda session_id, request, auth: CaptureOrchestrator(),
        )

        r = await scoped_client.post(
            "/api/v1/chat",
            json={"message": "use my preferences"},
            headers=bob_headers,
        )

        assert r.status_code == 200
        assert "bob-private-value" in captured["context"]
        assert "alice-secret-value" not in captured["context"]


