class TestSentinelEnforcementAPI:
    @pytest.mark.asyncio
    async def test_sentinel_refusal_maps_to_refused_status(
        self, enforcement_client, monkeypatch
    ):
        from {{ project_slug }}.orchestration.round_table import RoundTableResult
        from {{ project_slug }}.orchestration.round_table_helpers import SentinelRefusal

        client, _ = enforcement_client
        outcomes = []
        monkeypatch.setattr(
            round_table, "record_deliberation",
            lambda outcome, duration: outcomes.append(outcome),
        )
        _FakeRoundTable.canned_result = RoundTableResult(
            task_id="pending",
            sentinel_refusal=SentinelRefusal(
                reason="sentinel_high_risk", detail="methodology extraction",
            ),
        )
        r = await client.post("/api/v1/round-table/tasks", json={"content": "task"})
