@pytest.fixture
async def scoped_client(tmp_path):
    """API client whose auth context is selected by test headers."""
    import os
    from {{ project_slug }}.agents.registry import AgentRegistry

    os.environ.pop("API_KEY", None)
    os.environ.pop("ENV", None)
    registry = AgentRegistry(persist_path=tmp_path / "agents.json")
    app = create_app(registry=registry)

    async def auth_override(request: Request) -> AuthContext:
        user_id = request.headers.get("X-Test-User", "alice")
        tenant_id = request.headers.get("X-Test-Tenant", "tenant-a")
        return AuthContext(
            api_key=f"test-{tenant_id}-{user_id}",
            user_id=user_id,
            tenant_id=tenant_id,
        )

    app.dependency_overrides[verify_api_key] = auth_override
    transport = ASGITransport(app=app)
    async with AsyncClient(transport=transport, base_url="http://test") as c:
        yield c
    app.dependency_overrides.clear()


