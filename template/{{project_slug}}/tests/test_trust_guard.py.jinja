# BURST / DOMINATION DETECTION (detect-only)
# =============================================================================


class TestBurstDetection:
    def test_positive_burst_flags_once_then_escalates(
        self, tracker, store, monkeypatch
    ):
        """T7: threshold positives in window -> one flag; repeats bump the
        hit counter; resolving re-arms. Rate-only campaign also flags."""
        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        _record_positives(tracker, BURST_POSITIVE_THRESHOLD, agent="agent_a")
        check_feedback_burst(store, tracker, "agent_a")
        flags = _flags(store, "trust_positive_burst")
        assert len(flags) == 1
        check_feedback_burst(store, tracker, "agent_a")
        flags = _flags(store, "trust_positive_burst")
        assert len(flags) == 1  # updated in place, not duplicated
        store.update("integrity_flags", flags[0]["id"], {"resolved": 1})
        check_feedback_burst(store, tracker, "agent_a")
        assert len(_flags(store, "trust_positive_burst")) == 2  # re-armed

    def test_rate_only_campaign_flags(self, tracker, store, monkeypatch):
        """T7 (security finding 1): high-confidence rate signals are
        positives -- an accept-free campaign still trips the flag."""
        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        _record_positives(
            tracker, BURST_POSITIVE_THRESHOLD, agent="agent_r",
            stype=SignalType.RATE, conf=0.95,
        )
        check_feedback_burst(store, tracker, "agent_r")
        assert len(_flags(store, "trust_positive_burst")) == 1

    def test_low_confidence_rate_not_positive(self, tracker, store, monkeypatch):
        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        _record_positives(
            tracker, BURST_POSITIVE_THRESHOLD, agent="agent_l",
            stype=SignalType.RATE, conf=POSITIVE_RATE_CONFIDENCE - 0.1,
        )
        check_feedback_burst(store, tracker, "agent_l")
        assert _flags(store, "trust_positive_burst") == []

    def test_single_source_domination_flag(self, tracker, store, monkeypatch):
        """T8: one session >= 80% of positives -> flag; empty session_ids
        excluded; rate-only domination also flags."""
        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        # Spread over hours so the burst window never fires (isolation).
        _record_positives(
            tracker, DOMINATION_MIN_SIGNALS, agent="agent_d",
            session_fn=lambda i: "one_session", spread_minutes=30,
        )
        check_feedback_burst(store, tracker, "agent_d")
        assert len(_flags(store, "trust_single_source_domination")) == 1
        assert _flags(store, "trust_positive_burst") == []

    def test_empty_session_ids_excluded(self, tracker, store, monkeypatch):
        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        _record_positives(
            tracker, DOMINATION_MIN_SIGNALS, agent="agent_e",
            session_fn=lambda i: "", spread_minutes=30,
        )
        check_feedback_burst(store, tracker, "agent_e")
        assert _flags(store, "trust_single_source_domination") == []

    def test_rate_only_domination_flags(self, tracker, store, monkeypatch):
        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        _record_positives(
            tracker, DOMINATION_MIN_SIGNALS, agent="agent_rd",
            stype=SignalType.RATE, conf=0.95,
            session_fn=lambda i: "one_session", spread_minutes=30,
        )
        check_feedback_burst(store, tracker, "agent_rd")
        assert len(_flags(store, "trust_single_source_domination")) == 1

    def test_burst_scans_non_default_project(self, tracker, store, monkeypatch):
        """T10c (SRE finding 1): non-default-project deployments are
        scanned, and the flag lands under the matching tenant."""
        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        _record_positives(
            tracker, BURST_POSITIVE_THRESHOLD, agent="agent_t", project="tenant_a"
        )
        check_feedback_burst(store, tracker, "agent_t", project_id="tenant_a")
        assert len(_flags(store, "trust_positive_burst", tenant="tenant_a")) == 1
        assert _flags(store, "trust_positive_burst", tenant="default") == []

    def test_detail_carries_no_feedback_content(self, tracker, store, monkeypatch):
        """Flag details are counts/timestamps only -- feedback content can
        be user text and must not leak into a new surface."""
        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        now = datetime.now()
        for i in range(BURST_POSITIVE_THRESHOLD):
            sig = _signal("agent_c", SignalType.ACCEPT, f"s{i}", at=now)
            sig.content = "SECRET-USER-TEXT"
            tracker.record(sig)
        check_feedback_burst(store, tracker, "agent_c")
        flags = _flags(store, "trust_positive_burst")
        assert len(flags) == 1
        assert "SECRET-USER-TEXT" not in (flags[0].get("detail_json") or "")


class TestBurstFailureModes:
    def test_burst_nonfatal_on_store_failure(self, tracker, monkeypatch):
        """T10: portable-store failure degrades to a logged no-op."""
        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        _record_positives(tracker, BURST_POSITIVE_THRESHOLD)
        check_feedback_burst(_BrokenStore(), tracker, "agent_a")  # must not raise

    def test_burst_nonfatal_on_tracker_failure(self, store, monkeypatch):
        """T10b (SRE finding 2): LEGACY-side failure (locked sqlite /
        missing table) also degrades to a logged no-op -- both directions
        of the seam are pinned."""
        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        check_feedback_burst(store, _BrokenTracker(), "agent_a")  # must not raise
        assert _flags(store, "trust_positive_burst") == []

    def test_checkin_created_on_new_flag_best_effort(
        self, tracker, store, tmp_path, monkeypatch
    ):
        """T11: check-in appears on first flag; a crashing check-in
        manager never fails the flag write."""
        monkeypatch.setenv(TRUST_BURST_ENV, "true")
        _record_positives(tracker, BURST_POSITIVE_THRESHOLD, agent="agent_a")
        cim = CheckInManager(db_path=tmp_path / "trust.db")
        check_feedback_burst(store, tracker, "agent_a", checkin_manager=cim)
        assert any(
            c.checkin_type == "trust_review" for c in cim.get_pending()
        )
        _record_positives(tracker, BURST_POSITIVE_THRESHOLD, agent="agent_b")
        check_feedback_burst(
            store, tracker, "agent_b", checkin_manager=_CrashingCheckins()
        )
        assert len(_flags(store, "trust_positive_burst")) == 2  # flag still landed


