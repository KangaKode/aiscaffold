class TestFlagOffRegression:
    def test_defaults_off_scores_passthrough(self):
        """T1: no TRUST_* env -> exact get_all_scores() passthrough that
        never touches the entries read."""
        mgr = _RaisingEntries({"a": 0.72, "b": 0.31})
        assert effective_trust_scores(mgr) == {"a": 0.72, "b": 0.31}

    def test_defaults_off_no_burst_write(self, tracker, store):
        """T2: burst call with flag off writes nothing and reads nothing."""
        _record_positives(tracker, BURST_POSITIVE_THRESHOLD)

        class _CountingStore(_BrokenStore):
            pass  # any touch raises -> test fails loudly if reached

        check_feedback_burst(_CountingStore(), _BrokenTracker(), "agent_a")
        # Real store also stays empty when given real inputs:
        check_feedback_burst(store, tracker, "agent_a")
        assert _flags(store, "trust_positive_burst") == []
        assert _flags(store, "trust_single_source_domination") == []


# =============================================================================
# READ-TIME DECAY AND MIN-INTERACTION GATE
# =============================================================================


class TestDecayAndGate:
    def test_decay_math_halflife(self):
        """T4: exact half-life math; unparseable timestamps fail open."""
        now = datetime.now()
        one_hl = (now - timedelta(days=30)).isoformat()
        assert decayed_score(0.9, one_hl, 30.0, now=now) == pytest.approx(0.7)
        assert decayed_score(0.9, now.isoformat(), 30.0, now=now) == pytest.approx(0.9)
        ancient = (now - timedelta(days=3000)).isoformat()
        assert decayed_score(0.9, ancient, 30.0, now=now) == pytest.approx(0.5, abs=1e-4)
        assert decayed_score(0.9, "not-a-timestamp", 30.0, now=now) == 0.9
        assert decayed_score(0.9, "", 30.0, now=now) == 0.9

    def test_decay_double_edge_documented_rate(self):
        """T5: decay rehabilitates JUSTIFIED distrust at the documented
        rate -- 0.15 reports 0.325 after one half-life. Pins the trade-off
        stated in GOVERNANCE so a silent rate change fails a test."""
        now = datetime.now()
        one_hl = (now - timedelta(days=30)).isoformat()
        assert decayed_score(0.15, one_hl, 30.0, now=now) == pytest.approx(0.325)

    def test_decay_applies_via_effective_scores(self, trust_mgr, monkeypatch):
        monkeypatch.setenv(TRUST_DECAY_ENV, "true")
        monkeypatch.setenv(TRUST_DECAY_HALF_LIFE_ENV, "30")
        for _ in range(20):
            trust_mgr.update_from_signal(_signal("agent_hot", SignalType.ACCEPT))
        raw = trust_mgr.get_trust("agent_hot")
        # Fresh last_updated: decay of a just-updated score is ~none.
        eff = effective_trust_scores(trust_mgr)
        assert eff["agent_hot"] == pytest.approx(raw, abs=1e-3)

    def test_min_interaction_gate(self, trust_mgr, monkeypatch):
        """T6: below-gate agents report neutral 0.5 in BOTH directions."""
        monkeypatch.setenv(TRUST_MIN_INTERACTIONS_ENV, "5")
        # Fabricated early praise: 3 accepts (below gate) -> masked to 0.5.
        for _ in range(3):
            trust_mgr.update_from_signal(_signal("fresh_hype", SignalType.ACCEPT))
        # Legitimately earned early distrust: 3 rejects -> ALSO masked
        # (the documented double-edge; raw is ~0.31 here).
        for _ in range(3):
            trust_mgr.update_from_signal(_signal("early_low", SignalType.REJECT))
        # Established agent: 6 accepts -> real score reported.
        for _ in range(6):
            trust_mgr.update_from_signal(_signal("veteran", SignalType.ACCEPT))
        eff = effective_trust_scores(trust_mgr)
        assert eff["fresh_hype"] == DEFAULT_TRUST
        assert trust_mgr.get_trust("early_low") < 0.4  # earned distrust exists...
        assert eff["early_low"] == DEFAULT_TRUST       # ...and is masked below gate
        assert eff["veteran"] == pytest.approx(trust_mgr.get_trust("veteran"))

    def test_gate_off_at_zero(self, trust_mgr, monkeypatch):
        monkeypatch.setenv(TRUST_MIN_INTERACTIONS_ENV, "0")
        trust_mgr.update_from_signal(_signal("solo", SignalType.ACCEPT))
        eff = effective_trust_scores(trust_mgr)
        assert eff["solo"] == pytest.approx(trust_mgr.get_trust("solo"))

    def test_stored_scores_never_mutated(self, trust_mgr, monkeypatch):
        """Rollback completeness: reads with decay+gate on leave stored
        scores untouched, and unsetting the flags restores raw output."""
        monkeypatch.setenv(TRUST_DECAY_ENV, "true")
        monkeypatch.setenv(TRUST_MIN_INTERACTIONS_ENV, "5")
        trust_mgr.update_from_signal(_signal("agent_a", SignalType.ACCEPT))
        raw_before = trust_mgr.get_trust("agent_a")
        for _ in range(3):
            effective_trust_scores(trust_mgr)
        assert trust_mgr.get_trust("agent_a") == pytest.approx(raw_before)
        monkeypatch.delenv(TRUST_DECAY_ENV)
        monkeypatch.delenv(TRUST_MIN_INTERACTIONS_ENV)
        assert effective_trust_scores(trust_mgr)["agent_a"] == pytest.approx(raw_before)


