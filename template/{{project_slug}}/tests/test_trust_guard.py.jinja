def _signal(agent="agent_a", stype=SignalType.ACCEPT, session="", conf=0.5,
            project="default", at=None):
    sig = FeedbackSignal(
        signal_type=stype, agent_id=agent, session_id=session,
        confidence=conf, project_id=project,
    )
    if at is not None:
        sig.created_at = at.isoformat()
    return sig


def _record_positives(tracker, n, agent="agent_a", stype=SignalType.ACCEPT,
                      session_fn=lambda i: f"s{i}", conf=0.9, project="default",
                      spread_minutes=0.0, now=None):
    now = now or datetime.now()
    for i in range(n):
        at = now - timedelta(minutes=spread_minutes * (n - i))
        tracker.record(_signal(agent, stype, session_fn(i), conf, project, at))


def _flags(store, flag_type, tenant="default"):
    return store.query("integrity_flags", {"flag_type": flag_type, "tenant_id": tenant})


class _RaisingEntries:
    """Trust manager stub whose entry read must never be reached (T1)."""

    def __init__(self, scores):
        self._scores = scores

    def get_all_scores(self, project_id="default"):
        return dict(self._scores)

    def get_all_entries(self, project_id="default"):
        raise AssertionError("passthrough path must not read entries")


class _BrokenStore:
    """Portable-store stub that fails every operation (T10)."""

    def query(self, *a, **k):
        raise RuntimeError("store down")

    def insert(self, *a, **k):
        raise RuntimeError("store down")

    def update(self, *a, **k):
        raise RuntimeError("store down")


class _BrokenTracker:
    """Legacy-stack stub whose signal read fails (T10b)."""

    def get_signals(self, *a, **k):
        raise RuntimeError("sqlite locked")


class _CrashingCheckins:
    def create(self, *a, **k):
        raise RuntimeError("checkin backend down")


