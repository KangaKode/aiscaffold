# ENV RESOLUTION AND THE ROUTER-CAP INVARIANT
# =============================================================================


class TestEnvResolution:
    @pytest.mark.parametrize("value,expected", [
        ("true", True), ("1", True), ("yes", True), ("TRUE", True),
        ("false", False), ("0", False), ("", False), ("garbage", False),
    ])
    def test_boolean_parse(self, monkeypatch, value, expected):
        """T12: truthy set matches the detection-hook precedent."""
        monkeypatch.setenv(TRUST_DECAY_ENV, value)
        monkeypatch.setenv(TRUST_BURST_ENV, value)
        flags = resolve_trust_flags()
        assert flags.decay_enabled is expected
        assert flags.burst_enabled is expected

    def test_garbage_numerics_fall_back(self, monkeypatch):
        monkeypatch.setenv(TRUST_MIN_INTERACTIONS_ENV, "not-a-number")
        monkeypatch.setenv(TRUST_DECAY_HALF_LIFE_ENV, "also-not")
        flags = resolve_trust_flags()
        assert flags.min_interactions == 0     # off
        assert flags.half_life_days == 30.0    # documented default

    def test_defaults_all_off(self):
        flags = resolve_trust_flags()
        assert flags.decay_enabled is False
        assert flags.burst_enabled is False
        assert flags.min_interactions == 0


class _Entry:
    def __init__(self, agent, healthy=True, capabilities=()):
        self.agent = agent
        self.healthy = healthy
        self.capabilities = list(capabilities)


class _Agent:
    def __init__(self, name):
        self.name = name
        self.domain = "zzz-no-match"


class _Registry:
    def __init__(self, agents):
        self._entries = [_Entry(a) for a in agents]
        self.count = len(self._entries)

    def list_for_tenant(self, tenant_id):
        return self._entries


class TestRouterCapInvariant:
    def test_router_trust_influence_cap_regression(self):
        """T9 (pinned invariant): AgentRouter adds exactly trust * 0.2 --
        max +0.19 at the 0.95 ceiling. Fails if trust influence widens.
        Pins EXISTING behavior; passes from the moment it is written."""
        router = AgentRouter(registry=_Registry([_Agent("a"), _Agent("b")]))
        decision = router.route("query with no domain words",
                                trust_scores={"a": 0.95})
        # Baseline 0.1 each; agent a adds 0.95 * 0.2 = 0.19.
        # confidence = mean of selected scores = (0.29 + 0.1) / 2.
        assert decision.selected_agents[0].name == "a"
        assert decision.confidence == pytest.approx((0.29 + 0.1) / 2)
