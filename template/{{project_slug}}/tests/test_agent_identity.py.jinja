class TestScopeFilter:
    def test_filter_strips_out_of_scope_keys(self):
        capability = AgentCapability(access_scopes=["financial"])
        context = {"financial": {"q": 1}, "hr_records": {"x": 2}, "logs": []}
        filtered = ScopeFilter().filter_data(context, capability)
        assert filtered == {"financial": {"q": 1}}

    def test_empty_scopes_means_no_filtering(self):
        capability = AgentCapability(access_scopes=[])
        context = {"financial": 1, "hr_records": 2}
        assert ScopeFilter().filter_data(context, capability) == context

    def test_no_capability_means_no_filtering(self):
        context = {"financial": 1, "hr_records": 2}
        assert ScopeFilter().filter_data(context, None) == context

    def test_meta_agent_always_gets_peer_analyses(self):
        capability = AgentCapability(access_scopes=["financial"], is_meta_agent=True)
        context = {"financial": 1, "hr_records": 2, "peer_analyses": ["a"]}
        filtered = ScopeFilter().filter_data(context, capability)
        assert filtered == {"financial": 1, "peer_analyses": ["a"]}

    def test_output_source_violation_flagged(self):
        capability = AgentCapability(access_scopes=["financial"])
        findings = [{
            "finding": "Salary data shows an anomaly",
            "data_sources": ["hr_records"],
        }]
        violations = ScopeFilter().check_output_sources(findings, capability)
        assert len(violations) == 1
        assert "hr_records" in violations[0]

    def test_in_scope_sources_clean(self):
        capability = AgentCapability(access_scopes=["financial"])
        findings = [{"finding": "Revenue dipped", "data_sources": ["financial"]}]
        assert ScopeFilter().check_output_sources(findings, capability) == []

    def test_empty_scopes_exempt_from_output_check(self):
        capability = AgentCapability(access_scopes=[])
        findings = [{"finding": "Anything goes", "data_sources": ["hr_records"]}]
        assert ScopeFilter().check_output_sources(findings, capability) == []


