class TestRateLimiter:
    def test_default_limit_allows_100_blocks_101(self):
        limiter = AgentRateLimiter()
        for _ in range(DEFAULT_MAX_CALLS_PER_HOUR):
            assert limiter.check_and_record("busy_agent") is True
        assert limiter.check_and_record("busy_agent") is False

    def test_agents_have_independent_counters(self):
        limiter = AgentRateLimiter()
        for _ in range(DEFAULT_MAX_CALLS_PER_HOUR):
            assert limiter.check_and_record("agent_a") is True
        assert limiter.check_and_record("agent_a") is False
        assert limiter.check_and_record("agent_b") is True

    def test_custom_max_calls(self):
        limiter = AgentRateLimiter()
        for _ in range(3):
            assert limiter.check_and_record("small_quota", max_calls=3) is True
        assert limiter.check_and_record("small_quota", max_calls=3) is False

    def test_window_slides(self):
        limiter = AgentRateLimiter()
        assert limiter.check_and_record("slider", max_calls=1, now=1000.0) is True
        assert limiter.check_and_record("slider", max_calls=1, now=1001.0) is False
        # One hour later the first call has aged out.
        assert limiter.check_and_record("slider", max_calls=1, now=1000.0 + 3601) is True


# =============================================================================
# REGISTRY CREDENTIAL LIFECYCLE
# =============================================================================


class TestRegistryLifecycle:
    def test_rotate_returns_new_token_and_changes_hash(self, tmp_path, monkeypatch):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        registry.register_local(SimpleAgent("rotator"))
        entry = registry.get_entry("rotator")
        old_hash = entry.identity_token_hash

        # Tokens carry second-resolution iat/exp claims, so a rotation within
        # the same second would re-issue a byte-identical JWT. Shift the clock
        # forward to make the rotation observable.
        real_time = time.time
        monkeypatch.setattr(time, "time", lambda: real_time() + 60)
        new_token = registry.rotate_credentials("rotator")

        assert isinstance(new_token, str)
        assert entry.identity_token == new_token
        assert entry.identity_token_hash == hash_token(new_token)
        assert entry.identity_token_hash != old_hash

    def test_rotate_unknown_agent_returns_none(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        assert registry.rotate_credentials("nobody") is None

    def test_revoke_clears_token_and_hash(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        registry.register_local(SimpleAgent("revokee"))

        assert registry.revoke_credentials("revokee") is True

        entry = registry.get_entry("revokee")
        assert entry.identity_token is None
        assert entry.identity_token_hash is None
        assert entry.to_dict()["credential_status"] == "none"

    def test_revoke_unknown_agent_returns_false(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        assert registry.revoke_credentials("nobody") is False

    def test_suspend_excludes_from_tenant_listing(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        registry.register_local(SimpleAgent("visible_one"))
        registry.register_local(SimpleAgent("hidden_one"))

        registry.suspend("hidden_one")
        names = [e.agent.name for e in registry.list_for_tenant()]
        assert "hidden_one" not in names
        assert "visible_one" in names

        registry.unsuspend("hidden_one")
        names = [e.agent.name for e in registry.list_for_tenant()]
        assert "hidden_one" in names

    def test_persistence_stores_hash_never_raw_token(self, tmp_path):
        persist_path = tmp_path / "agents.json"
        registry = AgentRegistry(persist_path=persist_path)
        registry.register_remote("remote_persist", "testing", "https://example.com")

        entry = registry.get_entry("remote_persist")
        raw_token = entry.identity_token
        assert raw_token is not None

        on_disk = persist_path.read_text()
        assert raw_token not in on_disk
        data = json.loads(on_disk)
        saved = data["remote_agents"][0]
        assert saved["identity_token_hash"] == entry.identity_token_hash
        assert "identity_token" not in saved

    def test_reloaded_remote_agent_has_no_raw_token(self, tmp_path):
        persist_path = tmp_path / "agents.json"
        registry = AgentRegistry(persist_path=persist_path)
        registry.register_remote("remote_reload", "testing", "https://example.com")
        old_hash = registry.get_entry("remote_reload").identity_token_hash

        reloaded = AgentRegistry(persist_path=persist_path)
        entry = reloaded.get_entry("remote_reload")
        assert entry is not None
        assert entry.identity_token is None
        assert entry.identity_token_hash == old_hash


