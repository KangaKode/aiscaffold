# QUORUM DEGRADATION
# =============================================================================


class FailingAgent:
    """Agent whose analyze() always raises (simulates an offline agent)."""

    def __init__(self, name):
        self._name = name

    @property
    def name(self) -> str:
        return self._name

    @property
    def domain(self) -> str:
        return "unavailable"

    async def analyze(self, task):
        raise RuntimeError("agent offline")

    async def challenge(self, task, other_analyses):
        raise RuntimeError("agent offline")

    async def vote(self, task, synthesis):
        raise RuntimeError("agent offline")


def quorum_config(tmp_path):
    return RoundTableConfig(
        enable_strategy_phase=False,
        enable_challenge_phase=False,
        include_core_agents=False,
        enforce_evidence=False,
        min_quorum=2,
        artifacts_dir=tmp_path / "artifacts",
    )


class TestQuorumDegradation:
    @pytest.mark.asyncio
    async def test_all_agents_failing_marks_degraded(self, tmp_path):
        rt = RoundTable(
            agents=[FailingAgent("down_a"), FailingAgent("down_b")],
            config=quorum_config(tmp_path),
        )
        result = await rt.run(RoundTableTask(id="quorum_fail", content="test"))
        assert result.degraded is True
        assert result.failed_agent_count == 2
        assert result.analyses == []

    @pytest.mark.asyncio
    async def test_one_survivor_below_quorum_marks_degraded(
        self, tmp_path, mock_agent
    ):
        rt = RoundTable(
            agents=[mock_agent, FailingAgent("down_a")],
            config=quorum_config(tmp_path),
        )
        result = await rt.run(RoundTableTask(id="quorum_partial", content="test"))
        assert result.degraded is True
        assert result.failed_agent_count == 1
        assert len(result.analyses) == 1

    @pytest.mark.asyncio
    async def test_suspended_agents_count_toward_degradation(
        self, tmp_path, mock_agents
    ):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        for agent in mock_agents:
            registry.register_local(agent)
            registry.suspend(agent.name)

        rt = RoundTable(
            agents=mock_agents,
            config=quorum_config(tmp_path),
            registry=registry,
        )
        result = await rt.run(RoundTableTask(id="quorum_suspended", content="test"))
        assert result.degraded is True
        assert result.failed_agent_count == 2
        assert result.analyses == []

    @pytest.mark.asyncio
    async def test_healthy_table_not_degraded(self, tmp_path, mock_agents):
        rt = RoundTable(agents=mock_agents, config=quorum_config(tmp_path))
        result = await rt.run(RoundTableTask(id="quorum_healthy", content="test"))
        assert result.degraded is False
        assert result.failed_agent_count == 0
        assert len(result.analyses) == 2
