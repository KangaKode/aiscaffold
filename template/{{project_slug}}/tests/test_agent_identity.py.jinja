class TestIdentityCheckPolicy:
    def test_no_registry_allowed(self):
        assert verify_agent_identity(SimpleAgent("anyone"), None) is True

    def test_unregistered_agent_allowed(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        assert verify_agent_identity(SimpleAgent("ghost"), registry) is True

    def test_local_agent_without_token_allowed(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        agent = SimpleAgent("local_notoken")
        registry.register_local(agent)
        registry.get_entry("local_notoken").identity_token = None
        assert verify_agent_identity(agent, registry) is True

    def test_remote_agent_without_token_blocked(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        agent = registry.register_remote(
            "remote_notoken", "testing", "https://example.com"
        )
        registry.get_entry("remote_notoken").identity_token = None
        assert verify_agent_identity(agent, registry) is False

    def test_suspended_agent_blocked(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        agent = SimpleAgent("suspended_one")
        registry.register_local(agent)
        registry.suspend("suspended_one")
        assert verify_agent_identity(agent, registry) is False

    def test_invalid_token_blocked(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        agent = SimpleAgent("bad_token_agent")
        registry.register_local(agent)
        entry = registry.get_entry("bad_token_agent")
        entry.identity_token = tamper_signature(entry.identity_token)
        assert verify_agent_identity(agent, registry) is False

    def test_valid_token_allowed(self, tmp_path):
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        agent = SimpleAgent("good_agent")
        registry.register_local(agent)
        assert verify_agent_identity(agent, registry) is True


