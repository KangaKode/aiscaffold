TEST_SIGNING_KEY = "0123456789abcdef" * 4  # 64 chars, meets the minimum


@pytest.fixture(autouse=True)
def identity_env(monkeypatch):
    """Pin the signing key and reset the module cache around every test.

    The identity module caches the signing key after first use, so tests
    must reset it or they'd leak a key from a previous test (or a dev-mode
    ephemeral key) into the next one.
    """
    monkeypatch.setenv("AGENT_IDENTITY_SIGNING_KEY", TEST_SIGNING_KEY)
    for var in (
        "AGENT_IDENTITY_ENABLED",
        "ENV",
        "ENVIRONMENT",
        "AGENT_DEFAULT_TTL_DAYS",
        "AGENT_MAX_TTL_DAYS",
        "AGENT_DORMANT_AFTER_DAYS",
    ):
        monkeypatch.delenv(var, raising=False)
    identity._reset_signing_key()
    yield
    identity._reset_signing_key()


def make_expired_token(agent_id: str = "stale_agent") -> str:
    """Craft a token that expired an hour ago, signed with the test key.

    issue_token clamps TTL to a minimum of 1 day, so expiry has to be
    forged directly to test rejection.
    """
    now = int(time.time())
    claims = {
        "sub": agent_id,
        "tid": "default",
        "scopes": [],
        "meta": False,
        "iat": now - 7200,
        "exp": now - 3600,
        "iss": ISSUER,
        "aud": AUDIENCE,
    }
    return pyjwt.encode(claims, TEST_SIGNING_KEY, algorithm="HS256")


def tamper_signature(token: str) -> str:
    """Corrupt the middle of the JWT signature segment.

    The middle character is used (not the last) because the final base64url
    character only contributes padding bits -- flipping it may decode to the
    same signature bytes and still verify.
    """
    header, payload, sig = token.split(".")
    mid = len(sig) // 2
    replacement = "A" if sig[mid] != "A" else "B"
    return f"{header}.{payload}.{sig[:mid]}{replacement}{sig[mid + 1:]}"


class SimpleAgent:
    """Minimal agent with just name/domain for registry tests."""

    def __init__(self, name, domain="general analysis"):
        self._name = name
        self._domain = domain

    @property
    def name(self) -> str:
        return self._name

    @property
    def domain(self) -> str:
        return self._domain


# =============================================================================
# TOKEN ISSUE / VERIFY
# =============================================================================


class TestTokenRoundTrip:
    def test_issue_then_verify_returns_claims(self):
        token, ttl = issue_token(
            "analyst_x", "tenant-a", ["financial"], is_meta_agent=True
        )
        assert isinstance(token, str)
        assert ttl >= 1

        claims = verify_token(token)
        assert claims is not None
        assert claims.agent_id == "analyst_x"
        assert claims.tenant_id == "tenant-a"
        assert claims.scopes == ["financial"]
        assert claims.is_meta_agent is True
        assert claims.issuer == ISSUER
        assert claims.expires_at > claims.issued_at

    def test_expired_token_rejected(self):
        assert verify_token(make_expired_token()) is None

    def test_tampered_token_rejected(self):
        token, _ttl = issue_token("analyst_x", "default", [])
        assert verify_token(token) is not None
        assert verify_token(tamper_signature(token)) is None
        assert verify_token("not-a-jwt-at-all") is None


class TestKillSwitch:
    def test_disabled_accepts_valid_unexpired_token(self, monkeypatch):
        token, _ttl = issue_token("analyst_x", "tenant-a", ["logs"])
        monkeypatch.setenv("AGENT_IDENTITY_ENABLED", "false")
        claims = verify_token(token)
        assert claims is not None
        assert claims.agent_id == "analyst_x"

    def test_disabled_still_rejects_expired_token(self, monkeypatch):
        expired = make_expired_token()
        monkeypatch.setenv("AGENT_IDENTITY_ENABLED", "false")
        assert verify_token(expired) is None


class TestHashToken:
    def test_deterministic(self):
        token, _ttl = issue_token("analyst_x", "default", [])
        assert hash_token(token) == hash_token(token)

    def test_hash_differs_from_raw_token(self):
        token, _ttl = issue_token("analyst_x", "default", [])
        digest = hash_token(token)
        assert digest != token
        assert len(digest) == 64  # sha256 hex

    def test_different_tokens_different_hashes(self):
        token_a, _ = issue_token("agent_a", "default", [])
        token_b, _ = issue_token("agent_b", "default", [])
        assert hash_token(token_a) != hash_token(token_b)


