class TestDormancy:
    def test_old_last_active_is_dormant(self, monkeypatch):
        monkeypatch.setenv("AGENT_DORMANT_AFTER_DAYS", "1")
        two_days_ago = (datetime.now(UTC) - timedelta(days=2)).isoformat()
        entry = AgentEntry(agent=SimpleAgent("sleeper"), last_active=two_days_ago)
        assert entry.is_dormant is True
        assert entry.to_dict()["dormant"] is True

    def test_fresh_last_active_not_dormant(self, monkeypatch):
        monkeypatch.setenv("AGENT_DORMANT_AFTER_DAYS", "1")
        entry = AgentEntry(
            agent=SimpleAgent("awake"),
            last_active=datetime.now(UTC).isoformat(),
        )
        assert entry.is_dormant is False

    def test_no_last_active_not_dormant(self, monkeypatch):
        monkeypatch.setenv("AGENT_DORMANT_AFTER_DAYS", "1")
        entry = AgentEntry(agent=SimpleAgent("never_ran"), last_active=None)
        assert entry.is_dormant is False


