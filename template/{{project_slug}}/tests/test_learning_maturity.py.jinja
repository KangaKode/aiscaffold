# --- Reflections API ---------------------------------------------------------


class TestReflectionsAPI:
    @pytest.fixture
    async def api(self, store, tmp_path, monkeypatch):
        from httpx import ASGITransport, AsyncClient

        from {{project_slug}}.agents.registry import AgentRegistry
        from {{project_slug}}.api.gateway import create_app

        monkeypatch.delenv("API_KEY", raising=False)
        monkeypatch.delenv("ENV", raising=False)
        monkeypatch.setenv("ACTIVITY_TRACKING_ENABLED", "false")
        monkeypatch.chdir(tmp_path)

        app = create_app(registry=AgentRegistry(persist_path=tmp_path / "agents.json"))
        app.state.learning_store = store
        transport = ASGITransport(app=app)
        async with AsyncClient(transport=transport, base_url="http://test") as client:
            yield client

    async def test_lists_tenant_reflections(self, api, store):
        reflect(_rich_result(), tenant_id="default", store=store)

        resp = await api.get("/api/v1/reflections")
        assert resp.status_code == 200
        body = resp.json()
        assert body["total"] >= 1
        assert body["reflections"][0]["reflection_type"] in ReflectionType.ALL

    async def test_filters_by_type_and_validates(self, api, store):
        reflect(_rich_result(), tenant_id="default", store=store)

        resp = await api.get(
            "/api/v1/reflections",
            params={"reflection_type": ReflectionType.AGENT_EFFECTIVENESS},
        )
        assert resp.status_code == 200
        assert all(
            r["reflection_type"] == ReflectionType.AGENT_EFFECTIVENESS
            for r in resp.json()["reflections"]
        )

        bad = await api.get(
            "/api/v1/reflections", params={"reflection_type": "not-a-type"}
        )
        assert bad.status_code == 400
