# =============================================================================

SRC_PACKAGE = os.path.join(PROJECT_ROOT, "src", "{{ project_slug }}")
SRC_MAX_FILE_LINES = 800

SRC_ALLOWED_IMPORTS = {
    "agents": {"enforcement", "llm", "orchestration", "security"},
    "api": {
        "agents", "connectors", "harness", "learning", "llm",
        "observability", "orchestration", "security",
