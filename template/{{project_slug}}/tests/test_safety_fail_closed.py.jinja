class TestEnforcementRewriteFailClosed:
    SPECULATIVE_TEXT = (
        "I think this probably indicates a breach and I believe "
        "the attacker likely used stolen credentials. It appears "
        "that the system was compromised. This suggests lateral movement."
    )

    @pytest.mark.asyncio
    async def test_budget_exhausted_rewrite_stays_rejected(self):
        """THE laundering finding: pre-fix, _rewrite returned the
        bracketed budget-error string as the 'corrected' text; it passed
        every validator with zero violations, the pipeline returned
        outcome='accepted', and enforce_evidence kept the ORIGINAL
        violating analysis. Exhausting a tenant's budget silently
        disabled evidence enforcement. This test fails on that code."""
        from {{project_slug}}.enforcement import EvidenceEnforcementPipeline

        pipeline = EvidenceEnforcementPipeline(
            llm_client=_budget_exhausted_client()
        )
        result = await pipeline.validate("unsafe_agent", self.SPECULATIVE_TEXT)
        assert result.outcome == "rejected"
        assert not result.corrected_content

    @pytest.mark.asyncio
    async def test_transport_error_rewrite_stays_rejected(self):
        from {{project_slug}}.enforcement import EvidenceEnforcementPipeline

        pipeline = EvidenceEnforcementPipeline(llm_client=StubLLM(
            _error_response("[LLM call failed: APITimeoutError]", "call_failed")
        ))
        result = await pipeline.validate("unsafe_agent", self.SPECULATIVE_TEXT)
        assert result.outcome == "rejected"


class TestSynthesisFailClosed:
    @pytest.mark.asyncio
    async def test_error_string_never_becomes_recommendation(self):
        """Pre-fix, an errored synthesis call put the raw error string
        into recommended_direction (content[:500]), which flows into
        check-in suggested_action and the API response."""
        from {{project_slug}}.orchestration.round_table import RoundTableResult
        from {{project_slug}}.orchestration.round_table_helpers import phase_synthesis

        partial = RoundTableResult(task_id="synth_fail", analyses=[
            AgentAnalysis(agent_name="a", domain="testing",
                          observations=[{"finding": "x", "evidence": "y"}]),
        ])
        synthesis = await phase_synthesis(
            partial, _budget_exhausted_client(), "system prompt"
        )
        assert "Budget exhausted" not in synthesis.recommended_direction
        assert synthesis.recommended_direction == (
            "Synthesis failed -- review individual analyses"
        )


# =============================================================================
# 3. Challenge/vote dispatch gates
# =============================================================================


class TrackingAgent:
    """Records which phases it was dispatched in, and the context it saw."""

    def __init__(self, name: str, domain: str = "general analysis"):
        self.name = name
        self.domain = domain
        self.challenge_called = False
        self.vote_called = False
        self.challenge_context: dict | None = None
        self.vote_context: dict | None = None

    async def analyze(self, task):
        return AgentAnalysis(agent_name=self.name, domain=self.domain,
                             confidence=0.7)

    async def challenge(self, task, other_analyses):
        self.challenge_called = True
        self.challenge_context = dict(task.context)
        return AgentChallenge(agent_name=self.name)

    async def vote(self, task, synthesis):
        self.vote_called = True
        self.vote_context = dict(task.context)
        return AgentVote(agent_name=self.name, approve=True)


class SelfSuspendingAgent(TrackingAgent):
    """Suspends itself in the registry during Phase 1 -- models an agent
    suspended by an operator between analysis and the later phases."""

    def __init__(self, name: str, registry: AgentRegistry):
        super().__init__(name)
        self._registry = registry

    async def analyze(self, task):
        result = await super().analyze(task)
        self._registry.suspend(self.name)
        return result


def _config(tmp_path, **overrides) -> RoundTableConfig:
    defaults = dict(
        artifacts_dir=tmp_path / "artifacts",
        include_core_agents=False,
        enforce_evidence=False,
        enable_strategy_phase=False,
        enable_challenge_phase=True,
        premise_challenge_enabled=False,
    )
    defaults.update(overrides)
    return RoundTableConfig(**defaults)


class TestChallengeVoteGating:
    @pytest.mark.asyncio
    async def test_agent_suspended_between_phases_is_excluded(self, tmp_path):
        """Pre-fix, _phase_challenge and _phase_voting iterated
        self.agents directly with no gate checks, so a mid-run suspension
        changed nothing: the suspended agent still challenged and voted
        (3 votes, not 2). This test fails on that code."""
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        steady_a = TrackingAgent("steady_a")
        steady_b = TrackingAgent("steady_b")
        turncoat = SelfSuspendingAgent("turncoat", registry)
        agents = [steady_a, steady_b, turncoat]
        for agent in agents:
            registry.register_local(agent)

        rt = RoundTable(agents=agents, config=_config(tmp_path),
                        registry=registry)
        result = await rt.run(_task())

        # Phase 1 dispatched all three (suspension landed mid-phase).
        assert len(result.analyses) == 3

        # Phases 2 and 3 re-check the gates: suspended agent excluded.
        assert turncoat.challenge_called is False
        assert turncoat.vote_called is False
        assert steady_a.challenge_called and steady_b.challenge_called
        assert {v.agent_name for v in result.votes} == {"steady_a", "steady_b"}

    @pytest.mark.asyncio
    async def test_consensus_math_handles_shrinking_voter_set(self, tmp_path):
        """Both remaining agents approve: approval must be 2/2 = 1.0
        (votes actually cast), not 2/3 against the original roster --
        and the run must complete rather than deadlock."""
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        agents = [
            TrackingAgent("steady_a"),
            TrackingAgent("steady_b"),
            SelfSuspendingAgent("turncoat", registry),
        ]
        for agent in agents:
            registry.register_local(agent)

        rt = RoundTable(
            agents=agents,
            config=_config(tmp_path, consensus_threshold=0.7),
            registry=registry,
        )
        result = await rt.run(_task())

        assert len(result.votes) == 2
        assert result.approval_rate == 1.0
        assert result.consensus_reached is True

    @pytest.mark.asyncio
    async def test_vote_phase_gate_out_marks_result_degraded(self, tmp_path):
        """Pre-fix, vote-phase gate-outs were only logged: degraded was
        computed from Phase 1 alone, so a dissenter silently gated out
        at the vote (e.g. its rate window burned by cheap tasks) shrank
        the consensus denominator with no trace in the result. Now any
        vote-phase gate-out sets degraded=True and reports the count."""
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        agents = [
            TrackingAgent("steady_a"),
            TrackingAgent("steady_b"),
            SelfSuspendingAgent("turncoat", registry),
        ]
        for agent in agents:
            registry.register_local(agent)

        rt = RoundTable(agents=agents, config=_config(tmp_path),
                        registry=registry)
        result = await rt.run(_task())

        assert result.vote_gated_count == 1
        assert result.degraded is True

    @pytest.mark.asyncio
    async def test_no_gate_outs_means_not_degraded(self, tmp_path):
        """Clean runs stay clean: no gate-outs, no degraded flag."""
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        agents = [TrackingAgent("steady_a"), TrackingAgent("steady_b")]
        for agent in agents:
            registry.register_local(agent)

        rt = RoundTable(agents=agents, config=_config(tmp_path),
                        registry=registry)
        result = await rt.run(_task())

        assert result.vote_gated_count == 0
        assert result.degraded is False

    @pytest.mark.asyncio
    async def test_scope_filter_applies_to_challenge_and_vote(self, tmp_path):
        """Later phases receive the scope-filtered task exactly as
        Phase 1 does: context keys outside the agent's access_scopes
        must not appear in challenge/vote dispatches either."""
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        scoped = TrackingAgent("scoped_agent")
        registry.register_local(
            scoped, capability=AgentCapability(access_scopes=["allowed_key"]),
        )

        rt = RoundTable(agents=[scoped], config=_config(tmp_path),
                        registry=registry)
        task = RoundTableTask(
            id="scope_test", content="Analyze",
            context={"allowed_key": "visible", "secret_key": "hidden"},
        )
        await rt.run(task)

        assert scoped.challenge_context is not None
        assert scoped.vote_context is not None
        assert "secret_key" not in scoped.challenge_context
        assert "secret_key" not in scoped.vote_context
        assert scoped.challenge_context.get("allowed_key") == "visible"

    @pytest.mark.asyncio
    async def test_rate_limit_gates_later_phases(self, tmp_path):
        """Each phase consumes one rate-limit token; an agent capped at
        1 call/hour analyzes but is blocked from challenge and vote."""
        registry = AgentRegistry(persist_path=tmp_path / "agents.json")
        capped = TrackingAgent("capped_agent")
        free = TrackingAgent("free_agent")
        registry.register_local(
            capped, capability=AgentCapability(max_calls_per_hour=1),
        )
        registry.register_local(free)

        rt = RoundTable(agents=[capped, free], config=_config(tmp_path),
                        registry=registry)
        result = await rt.run(_task())

        assert len(result.analyses) == 2
        assert capped.challenge_called is False
        assert capped.vote_called is False
        assert free.vote_called is True
        assert {v.agent_name for v in result.votes} == {"free_agent"}
