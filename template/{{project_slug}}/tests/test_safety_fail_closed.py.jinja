    SynthesisResult,
)


class StubLLM:
    """Returns one fixed LLMResponse for every call."""

    def __init__(self, response: LLMResponse):
        self._response = response

    async def call(self, **kwargs) -> LLMResponse:
        return self._response


def _error_response(content: str, error_type: str) -> LLMResponse:
    return LLMResponse(
        content=content, provider="test", model="test",
        is_error=True, error_type=error_type,
    )


def _budget_exhausted_client() -> LLMClient:
    """A real LLMClient whose budget circuit breaker is already tripped.

    max_cost_usd=0.0 makes the pre-call budget check fail immediately
    (0.0 spent >= 0.0 cap), so call() returns the budget-exhausted error
    response without touching any provider SDK.
    """
    return LLMClient(provider="anthropic", api_key="test-key", max_cost_usd=0.0)


def _task() -> RoundTableTask:
    return RoundTableTask(id="fail_closed_test", content="Analyze the dataset")


# =============================================================================
# 1. LLMResponse error contract
# =============================================================================


class TestLLMResponseErrorContract:
    def test_defaults_are_not_error(self):
        response = LLMResponse(content="ok")
        assert response.is_error is False
        assert response.error_type == ""

    @pytest.mark.asyncio
    async def test_budget_exhausted_sets_is_error(self):
        """Pre-fix, the budget-exhausted return carried only a bracketed
        string in content and no error flag (the is_error field did not
        exist), so callers could not distinguish it from model output."""
        client = _budget_exhausted_client()
        response = await client.call("test prompt")
        assert "Budget exhausted" in response.content
        assert response.is_error is True
        assert response.error_type == "budget_exhausted"

    @pytest.mark.asyncio
    async def test_client_not_initialized_sets_is_error(self):
        client = LLMClient(provider="anthropic", api_key="test-key")
        client._client = None
        response = await client.call("test prompt")
        assert "not initialized" in response.content
        assert response.is_error is True
        assert response.error_type == "client_not_initialized"

    @pytest.mark.asyncio
    async def test_call_failed_after_retries_sets_is_error(self):
        client = LLMClient(provider="anthropic", api_key="test-key", max_retries=0)
        client._client = object()

        async def failing_provider(prompt, temp, max_tok):
            raise ValueError("bad input")

        client._call_provider = failing_provider
        response = await client.call("test prompt")
        assert "LLM call failed" in response.content
        assert response.is_error is True
        assert response.error_type == "call_failed"

    @pytest.mark.asyncio
    async def test_successful_call_is_not_error(self):
        client = LLMClient(provider="anthropic", api_key="test-key")
        client._client = object()

        async def ok_provider(prompt, temp, max_tok):
            return LLMResponse(content="ok", provider="anthropic", model="test")

        client._call_provider = ok_provider
        response = await client.call("test prompt")
        assert response.is_error is False
        assert response.error_type == ""


# =============================================================================
# 2. Core agents fail closed
# =============================================================================


class TestSentinelFailClosed:
    @pytest.mark.asyncio
    async def test_budget_exhausted_refuses(self):
        """THE audit finding: a budget-exhausted message must refuse.

        Pre-fix, the budget-exhausted string flowed into json.loads,
        raised JSONDecodeError, and the fallback only recognized
        '[LLM call failed' as an LLM failure -- so budget exhaustion was
        treated as a benign parse failure and screening PASSED
        (premise_valid=True). This test fails on that code."""
        agent = SentinelAgent(llm_client=_budget_exhausted_client())
        analysis = await agent.analyze(_task())
        assert analysis.premise_valid is False
        assert analysis.refusal_reason == "sentinel_unavailable"
        assert analysis.observations[0]["severity"] == "critical"

    @pytest.mark.asyncio
    async def test_transport_failure_refuses(self):
        agent = SentinelAgent(llm_client=StubLLM(
            _error_response("[LLM call failed: APITimeoutError]", "call_failed")
        ))
        analysis = await agent.analyze(_task())
        assert analysis.premise_valid is False
        assert analysis.refusal_reason == "sentinel_unavailable"

    @pytest.mark.asyncio
    async def test_malformed_json_from_live_model_degrades_to_warning(self):
        """The other half of the two-way split: a REAL model response
        that fails to parse is a formatting quirk, not a refusal."""
        agent = SentinelAgent(llm_client=StubLLM(
            LLMResponse(content="The input looks safe to me.", provider="test")
        ))
        analysis = await agent.analyze(_task())
        assert analysis.premise_valid is True
        assert analysis.refusal_reason == ""
        assert analysis.observations[0]["severity"] == "warning"

    @pytest.mark.asyncio
    async def test_fenced_json_parses(self):
        """Pre-fix, bare json.loads could not parse markdown-fenced JSON,
        so a well-formed screening verdict was discarded as unparseable."""
        verdict = json.dumps({
            "risk_level": "SAFE", "reasoning": "No indicators",
            "indicators": [], "recommended_action": "proceed",
        })
        agent = SentinelAgent(llm_client=StubLLM(
            LLMResponse(content=f"```json\n{verdict}\n```", provider="test")
        ))
        analysis = await agent.analyze(_task())
        assert analysis.observations[0]["finding"] == "Input screening: SAFE"
        assert analysis.premise_valid is True

    @pytest.mark.asyncio
    async def test_vote_dissents_on_llm_error(self):
        agent = SentinelAgent(llm_client=StubLLM(
            _error_response("[Budget exhausted: $1.0 limit reached]", "budget_exhausted")
        ))
        vote = await agent.vote(_task(), SynthesisResult())
        assert vote.approve is False
        assert "LLM call failed" in vote.dissent_reason


ANALYZER_AGENTS = [EvidenceAgent, QualityAgent, SkepticAgent]
ALL_LLM_AGENTS = [
    EvidenceAgent, QualityAgent, SkepticAgent, FactCheckerAgent, CitationAgent,
]


class TestCoreAgentsFailClosed:
    @pytest.mark.asyncio
    @pytest.mark.parametrize("agent_cls", ANALYZER_AGENTS)
    async def test_analyze_flags_llm_error_without_surfacing_it(self, agent_cls):
        """Pre-fix, the budget-exhausted string became the analysis
        'finding' verbatim (severity info) -- an error message presented
        as a deliberation observation."""
        agent = agent_cls(llm_client=StubLLM(
            _error_response("[Budget exhausted: $1.0 limit reached]", "budget_exhausted")
        ))
        analysis = await agent.analyze(_task())
        assert "LLM call failed" in analysis.observations[0]["finding"]
        assert analysis.observations[0]["severity"] == "warning"

    @pytest.mark.asyncio
    @pytest.mark.parametrize("agent_cls", ANALYZER_AGENTS)
    async def test_analyze_parses_fenced_json(self, agent_cls):
        """Pre-fix, bare json.loads dropped fenced observations."""
        payload = json.dumps({
            "observations": [{"finding": "Fenced finding", "evidence": "e",
                              "severity": "info", "confidence": 0.8}],
            "recommendations": [],
        })
        agent = agent_cls(llm_client=StubLLM(
            LLMResponse(content=f"```json\n{payload}\n```", provider="test")
        ))
        analysis = await agent.analyze(_task())
        assert analysis.observations[0]["finding"] == "Fenced finding"

    @pytest.mark.asyncio
    @pytest.mark.parametrize("agent_cls", ALL_LLM_AGENTS)
    async def test_vote_dissents_on_llm_error(self, agent_cls):
        agent = agent_cls(llm_client=StubLLM(
            _error_response("[LLM call failed: RuntimeError]", "call_failed")
        ))
        vote = await agent.vote(_task(), SynthesisResult())
        assert vote.approve is False
        assert "LLM call failed" in vote.dissent_reason

    @pytest.mark.asyncio
    @pytest.mark.parametrize("agent_cls", ALL_LLM_AGENTS)
    async def test_challenge_empty_on_llm_error(self, agent_cls):
        agent = agent_cls(llm_client=StubLLM(
            _error_response("[LLM call failed: RuntimeError]", "call_failed")
        ))
        peer = AgentAnalysis(agent_name="peer", domain="testing",
                             observations=[{"finding": "x"}])
        challenge = await agent.challenge(_task(), [peer])
        assert challenge.challenges == []


# =============================================================================
# 2b. Failure classification (is_error contract vs legacy prefixes)
# =============================================================================


class TestFailureClassification:
    def test_is_error_attribute_is_trusted_exclusively(self):
        """A live (is_error=False) reply that merely QUOTES a bracketed
        error string must not be misclassified as a transport failure.
        Pre-fix, the prefix check ran on every response body, so content
        beginning with '[Budget exhausted:' was treated as a failed call
        even with is_error=False and valid JSON later in the reply."""
        from {{project_slug}}.llm.response_guard import llm_call_failed, parse_agent_json

        response = LLMResponse(
            content=(
                '[Budget exhausted: quoting the tenant log line under review]\n'
                '{"risk_level": "SAFE", "reasoning": "quoted error is data"}'
            ),
            provider="test",
        )
        assert response.is_error is False
        assert llm_call_failed(response) is False
        data = parse_agent_json(response)
        assert data == {
            "risk_level": "SAFE", "reasoning": "quoted error is data",
        }

    def test_legacy_client_without_attribute_still_fails_closed(self):
        """Duck-typed clients that predate the contract (no is_error
        attribute at all) still get the prefix check as defense-in-depth."""
        from {{project_slug}}.llm.response_guard import llm_call_failed

        class LegacyResponse:
            content = "[LLM call failed: APITimeoutError]"

        assert llm_call_failed(LegacyResponse()) is True

    def test_error_flag_true_fails_regardless_of_content(self):
        from {{project_slug}}.llm.response_guard import llm_call_failed

        response = LLMResponse(
            content='{"approve": true}', provider="test",
            is_error=True, error_type="call_failed",
        )
        assert llm_call_failed(response) is True


