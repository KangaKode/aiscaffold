"""Tests for optional Prometheus metrics -- the no-op shim (absent path),
the present path (skipped unless prometheus_client is importable), the
LLM_PROVIDER=mock factory branch, and the metrics route (auth + 501)."""

import os

import pytest

from {{project_slug}}.observability import metrics as obs_metrics
from {{project_slug}}.llm import MockLLMClient, create_client


def _record_everything():
    """Call every public record function once."""
    obs_metrics.record_deliberation("completed", 12.5)
    obs_metrics.record_deliberation("failed", 0.0)
    obs_metrics.record_phase("analysis", 3.2)
    obs_metrics.record_phase("", 3.2)  # empty phase is ignored
    obs_metrics.record_llm_call(
        "anthropic", "some-model", input_tokens=100, output_tokens=50, cost_usd=0.01
    )
    obs_metrics.record_correction_lifecycle("approve")


# =============================================================================
# SHIM: absent path (flag forced off -- exercised even when the extra IS
# installed, so the no-op path is covered on every run)
# =============================================================================


class TestShimAbsentPath:
    def test_record_functions_are_noops_without_prometheus(self, monkeypatch):
        monkeypatch.setattr(obs_metrics, "PROMETHEUS_AVAILABLE", False)
        _record_everything()  # must not raise

    def test_render_returns_empty_bytes_without_prometheus(self, monkeypatch):
        monkeypatch.setattr(obs_metrics, "PROMETHEUS_AVAILABLE", False)
        assert obs_metrics.render_prometheus() == b""

    def test_noop_instrument_supports_full_chain(self):
        noop = obs_metrics._NoopInstrument()
        assert noop.labels(outcome="x") is noop
        noop.inc()
        noop.inc(5)
        noop.observe(1.5)

    def test_module_imports_cleanly_and_exposes_flag(self):
        assert isinstance(obs_metrics.PROMETHEUS_AVAILABLE, bool)
        assert "text/plain" in obs_metrics.PROMETHEUS_CONTENT_TYPE


# =============================================================================
# PRESENT PATH (only when prometheus_client is importable)
# =============================================================================


class TestPresentPath:
    def test_recorded_values_appear_in_exposition(self):
        pytest.importorskip("prometheus_client")
        assert obs_metrics.PROMETHEUS_AVAILABLE is True
        _record_everything()
        payload = obs_metrics.render_prometheus().decode("utf-8")
        assert "deliberations_total" in payload
        assert "deliberation_duration_seconds" in payload
        assert "phase_duration_seconds" in payload
        assert "llm_calls_total" in payload
        assert "llm_tokens_total" in payload
        assert "llm_cost_dollars_total" in payload
        assert "corrections_lifecycle_total" in payload

    def test_no_unbounded_labels_in_exposition(self):
        pytest.importorskip("prometheus_client")
        _record_everything()
        payload = obs_metrics.render_prometheus().decode("utf-8")
        for banned in ("tenant_id=", "user_id=", "session_id=", "correlation_id="):
            assert banned not in payload


# =============================================================================
# FACTORY: LLM_PROVIDER=mock
# =============================================================================


class TestMockProviderBranch:
    def test_env_var_selects_mock_client(self, monkeypatch):
        monkeypatch.setenv("LLM_PROVIDER", "mock")
        client = create_client()
        assert isinstance(client, MockLLMClient)
        assert client.provider == "mock"

    def test_explicit_mock_provider(self, monkeypatch):
        monkeypatch.delenv("LLM_PROVIDER", raising=False)
        client = create_client(provider="mock")
        assert isinstance(client, MockLLMClient)


