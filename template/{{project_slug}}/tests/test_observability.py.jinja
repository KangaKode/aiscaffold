# ROUTE: GET /metrics/prometheus (auth + 501 + 200)
# =============================================================================

from fastapi import FastAPI
from fastapi.testclient import TestClient

from {{project_slug}}.api.routes import health


def _make_app() -> FastAPI:
    app = FastAPI()
    app.include_router(health.router)
    return app


class TestPrometheusRoute:
    def test_missing_bearer_returns_401(self, monkeypatch):
        monkeypatch.setenv("API_KEY", "route-test-key")
        client = TestClient(_make_app())
        response = client.get("/metrics/prometheus")
        assert response.status_code == 401

    def test_wrong_bearer_returns_403(self, monkeypatch):
        monkeypatch.setenv("API_KEY", "route-test-key")
        client = TestClient(_make_app())
        response = client.get(
            "/metrics/prometheus",
            headers={"Authorization": "Bearer wrong-key"},
        )
        assert response.status_code == 403

    def test_returns_501_with_hint_when_prometheus_absent(self, monkeypatch):
        monkeypatch.delenv("API_KEY", raising=False)
        monkeypatch.setattr(obs_metrics, "PROMETHEUS_AVAILABLE", False)
        client = TestClient(_make_app())
        response = client.get("/metrics/prometheus")
        assert response.status_code == 501
        assert "[metrics]" in response.json()["detail"]

    def test_returns_exposition_when_prometheus_present(self, monkeypatch):
        pytest.importorskip("prometheus_client")
        monkeypatch.delenv("API_KEY", raising=False)
        obs_metrics.record_deliberation("completed", 1.0)
        client = TestClient(_make_app())
        response = client.get("/metrics/prometheus")
        assert response.status_code == 200
        assert "deliberations_total" in response.text

    def test_existing_json_metrics_contract_untouched(self, monkeypatch):
        """GET /metrics keeps its JSON shape regardless of the extra."""
        monkeypatch.delenv("API_KEY", raising=False)
        app = _make_app()

        class _Registry:
            count = 0

            def get_all_entries(self):
                return []

        app.state.registry = _Registry()
        app.state.metrics = {
            "tasks_completed": 0,
            "tasks_failed": 0,
            "total_duration": 0.0,
            "total_agent_calls": 0,
        }
        response = TestClient(app).get("/metrics")
        assert response.status_code == 200
        body = response.json()
        for key in (
            "tasks_completed",
            "tasks_failed",
            "average_duration_seconds",
            "agents_registered",
            "total_agent_calls",
        ):
            assert key in body
