# --- Event-loop responsiveness under store I/O ---------------------------------


class TestEventLoopResponsiveness:
    @pytest.fixture
    async def api(self, tmp_path, monkeypatch):
        """Gateway with activity tracking ON so every request writes."""
        from httpx import ASGITransport, AsyncClient

        from {{project_slug}}.agents.registry import AgentRegistry
        from {{project_slug}}.api.gateway import create_app

        monkeypatch.delenv("API_KEY", raising=False)
        monkeypatch.delenv("ENV", raising=False)
        monkeypatch.setenv("ACTIVITY_TRACKING_ENABLED", "true")
        monkeypatch.chdir(tmp_path)

        app = create_app(registry=AgentRegistry(persist_path=tmp_path / "agents.json"))
        transport = ASGITransport(app=app)
        async with AsyncClient(transport=transport, base_url="http://test") as client:
            yield client, app

    @pytest.mark.asyncio
    async def test_timer_ticks_while_store_writes_run(self, api, monkeypatch):
        """Load smoke: fire concurrent requests at a store-touching path
        (the activity middleware writes one row per request) with an
        artificially slow store, and assert a concurrent timer task
        still completes on time. Pre-fix the middleware ran the SQLite
        write on the event loop, so ten 0.1s writes serialized the loop
        for ~1s and the timer could not tick."""
        import asyncio
        import time

        client, app = api
        store = app.state.learning_store
        real_insert = store.insert

        def slow_insert(table, row):
            time.sleep(0.1)  # simulated slow disk; must run OFF the loop
            return real_insert(table, row)

        monkeypatch.setattr(store, "insert", slow_insert)

        loop = asyncio.get_running_loop()
        timer_elapsed = 0.0

        async def timer():
            nonlocal timer_elapsed
            started = loop.time()
            for _ in range(5):
                await asyncio.sleep(0.05)
            timer_elapsed = loop.time() - started

        timer_task = asyncio.create_task(timer())
        responses = await asyncio.gather(
            *(client.get("/health") for _ in range(10))
        )
        await timer_task

        assert all(r.status_code == 200 for r in responses)
        # Expected ~0.25s; anything close to the 1s serialized-write
        # total means the loop was blocked by store I/O.
        assert timer_elapsed < 0.7, (
            f"event loop was blocked: 5x50ms timer took {timer_elapsed:.2f}s"
        )

    @pytest.mark.asyncio
    async def test_lost_lifecycle_race_maps_to_409(self, api, monkeypatch):
        """A transition that loses the race surfaces as 409 Conflict."""
        from {{project_slug}}.learning.corrections import STATUS_PROPOSED

        client, app = api
        manager = app.state.corrections_manager
        correction = propose(manager, created_by="alice")

        real_get = manager.get

        def stale_snapshot_while_concurrently_rejected(cid):
            # Simulate a stale read: the returned snapshot still shows
            # PROPOSED while the database has already moved to REJECTED.
            result = real_get(cid)
            manager.store.update("corrections", cid, {"status": STATUS_REJECTED})
            if result is not None:
                result.status = STATUS_PROPOSED
            return result

        monkeypatch.setattr(
            manager, "get", stale_snapshot_while_concurrently_rejected
        )
        r = await client.post(f"/api/v1/corrections/{correction.id}/approve")
        assert r.status_code == 409
        assert "concurrent" in r.json()["detail"]
