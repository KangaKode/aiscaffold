"""Async-hardening regression tests: connect-time DNS re-validation
(anti-rebinding) for remote agents, MCP client URL validation off the
event loop, and event-loop responsiveness while store I/O runs in
worker threads."""

import socket

import pytest

from {{project_slug}}.learning.corrections import STATUS_REJECTED


def propose(mgr, original="limit is 100", corrected="limit is 60",
            created_by="alice"):
    return mgr.propose(agent_id="analyst", original_claim=original,
                       corrected_claim=corrected, reason="",
                       evidence_level="documented", created_by=created_by)


# --- Connect-time DNS re-validation (anti-rebinding) ---------------------------


def _private_resolver(monkeypatch):
    """Every DNS lookup resolves to a private address (simulated rebind)."""

    def rebound(host, port, *args, **kwargs):
        return [(socket.AF_INET, socket.SOCK_STREAM, 6, "", ("10.0.0.1", 0))]

    monkeypatch.setattr(socket, "getaddrinfo", rebound)


def _mock_remote_http(monkeypatch, hits):
    """Replace httpx.AsyncClient so no real network is touched."""
    import httpx

    def handler(request):
        hits.append(str(request.url))
        return httpx.Response(200, json={
            "observations": [], "recommendations": [], "confidence": 0.5,
        })

    real_client = httpx.AsyncClient

    def client_with_mock_transport(**kwargs):
        return real_client(transport=httpx.MockTransport(handler), **kwargs)

    monkeypatch.setattr(httpx, "AsyncClient", client_with_mock_transport)


class TestConnectTimeDnsRevalidation:
    @pytest.mark.asyncio
    async def test_rebound_hostname_refused_before_request(
        self, monkeypatch, sample_task
    ):
        """Regression: a hostname validated as public at registration but
        rebound to a private IP afterwards was still contacted. The
        connect-time re-check must refuse it before any bytes leave."""
        from {{project_slug}}.agents.remote import RemoteAgent

        hits = []
        _mock_remote_http(monkeypatch, hits)
        _private_resolver(monkeypatch)

        agent = RemoteAgent(
            name="rebound", domain="t", base_url="http://rebind.example.com"
        )
        with pytest.raises(ConnectionError, match="private|rebind"):
            await agent.analyze(sample_task)
        assert hits == []  # refused before the transport was touched

    @pytest.mark.asyncio
    async def test_localhost_dev_agent_still_connects(
        self, monkeypatch, sample_task
    ):
        """localhost cannot rebind; directly constructed dev agents that
        point at it keep working (admission policy is decided at
        registration, not re-litigated per request)."""
        from {{project_slug}}.agents.remote import RemoteAgent

        hits = []
        _mock_remote_http(monkeypatch, hits)

        agent = RemoteAgent(
            name="dev", domain="t", base_url="http://localhost:3000"
        )
        analysis = await agent.analyze(sample_task)
        assert analysis.agent_name == "dev"
        assert len(hits) == 1

    @pytest.mark.asyncio
    async def test_health_check_also_rechecks(self, monkeypatch):
        from {{project_slug}}.agents.remote import RemoteAgent

        hits = []
        _mock_remote_http(monkeypatch, hits)
        _private_resolver(monkeypatch)

        agent = RemoteAgent(
            name="rebound", domain="t", base_url="http://rebind.example.com"
        )
        assert await agent.health_check() is False
        assert hits == []

    @pytest.mark.asyncio
    async def test_allow_private_endpoint_opts_out_of_recheck(
        self, monkeypatch, sample_task
    ):
        """Regression: directly constructed agents pointing at private
        hostnames on purpose (docker-compose service names, corp-internal
        DNS) worked before the connect-time re-check and were broken by
        it. allow_private_endpoint=True restores them."""
        from {{project_slug}}.agents.remote import RemoteAgent

        hits = []
        _mock_remote_http(monkeypatch, hits)
        _private_resolver(monkeypatch)

        agent = RemoteAgent(
            name="internal", domain="t", base_url="http://backend-svc:9000",
            allow_private_endpoint=True,
        )
        analysis = await agent.analyze(sample_task)
        assert analysis.agent_name == "internal"
        assert len(hits) == 1

        # The default is still locked down.
        locked = RemoteAgent(
            name="default", domain="t", base_url="http://backend-svc:9000"
        )
        with pytest.raises(ConnectionError, match="private|rebind"):
            await locked.analyze(sample_task)

    @pytest.mark.asyncio
    async def test_resolver_error_fails_closed_at_connect_time(
        self, monkeypatch, sample_task
    ):
        """Regression: a resolver error at re-check time returned 'not
        private' and passed the guard (fail open). The connect-time path
        must refuse when it cannot verify the destination."""
        from {{project_slug}}.agents.remote import RemoteAgent

        hits = []
        _mock_remote_http(monkeypatch, hits)

        def resolver_down(host, port, *args, **kwargs):
            raise socket.gaierror("resolver unavailable")

        monkeypatch.setattr(socket, "getaddrinfo", resolver_down)
        agent = RemoteAgent(
            name="dark", domain="t", base_url="http://agent.example.com"
        )
        with pytest.raises(ConnectionError, match="re-resolved"):
            await agent.analyze(sample_task)
        assert hits == []

    @pytest.mark.asyncio
    async def test_dns_recheck_runs_before_every_retry_attempt(
        self, monkeypatch, sample_task
    ):
        """Regression: the re-check ran once before the retry loop; with
        retries and 120s timeouts the last attempt could fire minutes
        later, unguarded. Every attempt must re-check."""
        import httpx

        from {{project_slug}}.agents import remote as remote_module
        from {{project_slug}}.agents.remote import MAX_RETRIES, RemoteAgent

        recheck_urls = []
        monkeypatch.setattr(
            remote_module, "revalidate_url_at_connect",
            lambda url, field_name: recheck_urls.append(url),
        )

        def always_times_out(request):
            raise httpx.TimeoutException("slow")

        real_client = httpx.AsyncClient
        monkeypatch.setattr(
            httpx, "AsyncClient",
            lambda **kw: real_client(
                transport=httpx.MockTransport(always_times_out), **kw
            ),
        )

        agent = RemoteAgent(
            name="slow", domain="t", base_url="http://agent.example.com"
        )
        with pytest.raises(ConnectionError, match="failed on"):
            await agent.analyze(sample_task)
        assert len(recheck_urls) == MAX_RETRIES + 1  # once per attempt

    @pytest.mark.asyncio
    async def test_recheck_failure_mid_retry_preserves_prior_error(
        self, monkeypatch, sample_task
    ):
        """A re-check failure aborts the remaining retries (deliberate:
        fail closed), but the error that triggered the retry must not be
        dropped from the raised message."""
        import httpx

        from {{project_slug}}.agents import remote as remote_module
        from {{project_slug}}.agents.remote import RemoteAgent
        from {{project_slug}}.security.validators import ValidationError

        recheck_count = 0

        def flaky_recheck(url, field_name):
            nonlocal recheck_count
            recheck_count += 1
            if recheck_count > 1:
                raise ValidationError("hostname re-resolution failed")

        monkeypatch.setattr(
            remote_module, "revalidate_url_at_connect", flaky_recheck
        )

        def always_times_out(request):
            raise httpx.TimeoutException("upstream stalled")

        real_client = httpx.AsyncClient
        monkeypatch.setattr(
            httpx, "AsyncClient",
            lambda **kw: real_client(
                transport=httpx.MockTransport(always_times_out), **kw
            ),
        )

        agent = RemoteAgent(
            name="flaky", domain="t", base_url="http://agent.example.com"
        )
        with pytest.raises(
            ConnectionError, match="previous attempt failed with"
        ) as exc_info:
            await agent.analyze(sample_task)
        assert "upstream stalled" in str(exc_info.value)


# --- MCP client: URL validation off the event loop -----------------------------


class TestMcpClientLoopResponsiveness:
    @pytest.mark.asyncio
    async def test_url_validation_runs_off_the_loop(self, monkeypatch):
        """Regression: call_tool validated the server URL inline, running
        blocking getaddrinfo DNS resolution on the event loop. Ten
        concurrent calls against a slow resolver serialized the loop for
        ~1s; a concurrent timer task must still tick on time."""
        import asyncio
        import time

        from {{project_slug}}.connectors import mcp_client as mcp_module
        from {{project_slug}}.connectors.mcp_client import MCPClient, MCPToolInfo

        def slow_validate(url, field_name="url"):
            time.sleep(0.1)  # simulated slow DNS; must run OFF the loop
            return url

        monkeypatch.setattr(mcp_module, "validate_url", slow_validate)

        class StubTransport:
            async def call_tool(
                self, server_url, tool_name, arguments, headers, timeout
            ):
                return "ok"

            async def list_tools(self, server_url, headers, timeout):
                return [MCPToolInfo(name="t", description="")]

        client = MCPClient(transport=StubTransport())
        loop = asyncio.get_running_loop()
        timer_elapsed = 0.0

        async def timer():
            nonlocal timer_elapsed
            started = loop.time()
            for _ in range(5):
                await asyncio.sleep(0.05)
            timer_elapsed = loop.time() - started

        timer_task = asyncio.create_task(timer())
        results = await asyncio.gather(*(
            client.call_tool(
                "http://mcp.example.com", "tool", {}, tenant_id="acme"
            )
            for _ in range(10)
        ))
        await timer_task

        assert all(not r.is_error for r in results)
        assert timer_elapsed < 0.7, (
            f"event loop was blocked: 5x50ms timer took {timer_elapsed:.2f}s"
        )


