@pytest.mark.asyncio
async def test_invoke_disabled_404_byte_identical(enforce_api, monkeypatch):
    monkeypatch.delenv(ENFORCEMENT_ENV, raising=False)
    client, app = enforce_api
    transport = StubTransport()
    app.state.mcp_client = MCPClient(transport=transport)
    app.state.mcp_registry.register(make_config(enabled=False))
    missing = await client.post(
        "/api/v1/mcp/servers/nope/invoke",
        json={"tool_name": "get_ticket", "arguments": {}},
    )
    disabled = await client.post(
        "/api/v1/mcp/servers/tickets/invoke",
        json={"tool_name": "get_ticket", "arguments": {}},
    )
    assert missing.status_code == 404
    assert disabled.status_code == 404
    assert missing.json()["detail"] == "MCP server 'nope' not found"
    assert disabled.json()["detail"] == NOT_FOUND
    assert transport.call_count == 0


