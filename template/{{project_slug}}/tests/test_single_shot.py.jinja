"""Tests for Tier 1 resolution: the mock LLM client, the model router
(tier selection, cascade, circuit breaker, budget downgrade), and
single-shot resolution with its mandatory enforcement + confidence gate."""

import pytest

from {{project_slug}}.llm.mock import MockLLMClient
from {{project_slug}}.llm.model_router import ModelRouter
from {{project_slug}}.orchestration.single_shot import resolve_single_shot


# --- Mock LLM client ---------------------------------------------------------


class TestMockLLMClient:
    @pytest.mark.asyncio
    async def test_scripted_responses_returned_in_order(self):
        client = MockLLMClient(script=["first", "second"])
        assert (await client.call("q", role="x")).content == "first"
        assert (await client.call("q", role="x")).content == "second"
        # Last entry repeats once exhausted.
        assert (await client.call("q", role="x")).content == "second"

    @pytest.mark.asyncio
    async def test_fixed_response_for_every_call(self):
        client = MockLLMClient(response="always this")
        assert (await client.call("a")).content == "always this"
        assert (await client.call("b", role="vote")).content == "always this"

    @pytest.mark.asyncio
    async def test_role_keyed_defaults_are_enforcement_clean(self):
        from {{project_slug}}.enforcement.fact_checker import FactChecker

        client = MockLLMClient()
        response = await client.call("q", role="chat_synthesis")
        # The canned chat answer must pass FactChecker (no speculation, etc.).
        assert FactChecker().check(response.content).outcome != "rejected"

    @pytest.mark.asyncio
    async def test_provider_and_usage_are_deterministic(self):
        client = MockLLMClient()
        await client.call("q")
        assert client.provider == "mock"
        assert client.model == "mock-llm"
        assert client.total_usage.estimated_cost_usd == 0.0
        assert client.call_count == 1


# --- Model router ------------------------------------------------------------


class TestModelRouter:
    def test_vote_role_routes_to_nano(self):
        decision = ModelRouter().route("skeptic_vote")
        assert decision.tier == "nano"
        assert decision.method == "heuristic"

    def test_analysis_role_routes_to_standard(self):
        assert ModelRouter().route("skeptic_analysis").tier == "standard"

    def test_sentinel_analysis_routes_to_frontier(self):
        assert ModelRouter().route("sentinel_analysis").tier == "frontier"

    def test_short_prompt_routes_to_nano(self):
        assert ModelRouter().route("unknown_role", prompt="hi").tier == "nano"

    def test_override_wins(self):
        decision = ModelRouter().route("skeptic_vote", model_override="my-model")
        assert decision.model == "my-model"
        assert decision.method == "override"

    def test_cascade_moves_up_a_tier(self):
        router = ModelRouter()
        decision = router.route("single_shot_resolution")  # nano
        cascaded = router.cascade("single_shot_resolution", decision.model)
        assert cascaded is not None
        assert cascaded.method == "cascade"
        assert cascaded.tier == "budget"

    def test_cascade_at_top_tier_returns_none(self):
        router = ModelRouter()
        top = router.route("sentinel_analysis")  # frontier
        assert router.cascade("sentinel_analysis", top.model) is None

    def test_circuit_breaker_skips_failing_tier(self):
        router = ModelRouter()
        nano_model = router.route("single_shot_resolution").model
        # Trip the breaker for the nano tier.
        for _ in range(5):
            router.cascade("single_shot_resolution", nano_model)
        decision = router.route("single_shot_resolution")
        assert decision.tier != "nano"

    def test_budget_downgrade_for_unmatched_role(self):
        class LowBudget:
            def remaining_pct(self, tenant_id):
                return 0.05

        router = ModelRouter(budget_manager=LowBudget())
        # Long unknown-role prompt -> would be standard; budget drags it down.
        decision = router.route("unknown_role", prompt="x" * 5000, tenant_id="t")
        assert decision.tier == "budget"

    def test_matched_role_not_downgraded_by_budget(self):
        class LowBudget:
            def remaining_pct(self, tenant_id):
                return 0.01

        router = ModelRouter(budget_manager=LowBudget())
        # sentinel_analysis is a deliberate frontier match -- never downgraded.
        assert router.route("sentinel_analysis", tenant_id="t").tier == "frontier"


# --- Single-shot resolution --------------------------------------------------


APPROVED_CONTEXT = (
    "## Approved corrections\n"
    "- Instead of: rate limit is 100/min\n  Use: rate limit is 60/min\n"
)

GOOD_ANSWER = (
    "The API rate limit is 60 requests per minute. "
    "[VERIFIED: corrections] This reflects the approved correction."
)


class _StubManager:
    def __init__(self, context):
        self._context = context

    def get_approved_for_context(self, tenant_id="default", agent_id=""):
        return self._context


class TestSingleShot:
    @pytest.mark.asyncio
    async def test_escalates_without_llm(self):
        result = await resolve_single_shot("q", llm=None)
        assert result.escalated is True

    @pytest.mark.asyncio
    async def test_escalates_without_corrections(self):
        result = await resolve_single_shot(
            "q", llm=MockLLMClient(response=GOOD_ANSWER), corrections_manager=None
        )
        assert result.escalated is True
        assert "corrections" in result.escalation_reason.lower()

    @pytest.mark.asyncio
    async def test_resolves_with_clean_cited_answer(self):
        result = await resolve_single_shot(
            "What is the rate limit?",
            llm=MockLLMClient(response=GOOD_ANSWER),
            corrections_manager=_StubManager(APPROVED_CONTEXT),
        )
        assert result.escalated is False
        assert result.content == GOOD_ANSWER
        assert result.evidence_level == "VERIFIED"
        assert result.citations_count >= 1

    @pytest.mark.asyncio
    async def test_escalates_when_no_citations(self):
        result = await resolve_single_shot(
            "q",
            llm=MockLLMClient(response="The rate limit is 60 per minute."),
            corrections_manager=_StubManager(APPROVED_CONTEXT),
        )
        assert result.escalated is True
        assert "no_citations" in result.escalation_reason

    @pytest.mark.asyncio
    async def test_escalates_on_insufficient_evidence(self):
        result = await resolve_single_shot(
            "q",
            llm=MockLLMClient(response="[INSUFFICIENT] Not enough data to answer."),
            corrections_manager=_StubManager(APPROVED_CONTEXT),
        )
        assert result.escalated is True
        assert "insufficient_evidence" in result.escalation_reason

    @pytest.mark.asyncio
    async def test_escalates_when_enforcement_rejects(self):
        speculative = (
            "This probably indicates the limit is 60. I think it likely "
            "indicates a change. In my opinion this suggests an update. "
            "[VERIFIED: corrections]"
        )
        result = await resolve_single_shot(
            "q",
            llm=MockLLMClient(response=speculative),
            corrections_manager=_StubManager(APPROVED_CONTEXT),
        )
        assert result.escalated is True
        assert "enforcement_rejected" in result.escalation_reason


