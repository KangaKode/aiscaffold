# --- Resolve API -------------------------------------------------------------


class TestResolveAPI:
    @pytest.fixture
    async def api(self, tmp_path, monkeypatch):
        from httpx import ASGITransport, AsyncClient

        from {{project_slug}}.agents.registry import AgentRegistry
        from {{project_slug}}.api.gateway import create_app

        monkeypatch.delenv("API_KEY", raising=False)
        monkeypatch.delenv("ENV", raising=False)
        monkeypatch.setenv("ACTIVITY_TRACKING_ENABLED", "false")
        monkeypatch.chdir(tmp_path)

        app = create_app(registry=AgentRegistry(persist_path=tmp_path / "agents.json"))
        # Force a deterministic offline LLM so no provider key is needed.
        app.state.llm_client = MockLLMClient(response=GOOD_ANSWER)
        transport = ASGITransport(app=app)
        async with AsyncClient(transport=transport, base_url="http://test") as client:
            yield client, app

    async def test_resolve_escalates_when_no_corrections(self, api):
        client, _ = api
        r = await client.post("/api/v1/resolve", json={"query": "What is the limit?"})
        assert r.status_code == 200
        assert r.json()["escalated"] is True

    async def test_resolve_returns_answer_with_corrections(self, api):
        client, app = api
        mgr = app.state.corrections_manager
        c = mgr.propose(
            agent_id="analyst",
            original_claim="rate limit is 100/min",
            corrected_claim="rate limit is 60/min",
            reason="vendor docs",
            evidence_level="documented",
            created_by="alice",
        )
        mgr.approve(c.id, approved_by="bob")

        r = await client.post("/api/v1/resolve", json={"query": "What is the limit?"})
        assert r.status_code == 200
        body = r.json()
        assert body["escalated"] is False
        assert body["evidence_level"] == "VERIFIED"

    async def test_resolve_validates_empty_query(self, api):
        client, _ = api
        r = await client.post("/api/v1/resolve", json={"query": ""})
        assert r.status_code == 400
