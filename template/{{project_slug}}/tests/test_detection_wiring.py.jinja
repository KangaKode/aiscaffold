class TestTogglesOffRegression:
    def test_factories_return_none_by_default(self, store):
        assert create_baseline_tracker(store) is None
        assert create_collusion_detector(store) is None

    @pytest.mark.asyncio
    async def test_dispatch_writes_no_stats_rows(self, mock_agents, sample_task, store):
        analyses, skipped, failed = await dispatch_with_gates(
            mock_agents, sample_task, None, None, "Test"
        )
        assert len(analyses) == 2 and failed == 0
        assert store.query("agent_dispatch_stats", {}) == []

    @pytest.mark.asyncio
    async def test_round_table_hooks_default_to_none(self, mock_agents):
        rt = RoundTable(
            agents=mock_agents,
            config=RoundTableConfig(
                enable_strategy_phase=False,
                enable_challenge_phase=False,
                include_core_agents=False,
            ),
        )
        assert rt._baseline_tracker is None
        assert rt._collusion_detector is None
        result = await rt.run(RoundTableTask(id="off", content="test"))
        assert result.task_id == "off"

    @pytest.mark.asyncio
    async def test_llm_call_uses_configured_model_without_router(self):
        client = _mk_client()
        assert client.model_router is None  # default: no router attached
        calls: list = []
        _capture_provider(client, calls)
        response = await client.call("hello", role="premise_validation")
        assert response.is_error is False
        assert calls == [client._model]


