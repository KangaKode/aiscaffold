def _canary_flags(store):
    return store.query("integrity_flags", {"flag_type": "startup_canary_failed"})


class TestStartupCanaryWiring:
    def test_off_by_default_returns_none_and_no_flag(self, store):
        from {{project_slug}}.api.detection_hooks import run_startup_canary_check

        assert run_startup_canary_check(store) is None
        assert _canary_flags(store) == []

    def test_healthy_machinery_passes_without_flag(self, store, monkeypatch):
        from {{project_slug}}.api.detection_hooks import run_startup_canary_check

        monkeypatch.setenv("STARTUP_CANARY_ENABLED", "true")
        assert run_startup_canary_check(store) is True
        assert _canary_flags(store) == []

    def test_induced_failure_records_error_flag(self, store, monkeypatch):
        from {{project_slug}}.api import detection_hooks

        monkeypatch.setenv("STARTUP_CANARY_ENABLED", "true")
        # Simulate broken detection machinery: leaks are never detected.
        monkeypatch.setattr(detection_hooks, "check_canary", lambda *a: False)
        assert detection_hooks.run_startup_canary_check(store) is False
        flags = _canary_flags(store)
        assert len(flags) == 1
        assert flags[0]["severity"] == "error"
        assert "leak_not_detected" in flags[0]["detail_json"]

    def test_crashing_self_check_never_raises(self, store, monkeypatch):
        from {{project_slug}}.api import detection_hooks

        monkeypatch.setenv("STARTUP_CANARY_ENABLED", "true")

        def boom(*args, **kwargs):
            raise RuntimeError("canary machinery broken")

        monkeypatch.setattr(detection_hooks, "wrap_user_content", boom)
        assert detection_hooks.run_startup_canary_check(store) is False
        assert len(_canary_flags(store)) == 1

    def test_no_store_logs_only(self, monkeypatch):
        from {{project_slug}}.api import detection_hooks

        monkeypatch.setenv("STARTUP_CANARY_ENABLED", "true")
        monkeypatch.setattr(detection_hooks, "check_canary", lambda *a: False)
        assert detection_hooks.run_startup_canary_check(None) is False  # no crash


