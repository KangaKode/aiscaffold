class TestBaselineTrackingWiring:
    @pytest.fixture
    def tracker(self, store, monkeypatch):
        monkeypatch.setenv("BASELINE_TRACKING_ENABLED", "true")
        tracker = create_baseline_tracker(store)
        assert tracker is not None
        return tracker

    @pytest.mark.asyncio
    async def test_dispatch_records_stats_under_callers_tenant(
        self, mock_agents, tracker, store
    ):
        task = RoundTableTask(id="t1", content="analyze", tenant_id="acme")
        analyses, _, failed = await dispatch_with_gates(
            mock_agents, task, None, None, "Test", baseline_tracker=tracker
        )
        assert len(analyses) == 2 and failed == 0
        rows = store.query("agent_dispatch_stats", {"tenant_id": "acme"})
        assert {r["agent_id"] for r in rows} == {"analyst_a", "analyst_b"}
        for row in rows:
            assert row["refused"] == 0
            assert row["confidence"] == pytest.approx(0.7)
            assert row["duration_seconds"] >= 0.0

    @pytest.mark.asyncio
    async def test_refusal_derived_from_premise_valid(self, tracker, store):
        task = RoundTableTask(id="t2", content="analyze", tenant_id="acme")
        await dispatch_with_gates(
            [RefusingAgent()], task, None, None, "Test", baseline_tracker=tracker
        )
        rows = store.query("agent_dispatch_stats", {"agent_id": "refuser"})
        assert len(rows) == 1 and rows[0]["refused"] == 1

    @pytest.mark.asyncio
    async def test_round_table_threads_tracker_into_dispatch(
        self, mock_agents, tracker, store
    ):
        """Genuine wiring regression: pre-wiring, RoundTable had no way to
        pass a tracker into dispatch, so no stats row could ever appear."""
        rt = RoundTable(
            agents=mock_agents,
            config=RoundTableConfig(
                enable_strategy_phase=False,
                enable_challenge_phase=False,
                include_core_agents=False,
            ),
            baseline_tracker=tracker,
        )
        await rt.run(RoundTableTask(id="t3", content="analyze", tenant_id="acme"))
        rows = store.query("agent_dispatch_stats", {"tenant_id": "acme"})
        assert {r["agent_id"] for r in rows} == {"analyst_a", "analyst_b"}

    @pytest.mark.asyncio
    async def test_broken_tracker_never_fails_dispatch(self, mock_agents, sample_task):
        class ExplodingTracker:
            def record_dispatch(self, **kwargs):
                raise RuntimeError("db down")

        analyses, _, failed = await dispatch_with_gates(
            mock_agents, sample_task, None, None, "Test",
            baseline_tracker=ExplodingTracker(),
        )
        assert len(analyses) == 2 and failed == 0


