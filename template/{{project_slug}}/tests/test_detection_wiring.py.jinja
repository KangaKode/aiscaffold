class TestCollusionWiring:
    @pytest.fixture
    def detector(self, store, monkeypatch):
        monkeypatch.setenv("COLLUSION_DETECTION_ENABLED", "true")
        detector = create_collusion_detector(store)
        assert detector is not None
        return detector

    @pytest.mark.asyncio
    async def test_round_table_feeds_votes_to_detector(self, mock_agents, detector):
        """Genuine wiring regression: pre-wiring, no deliberation ever
        reached the detector, so its history stayed empty forever."""
        rt = RoundTable(
            agents=mock_agents,
            config=RoundTableConfig(
                enable_strategy_phase=False,
                enable_challenge_phase=False,
                include_core_agents=False,
            ),
            collusion_detector=detector,
        )
        await rt.run(RoundTableTask(id="v1", content="vote on this"))
        history = detector._vote_history["default"]
        assert len(history) == 1
        assert {name for name, _ in history[0]} == {"analyst_a", "analyst_b"}

    @pytest.mark.asyncio
    async def test_lockstep_flagged_under_callers_tenant(self, detector, store):
        task = RoundTableTask(id="v2", content="vote", tenant_id="acme")
        votes = [
            AgentVote(agent_name="analyst_a", approve=True),
            AgentVote(agent_name="analyst_b", approve=True),
        ]
        for _ in range(5):  # analyze_votes needs >= 5 shared rounds
            await record_collusion_votes(detector, task, votes)
        flags = store.query(
            "integrity_flags", {"flag_type": "collusion_suspected", "tenant_id": "acme"}
        )
        assert len(flags) == 1
        assert set(flags[0]["subject_id"].split(",")) == {"analyst_a", "analyst_b"}

    @pytest.mark.asyncio
    async def test_broken_detector_never_fails_deliberation(self, sample_task):
        class ExplodingDetector:
            def record_votes(self, *args, **kwargs):
                raise RuntimeError("db down")

        votes = [
            AgentVote(agent_name="a", approve=True),
            AgentVote(agent_name="b", approve=True),
        ]
        # Must not raise -- recording is fire-and-forget.
        await record_collusion_votes(ExplodingDetector(), sample_task, votes)


