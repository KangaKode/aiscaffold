def _mk_client() -> LLMClient:
    """LLM client with a fake SDK handle (same pattern as test_llm)."""
    client = LLMClient(provider="anthropic", api_key="test-key", max_retries=0)
    client._client = MagicMock()
    return client


def _capture_provider(client: LLMClient, calls: list):
    """Replace _call_provider with a stub that records the routed model."""

    async def fake_provider(prompt, temp, max_tok, model=None):
        calls.append(model)
        return LLMResponse(
            content="ok",
            usage=TokenUsage(input_tokens=1, output_tokens=1),
            provider="test",
            model=model or "unset",
        )

    client._call_provider = fake_provider


class RefusingAgent:
    """Mock agent whose analysis signals a refused premise."""

    name = "refuser"
    domain = "testing"

    async def analyze(self, task):
        return AgentAnalysis(
            agent_name=self.name,
            domain=self.domain,
            confidence=0.9,
            premise_valid=False,
            refusal_reason="flawed premise",
        )


