def _insert_extraction_events(store, user_id="u1", tenant_id="default"):
    """Synthetic credential_churn_burst: POST /credentials then POST /chat
    within the pattern's 120s window (timestamps strictly increasing)."""
    now = datetime.now()
    for i, (route, ts) in enumerate(
        [
            ("/api/v1/credentials", now - timedelta(seconds=30)),
            ("/api/v1/chat", now),
        ]
    ):
        store.insert(
            "activity_events",
            {
                "id": f"evt{i}",
                "tenant_id": tenant_id,
                "user_id": user_id,
                "route": route,
                "method": "POST",
                "status_code": 200,
                "created_at": ts.isoformat(),
            },
        )


def _run_sampled_checks(store):
    """Invoke the middleware's sampled detection pass directly."""
    from {{project_slug}}.api.middleware.activity import ActivityTrackingMiddleware
    from {{project_slug}}.learning.activity import ActivityTracker

    request = SimpleNamespace(
        app=SimpleNamespace(state=SimpleNamespace(learning_store=store))
    )
    ActivityTrackingMiddleware._run_checks(
        request, ActivityTracker(store), "u1", "default"
    )


def _sequence_flags(store):
    return store.query("integrity_flags", {"flag_type": "extraction_sequence"})


class TestSequenceDetectionWiring:
    def test_sampled_pass_flags_extraction_pattern_when_enabled(
        self, store, monkeypatch
    ):
        """Genuine wiring regression: pre-wiring, the sampled pass never
        invoked the sequence detector, so this flag could not exist."""
        monkeypatch.setenv("SEQUENCE_DETECTION_ENABLED", "true")
        _insert_extraction_events(store)
        _run_sampled_checks(store)
        flags = _sequence_flags(store)
        assert len(flags) == 1
        # Dedup key includes the pattern so distinct playbooks flag
        # separately while repeats of the same one bump a hit counter.
        assert flags[0]["subject_id"] == "u1:credential_churn_burst"
        assert "credential_churn_burst" in flags[0]["detail_json"]

    def test_sampled_pass_skips_scan_by_default(self, store):
        _insert_extraction_events(store)
        _run_sampled_checks(store)
        assert _sequence_flags(store) == []

    def test_broken_store_never_fails_the_scan(self, store, monkeypatch):
        """The detector swallows a failing activity query (fire-and-forget)."""
        monkeypatch.setenv("SEQUENCE_DETECTION_ENABLED", "true")
        _insert_extraction_events(store)
        real_query = store.query

        def failing_query(table, *args, **kwargs):
            if table == "activity_events":
                raise RuntimeError("db down")
            return real_query(table, *args, **kwargs)

        monkeypatch.setattr(store, "query", failing_query)
        _run_sampled_checks(store)  # must not raise
        assert _sequence_flags(store) == []


class TestSequenceDetectionEventLoop:
    @pytest.fixture
    async def api(self, tmp_path, monkeypatch):
        """Gateway with tracking + sequence detection ON, sampling every
        request (mirrors test_async_hardening's responsiveness fixture)."""
        from httpx import ASGITransport, AsyncClient

        from {{project_slug}}.agents.registry import AgentRegistry
        from {{project_slug}}.api.gateway import create_app

        monkeypatch.delenv("API_KEY", raising=False)
        monkeypatch.delenv("ENV", raising=False)
        monkeypatch.setenv("ACTIVITY_TRACKING_ENABLED", "true")
        monkeypatch.setenv("ACTIVITY_CHECK_SAMPLE_N", "1")
        monkeypatch.setenv("SEQUENCE_DETECTION_ENABLED", "true")
        monkeypatch.chdir(tmp_path)

        app = create_app(registry=AgentRegistry(persist_path=tmp_path / "agents.json"))
        transport = ASGITransport(app=app)
        async with AsyncClient(transport=transport, base_url="http://test") as client:
            yield client, app

    @pytest.mark.asyncio
    async def test_timer_ticks_while_sequence_scans_run(self, api, monkeypatch):
        """The sequence scan reads the store on every sampled pass; with an
        artificially slow store a concurrent timer must still tick -- the
        scan runs off the event loop with the other sampled checks."""
        import time

        client, app = api
        store = app.state.learning_store
        real_query = store.query

        def slow_query(*args, **kwargs):
            time.sleep(0.1)  # simulated slow disk; must run OFF the loop
            return real_query(*args, **kwargs)

        monkeypatch.setattr(store, "query", slow_query)

        loop = asyncio.get_running_loop()
        timer_elapsed = 0.0

        async def timer():
            nonlocal timer_elapsed
            started = loop.time()
            for _ in range(5):
                await asyncio.sleep(0.05)
            timer_elapsed = loop.time() - started

        timer_task = asyncio.create_task(timer())
        responses = await asyncio.gather(*(client.get("/health") for _ in range(10)))
        await timer_task

        assert all(r.status_code == 200 for r in responses)
        assert timer_elapsed < 0.7, (
            f"event loop was blocked: 5x50ms timer took {timer_elapsed:.2f}s"
        )


