class TestModelRoutingWiring:
    @pytest.fixture(autouse=True)
    def _tier_map(self, monkeypatch):
        monkeypatch.setenv("MODEL_TIER_MAP_JSON", TIER_MAP_JSON)

    @pytest.mark.asyncio
    async def test_router_selects_tier_by_role(self):
        client = _mk_client()
        client.model_router = ModelRouter()
        calls: list = []
        _capture_provider(client, calls)
        response = await client.call("validate this", role="premise_validation")
        assert response.is_error is False
        assert calls == ["tier-nano"]  # premise_validation maps to nano

    @pytest.mark.asyncio
    async def test_budget_low_downgrades_one_tier(self):
        client = _mk_client()
        client.model_router = ModelRouter(
            budget_manager=SimpleNamespace(remaining_pct=lambda tenant_id: 0.05)
        )
        calls: list = []
        _capture_provider(client, calls)
        # Unmatched role + long prompt -> DEFAULT_TIER (standard), then the
        # near-exhausted budget downgrades one tier to budget.
        await client.call("x" * 3000, role="unmapped_role")
        assert calls == ["tier-budget"]

    @pytest.mark.asyncio
    async def test_cascade_one_step_up_after_final_failure(self):
        """Genuine wiring regression: pre-wiring, a final failure returned
        the error response immediately -- no second model was ever tried."""
        client = _mk_client()
        client.model_router = ModelRouter()
        attempted: list = []

        async def flaky_provider(prompt, temp, max_tok, model=None):
            attempted.append(model)
            if model == "tier-nano":
                raise ValueError("nano tier down")
            return LLMResponse(
                content="cascade-ok",
                usage=TokenUsage(input_tokens=1, output_tokens=1),
                provider="test",
                model=model,
            )

        client._call_provider = flaky_provider
        response = await client.call("validate this", role="premise_validation")
        assert attempted == ["tier-nano", "tier-budget"]
        assert response.is_error is False
        assert response.content == "cascade-ok"

    @pytest.mark.asyncio
    async def test_broken_router_falls_back_to_configured_model(self):
        class ExplodingRouter:
            def route(self, **kwargs):
                raise RuntimeError("router bug")

            def cascade(self, *args):
                raise RuntimeError("router bug")

        client = _mk_client()
        client.model_router = ExplodingRouter()
        calls: list = []
        _capture_provider(client, calls)
        response = await client.call("hello")
        assert response.is_error is False
        assert calls == [client._model]


