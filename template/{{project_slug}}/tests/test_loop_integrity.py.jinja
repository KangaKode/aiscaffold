class TestGatewayStoreFallback:
    def test_loop_flag_alone_publishes_fallback_store(self, store, monkeypatch):
        """Regression for the store-publish line: with ONLY the loop flag
        set and no activity tracking, init_detection_hooks must resolve the
        fallback store AND publish it onto app.state.learning_store -- the
        chat route reads it from there, so without the publish the scan is
        silently log-only."""
        from types import SimpleNamespace

        from {{project_slug}}.api.detection_hooks import init_detection_hooks
        from {{project_slug}}.learning import store as store_module

        monkeypatch.setenv(FLAG_ENV, "true")
        monkeypatch.setattr(store_module, "get_learning_store", lambda: store)
        application = SimpleNamespace(state=SimpleNamespace())
        init_detection_hooks(application)
        assert application.state.learning_store is store

        scan_conversation_window(
            _history([SETUP_MSG, ACTION_MSG]),
            store=application.state.learning_store,
            subject_id="sess-gw",
        )
        assert len(poisoning_flags(store)) == 1

    def test_all_toggles_off_leaves_store_attr_untouched(self):
        """Restart-with-flag-off rollback: no toggles -> the fallback block
        is skipped and learning_store is not even set on app state."""
        from types import SimpleNamespace

        from {{project_slug}}.api.detection_hooks import init_detection_hooks

        application = SimpleNamespace(state=SimpleNamespace())
        init_detection_hooks(application)
        assert not hasattr(application.state, "learning_store")
