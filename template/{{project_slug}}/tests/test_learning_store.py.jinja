    }


class TestActivityAnomaliesAPI:
    @pytest.fixture
    async def api(self, tmp_path, monkeypatch):
        """(client, store) pair -- gateway wired to a tmp-path learning store."""
        from httpx import ASGITransport, AsyncClient

        from {{project_slug}}.agents.registry import AgentRegistry
        from {{project_slug}}.api.gateway import create_app

        monkeypatch.delenv("API_KEY", raising=False)
        monkeypatch.delenv("ENV", raising=False)
        # Disable the middleware so only rows seeded by the test exist.
        monkeypatch.setenv("ACTIVITY_TRACKING_ENABLED", "false")

        app = create_app(registry=AgentRegistry(persist_path=tmp_path / "agents.json"))
        api_store = SqliteLearningStore(db_path=tmp_path / "api_learning.db")
        app.state.learning_store = api_store

        transport = ASGITransport(app=app)
        async with AsyncClient(transport=transport, base_url="http://test") as client:
            yield client, api_store

    @pytest.mark.asyncio
    async def test_list_anomalies_returns_seeded_flag(self, api):
        client, api_store = api
        api_store.insert("integrity_flags", flag_row("flag-list-001"))

        r = await client.get("/api/v1/activity/anomalies")
        assert r.status_code == 200
        data = r.json()
        assert isinstance(data["anomalies"], list)
        assert data["total"] >= 1
        assert any(a["id"] == "flag-list-001" for a in data["anomalies"])

    @pytest.mark.asyncio
    async def test_resolve_marks_flag_resolved(self, api):
        client, api_store = api
        api_store.insert("integrity_flags", flag_row("flag-res-001"))

        r = await client.post("/api/v1/activity/anomalies/flag-res-001/resolve")
        assert r.status_code == 200
        assert r.json()["status"] == "resolved"

        listing = await client.get("/api/v1/activity/anomalies")
        assert all(a["id"] != "flag-res-001" for a in listing.json()["anomalies"])

    @pytest.mark.asyncio
    async def test_auth_required_when_api_key_set(self, api, monkeypatch):
        client, _ = api
        monkeypatch.setenv("API_KEY", "test-secret-key")
        r = await client.get("/api/v1/activity/anomalies")
        assert r.status_code == 401
