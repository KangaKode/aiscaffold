def correction_row(idx: int, text: str, tenant: str = "default") -> dict:
    """A complete corrections-table row with a deterministic timestamp."""
    stamp = f"2026-01-01T00:{idx:02d}:00"
    return {
        "id": f"corr-{idx:04d}",
        "tenant_id": tenant,
        "agent_id": "analyst",
        "session_id": "",
        "original_claim": f"claim {idx}",
        "corrected_claim": text,
        "reason": "",
        "evidence_level": "documented",
        "status": "approved",
        "created_by": "alice",
        "approved_by": "bob",
        "created_at": stamp,
        "updated_at": stamp,
        "metadata_json": "{}",
    }


def propose(mgr, original="a", corrected="b", created_by="alice"):
    """Propose one correction with lean defaults."""
    return mgr.propose(agent_id="analyst", original_claim=original, corrected_claim=corrected,
                       reason="", evidence_level="documented", created_by=created_by)


def propose_approved(mgr, original="a", corrected="b"):
    """Propose (by alice) and approve (by bob) one correction."""
    correction = propose(mgr, original, corrected)
    mgr.approve(correction.id, approved_by="bob")
    return correction


# --- SQLite store -----------------------------------------------------------


class TestSqliteStore:
    def test_insert_query_update_count_round_trip(self, store):
        store.insert("corrections", correction_row(1, "the limit is 60"))

        rows = store.query("corrections", {"id": "corr-0001"})
        assert len(rows) == 1
        assert rows[0]["corrected_claim"] == "the limit is 60"
        assert rows[0]["status"] == "approved"

        assert store.update("corrections", "corr-0001", {"status": "retired"}) is True
        assert store.query("corrections", {"id": "corr-0001"})[0]["status"] == "retired"
        assert store.update("corrections", "missing-id", {"status": "retired"}) is False

        assert store.count("corrections", {"tenant_id": "default"}) == 1
        assert store.count("corrections", {"status": "proposed"}) == 0

    def test_ensure_schema_idempotent(self, store, tmp_path):
        store.insert("corrections", correction_row(1, "survives migrations"))
        store.ensure_schema()
        # Re-opening the same file runs ensure_schema again in __init__.
        reopened = SqliteLearningStore(db_path=tmp_path / "learning_store.db")
        assert reopened.count("corrections", {"id": "corr-0001"}) == 1

    def test_unknown_identifiers_rejected(self, store):
        with pytest.raises(ValueError, match="Unknown table"):
            store.insert("users", {"id": "x"})
        with pytest.raises(ValueError, match="Unknown table"):
            store.query("users", {})
        with pytest.raises(ValueError, match="Unknown columns"):
            store.insert("corrections", {"id": "x", "sneaky": 1})
        with pytest.raises(ValueError, match="Unknown columns"):
            store.query("corrections", {"sneaky": 1})

    def test_bad_order_by_and_empty_update_rejected(self, store):
        with pytest.raises(ValueError, match="Unknown columns"):
            store.query("corrections", {}, order_by="sneaky DESC")
        with pytest.raises(ValueError, match="Invalid order_by"):
            store.query("corrections", {}, order_by="created_at DESC; DROP TABLE corrections")
        with pytest.raises(ValueError, match="at least one change"):
            store.update("corrections", "corr-0001", {})

    def test_ordering_and_limit(self, store):
        for idx in (1, 2, 3):
            store.insert("corrections", correction_row(idx, f"text {idx}"))

        newest_first = store.query("corrections", {}, order_by="created_at DESC", limit=2)
        assert [r["id"] for r in newest_first] == ["corr-0003", "corr-0002"]
        assert store.query("corrections", {}, order_by="created_at")[0]["id"] == "corr-0001"


@pytest.mark.skipif(not POSTGRES_TEST_DSN, reason="LEARNING_POSTGRES_TEST_DSN not set (opt-in)")
class TestPostgresParity:
    def test_round_trip_parity(self):
        pytest.importorskip("psycopg")
        tenant = f"parity-{uuid.uuid4().hex[:8]}"
        pg = PostgresLearningStore(dsn=POSTGRES_TEST_DSN)
        try:
            row = correction_row(1, "postgres parity", tenant=tenant)
            row["id"] = uuid.uuid4().hex[:12]
            pg.insert("corrections", row)

            rows = pg.query("corrections", {"tenant_id": tenant})
            assert len(rows) == 1
            assert rows[0]["corrected_claim"] == "postgres parity"

            assert pg.update("corrections", row["id"], {"status": "retired"}) is True
            assert pg.count("corrections", {"tenant_id": tenant, "status": "retired"}) == 1
        finally:
            pg.close()


