@pytest.fixture
def guard_env(monkeypatch):
    monkeypatch.setenv("EXTRACTION_USER_THRESHOLD", "5")
    monkeypatch.setenv("EXTRACTION_TENANT_THRESHOLD", "10")
    monkeypatch.delenv("ACTIVITY_TRACKING_ENABLED", raising=False)


def seed_reads(store, n, user_id="user1", route="/api/v1/corrections",
               method="GET", minutes_ago=1, status_code=200):
    ts = datetime.now() - timedelta(minutes=minutes_ago)
    seed_events(store, [ts] * n, user_id=user_id, route=route, method=method,
                status_code=status_code)


class TestExtractionGuardModes:
    def test_below_thresholds_is_normal(self, store, guard_env):
        seed_reads(store, 3)
        result = evaluate_extraction_mode(store, user_id="user1")
        assert result["mode"] == MODE_NORMAL
        assert flags_of_type(store, FLAG_TYPE_EXTRACTION) == []

    def test_user_threshold_elevates(self, store, guard_env):
        seed_reads(store, 6)  # > 5, <= 10
        result = evaluate_extraction_mode(store, user_id="user1")
        assert result["mode"] == MODE_ELEVATED
        assert result["user_count"] == 6

    def test_double_threshold_caps(self, store, guard_env):
        seed_reads(store, 11)  # > 2 * 5
        result = evaluate_extraction_mode(store, user_id="user1")
        assert result["mode"] == MODE_CAPPED

    def test_tenant_aggregate_elevates_even_when_users_quiet(self, store, guard_env):
        for i in range(11):  # 11 users, 1 read each: tenant 11 > 10
            seed_reads(store, 1, user_id=f"user{i}")
        result = evaluate_extraction_mode(store, user_id="user1")
        assert result["mode"] == MODE_ELEVATED
        assert result["user_count"] == 1
        assert result["tenant_count"] == 11

    def test_empty_user_id_counts_tenant_scope_only(self, store, guard_env):
        seed_reads(store, 6)
        result = evaluate_extraction_mode(store, user_id="")
        assert result["user_count"] == 0
        assert result["tenant_count"] == 6
        assert result["mode"] == MODE_NORMAL  # tenant 6 <= 10

    def test_old_events_outside_window_ignored(self, store, guard_env):
        seed_reads(store, 20, minutes_ago=120)  # window default 60m
        result = evaluate_extraction_mode(store, user_id="user1")
        assert result["mode"] == MODE_NORMAL

    def test_non_get_and_non_knowledge_routes_not_counted(self, store, guard_env):
        seed_reads(store, 20, method="POST")
        seed_reads(store, 20, route="/api/v1/chat")
        result = evaluate_extraction_mode(store, user_id="user1")
        assert result["mode"] == MODE_NORMAL

    def test_auth_failures_do_not_raise_counts(self, store, guard_env):
        """Regression: keyless 401/403 spam on a knowledge route must not
        push the tenant toward the cap (that would let an attacker
        WITHOUT a valid key lock legitimate users out)."""
        seed_reads(store, 50, status_code=401)
        seed_reads(store, 50, user_id="user2", status_code=403)
        result = evaluate_extraction_mode(store, user_id="user1")
        assert result["mode"] == MODE_NORMAL
        assert result["user_count"] == 0
        assert result["tenant_count"] == 0

    def test_guard_429s_do_not_hold_the_cap(self, store, guard_env):
        """Regression: a capped client's own 429 responses must not
        refill the window, or the cap would never lift and the
        Retry-After contract would be unkeepable."""
        seed_reads(store, 11)  # capped on real reads
        assert evaluate_extraction_mode(store, user_id="user1")["mode"] == MODE_CAPPED
        # Simulate the real reads aging out of the rolling window, while
        # a retrying client keeps collecting recent 429s.
        for row in store.query("activity_events", {"status_code": 200}):
            store.delete("activity_events", row["id"])
        seed_reads(store, 50, status_code=429)
        result = evaluate_extraction_mode(store, user_id="user1")
        assert result["mode"] == MODE_NORMAL

    def test_tenant_breach_flag_names_the_tenant(self, store, guard_env):
        """When only the TENANT threshold trips, the flag subject is the
        tenant -- not whichever user happened to trigger evaluation."""
        for i in range(11):
            seed_reads(store, 1, user_id=f"user{i}")
        evaluate_extraction_mode(store, user_id="user1")
        flags = flags_of_type(store, FLAG_TYPE_EXTRACTION)
        assert len(flags) == 1
        assert flags[0]["subject_id"] == "default"

    def test_tenant_cap_with_user_only_elevated_names_tenant(self, store, guard_env):
        """When the TENANT aggregate is what capped, a caller who merely
        crossed the elevated per-user bar (but not the per-user cap bar)
        must not be flagged personally -- the capped-mode flag names the
        tenant, the dimension that actually caused the mode."""
        seed_reads(store, 6)  # user1: > 5 (elevated bar) but <= 10 (cap bar)
        for i in range(15):  # tenant total 21 > 2 * 10 -> capped
            seed_reads(store, 1, user_id=f"other{i}")
        result = evaluate_extraction_mode(store, user_id="user1")
        assert result["mode"] == MODE_CAPPED
        flags = flags_of_type(store, FLAG_TYPE_EXTRACTION)
        assert len(flags) == 1
        assert flags[0]["subject_id"] == "default"

    def test_flag_written_with_cooldown(self, store, guard_env):
        seed_reads(store, 6)
        evaluate_extraction_mode(store, user_id="user1")
        evaluate_extraction_mode(store, user_id="user1")
        assert len(flags_of_type(store, FLAG_TYPE_EXTRACTION)) == 1

    def test_capped_flag_has_error_severity(self, store, guard_env):
        seed_reads(store, 11)
        evaluate_extraction_mode(store, user_id="user1")
        flags = flags_of_type(store, FLAG_TYPE_EXTRACTION)
        assert len(flags) == 1
        assert flags[0]["severity"] == "error"

    def test_include_current_counts_the_inflight_request(self, store, guard_env):
        seed_reads(store, 10)  # exactly at the 2x cap boundary
        at_rest = evaluate_extraction_mode(store, user_id="user1")
        assert at_rest["mode"] == MODE_ELEVATED  # 10 is not > 10
        in_flight = evaluate_extraction_mode(store, user_id="user1",
                                             include_current=True)
        assert in_flight["mode"] == MODE_CAPPED  # 11 > 10
        assert in_flight["user_count"] == 11
        assert in_flight["tenant_count"] == 11

    def test_noise_traffic_cannot_evict_knowledge_reads(self, store, guard_env):
        seed_reads(store, 6)
        # Newer cheap noise to another route (more rows than the fetch
        # cap) must not push the knowledge reads out of the fetched rows
        # (the guard queries each exact knowledge route separately).
        seed_reads(store, 2100, route="/api/v1/chat", method="POST",
                   minutes_ago=0)
        result = evaluate_extraction_mode(store, user_id="user1")
        assert result["mode"] == MODE_ELEVATED
        assert result["user_count"] == 6


class TestExtractionGuardDegradation:
    def test_normal_when_tracking_disabled(self, store, guard_env, monkeypatch):
