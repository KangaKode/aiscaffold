def seed_events(store, timestamps, user_id="user1", tenant_id="default",
                route="/api/v1/chat", method="POST", status_code=200):
    for ts in timestamps:
        store.insert("activity_events", {
            "id": str(uuid.uuid4())[:12],
            "tenant_id": tenant_id,
            "user_id": user_id,
            "route": route,
            "method": method,
            "status_code": status_code,
            "created_at": ts.isoformat(),
        })


def regular_times(n, step_seconds=5.0, end=None):
    """n timestamps at a perfectly regular cadence, ending near `end`."""
    end = end or datetime.now()
    start = end - timedelta(seconds=(n - 1) * step_seconds)
    return [start + timedelta(seconds=i * step_seconds) for i in range(n)]


def flags_of_type(store, flag_type, tenant_id="default"):
    return store.query("integrity_flags",
                       {"flag_type": flag_type, "tenant_id": tenant_id})


# --- Timing-regularity CV math -----------------------------------------------


class TestTimingCV:
    def test_regular_cadence_flags(self, store):
        seed_events(store, regular_times(30))
        finding = check_timing_regularity(store, "user1")
        assert finding is not None
        assert finding["cv"] < 0.1
        assert len(flags_of_type(store, FLAG_TYPE_TIMING)) == 1

    def test_random_cadence_does_not_flag(self, store):
        steps = [1, 9, 2, 15, 3, 27, 4, 11] * 4  # highly irregular
        now = datetime.now()
        times, offset = [], 0.0
        for step in steps:
            offset += step
            times.append(now - timedelta(seconds=1000) + timedelta(seconds=offset))
        seed_events(store, times)
        assert check_timing_regularity(store, "user1") is None
        assert flags_of_type(store, FLAG_TYPE_TIMING) == []

    def test_below_min_samples_no_verdict(self, store):
        seed_events(store, regular_times(10))  # 9 intervals < 20
        assert check_timing_regularity(store, "user1") is None

    def test_zero_intervals_tolerated(self, store):
        # Concurrent requests: pairs of identical timestamps 10s apart.
        base_times = regular_times(15, step_seconds=10.0)
        seed_events(store, [t for t in base_times for _ in range(2)])
        # Alternating ~0s / ~10s intervals -> high CV, no crash, no flag.
        assert check_timing_regularity(store, "user1") is None

    def test_all_concurrent_no_divide_by_zero(self, store):
        now = datetime.now()
        seed_events(store, [now] * 25)  # all intervals zero -> mean ~0
        assert check_timing_regularity(store, "user1") is None

    def test_near_zero_mean_returns_none(self):
        assert compute_interval_cv([0.0] * 25) is None
        assert compute_interval_cv([]) is None

    def test_excluded_routes_not_in_series(self, store):
        seed_events(store, regular_times(30), route="/health", method="GET")
        assert check_timing_regularity(store, "user1") is None


class TestTimingFlagCooldown:
    def test_second_evaluation_does_not_duplicate(self, store):
        seed_events(store, regular_times(30))
        assert check_timing_regularity(store, "user1") is not None
        assert check_timing_regularity(store, "user1") is not None
        assert len(flags_of_type(store, FLAG_TYPE_TIMING)) == 1

    def test_resolving_the_flag_rearms_detection(self, store):
        seed_events(store, regular_times(30))
        check_timing_regularity(store, "user1")
        flag = flags_of_type(store, FLAG_TYPE_TIMING)[0]
        store.update("integrity_flags", flag["id"], {"resolved": 1})
        check_timing_regularity(store, "user1")
        assert len(flags_of_type(store, FLAG_TYPE_TIMING)) == 2


class TestTimingWindow:
    def test_old_irregular_history_does_not_dilute_recent_regular(self, store):
        # Irregular traffic 3 hours ago (outside TIMING_WINDOW_MINUTES=60)
        # must not rescue a machine-regular cadence inside the window.
        old_base = datetime.now() - timedelta(hours=3)
        offset, irregular = 0.0, []
        for step in [1, 9, 2, 15, 3, 27, 4, 11] * 4:
            offset += step
            irregular.append(old_base + timedelta(seconds=offset))
        seed_events(store, irregular)
        seed_events(store, regular_times(25))

        finding = check_timing_regularity(store, "user1")
        assert finding is not None
        assert finding["intervals"] == 24  # only the in-window events


class TestSeverityEscalation:
    def test_capped_after_elevated_inserts_error_flag(self, store, guard_env):
        seed_reads(store, 6)  # elevated -> warning flag
        assert evaluate_extraction_mode(store, user_id="user1")["mode"] == MODE_ELEVATED
        seed_reads(store, 5)  # now 11 -> capped -> escalation must surface
        assert evaluate_extraction_mode(store, user_id="user1")["mode"] == MODE_CAPPED

        flags = flags_of_type(store, FLAG_TYPE_EXTRACTION)
        assert sorted(f["severity"] for f in flags) == ["error", "warning"]

    def test_lower_severity_skipped_when_error_unresolved(self, store):
        assert insert_flag_once(store, "extraction_volume_anomaly", "user1",
                                "default", {"mode": "capped"}, severity="error")
        assert not insert_flag_once(store, "extraction_volume_anomaly", "user1",
                                    "default", {"mode": "elevated"},
                                    severity="warning")
        assert len(flags_of_type(store, FLAG_TYPE_EXTRACTION)) == 1


class TestActivityThresholdCooldown:
    def test_sustained_burst_inserts_exactly_one_flag(self, store):
        tracker = ActivityTracker(store)
        for _ in range(6):
            tracker.record("/api/v1/chat", "POST", 200, user_id="user1")

        limits = {"requests_per_hour": 5}
        assert tracker.check_thresholds("user1", thresholds=limits)
        assert tracker.check_thresholds("user1", thresholds=limits)
        assert len(flags_of_type(store, FLAG_TYPE_USER_ANOMALY)) == 1


