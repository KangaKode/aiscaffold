class TestPairCheckWiredIntoApproval:
    async def test_approval_triggers_pair_check(self, api, monkeypatch):
        client, app = api
        monkeypatch.setenv("PAIR_APPROVAL_THRESHOLD", "5")
        manager = app.state.corrections_manager
        ids = []
        for i in range(6):
            c = manager.propose(
                agent_id="analyst",
                original_claim=f"claim {i} about limits",
                corrected_claim=f"corrected claim {i} about limits",
                reason="vendor docs", evidence_level="documented",
                created_by="alice",
            )
            ids.append(c.id)
        # Keyless dev mode: the API approver is "anon" != "alice".
        for cid in ids:
            r = await client.post(f"/api/v1/corrections/{cid}/approve")
            assert r.status_code == 200

        flags = flags_of_type(app.state.learning_store, FLAG_TYPE_PAIR)
        assert len(flags) == 1
        assert flags[0]["subject_id"] == "alice->anon"
