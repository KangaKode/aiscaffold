# --- API-level tenant isolation ----------------------------------------------


REGISTRATION = {
    "name": "shared_bot",
    "domain": "code analysis",
    "base_url": "https://agents.example.com",
    "capabilities": ["testing"],
}


class TenantSwitch:
    """Mutable auth identity the dependency override reads per request."""

    def __init__(self):
        self.tenant_id = "default"
        self.user_id = "anon"


@pytest.fixture
async def api(tmp_path, monkeypatch):
    """(client, app, switch): gateway whose auth resolves to a switchable
    tenant, mirroring request.state.auth_context exactly like the real
    verify_api_key does once an IdP integration supplies tenant ids."""
    from httpx import ASGITransport, AsyncClient
    from starlette.requests import Request

    from {{project_slug}}.api.gateway import create_app
    from {{project_slug}}.api.middleware.auth import AuthContext, verify_api_key

    monkeypatch.delenv("API_KEY", raising=False)
    monkeypatch.delenv("ENV", raising=False)
    monkeypatch.setenv("ACTIVITY_TRACKING_ENABLED", "false")
    monkeypatch.chdir(tmp_path)

    app = create_app(registry=AgentRegistry(persist_path=tmp_path / "agents.json"))
    switch = TenantSwitch()

    async def _switched_auth(request: Request) -> AuthContext:
        context = AuthContext(
            api_key=None, user_id=switch.user_id, tenant_id=switch.tenant_id
        )
        request.state.auth_context = context
        return context

    app.dependency_overrides[verify_api_key] = _switched_auth
    transport = ASGITransport(app=app)
    async with AsyncClient(transport=transport, base_url="http://test") as client:
        yield client, app, switch


async def register_as(client, switch, tenant_id, **overrides):
    switch.tenant_id = tenant_id
    r = await client.post("/api/v1/agents", json={**REGISTRATION, **overrides})
    assert r.status_code == 200, r.text
    return r


class TestAgentsAPITenantIsolation:
    CROSS_TENANT_CALLS = [
        ("get", "/api/v1/agents/shared_bot"),
        ("delete", "/api/v1/agents/shared_bot"),
        ("post", "/api/v1/agents/shared_bot/credentials/rotate"),
        ("delete", "/api/v1/agents/shared_bot/credentials"),
        ("post", "/api/v1/agents/shared_bot/suspend"),
        ("post", "/api/v1/agents/shared_bot/unsuspend"),
    ]

    async def test_cross_tenant_operations_read_as_404(self, api):
        client, _, switch = api
        await register_as(client, switch, "tenant-a")

        switch.tenant_id = "tenant-b"
        for method, path in self.CROSS_TENANT_CALLS:
            r = await getattr(client, method)(path)
            assert r.status_code == 404, f"{method.upper()} {path}: {r.status_code}"
            # 404 (not 403): existence in another tenant must not leak.

    async def test_rotate_never_mints_cross_tenant_token(self, api):
        """The takeover primitive: rotate must not hand tenant-b a valid
        identity token for tenant-a's agent."""
        client, _, switch = api
        await register_as(client, switch, "tenant-a")

        switch.tenant_id = "tenant-b"
        r = await client.post("/api/v1/agents/shared_bot/credentials/rotate")
        assert r.status_code == 404
        assert "identity_token" not in r.text

        switch.tenant_id = "tenant-a"
        r = await client.post("/api/v1/agents/shared_bot/credentials/rotate")
        assert r.status_code == 200
        assert r.json()["identity_token"]

    async def test_listing_shows_only_callers_tenant(self, api):
        client, _, switch = api
        await register_as(client, switch, "tenant-a")

        switch.tenant_id = "tenant-b"
        r = await client.get("/api/v1/agents")
        assert r.status_code == 200
        assert r.json()["total"] == 0
        assert all(a["name"] != "shared_bot" for a in r.json()["agents"])

        switch.tenant_id = "tenant-a"
        r = await client.get("/api/v1/agents")
        assert [a["name"] for a in r.json()["agents"]] == ["shared_bot"]

    async def test_health_check_scoped_to_tenant(self, api):
        client, _, switch = api
        await register_as(client, switch, "tenant-a")

        switch.tenant_id = "tenant-b"
        r = await client.post("/api/v1/agents/health")
        assert r.status_code == 200
        assert "shared_bot" not in r.json()["results"]

    async def test_same_name_registers_in_both_tenants(self, api):
        """(tenant, name) keying: no cross-tenant 409, no overwrite."""
        client, app, switch = api
        await register_as(client, switch, "tenant-a")
        await register_as(
            client, switch, "tenant-b", base_url="https://b.example.com"
        )

        assert app.state.registry.count == 2
        switch.tenant_id = "tenant-a"
        r = await client.get("/api/v1/agents/shared_bot")
        assert r.json()["base_url"] == "https://agents.example.com"
        switch.tenant_id = "tenant-b"
        r = await client.get("/api/v1/agents/shared_bot")
        assert r.json()["base_url"] == "https://b.example.com"

    async def test_duplicate_within_tenant_still_409(self, api):
        client, _, switch = api
        await register_as(client, switch, "tenant-a")
        r = await client.post("/api/v1/agents", json=REGISTRATION)
        assert r.status_code == 409

    async def test_single_tenant_lifecycle_unchanged(self, api):
        """Default-tenant callers keep the full historical flow."""
        client, _, switch = api
        await register_as(client, switch, "default")

        assert (await client.get("/api/v1/agents/shared_bot")).status_code == 200
        r = await client.post("/api/v1/agents/shared_bot/credentials/rotate")
        assert r.status_code == 200
        assert (
            await client.post("/api/v1/agents/shared_bot/suspend")
        ).status_code == 200
        assert (
            await client.post("/api/v1/agents/shared_bot/unsuspend")
        ).status_code == 200
        assert (await client.delete("/api/v1/agents/shared_bot")).status_code == 200


