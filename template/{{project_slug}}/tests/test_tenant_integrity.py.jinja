class TestFourEyesAPI:
    async def test_default_mode_allows_single_key_approval(self, api, monkeypatch):
        """Under the single-key identity default, approvals must work --
        loudly -- instead of being silently impossible."""
        monkeypatch.delenv("CORRECTIONS_FOUR_EYES", raising=False)
        client, app, _ = api
        r = await client.post("/api/v1/corrections", json=PROPOSAL)
        correction_id = r.json()["id"]

        r = await client.post(f"/api/v1/corrections/{correction_id}/approve")
        assert r.status_code == 200
        assert r.json()["status"] == STATUS_APPROVED

        store = app.state.corrections_manager.store
        flags = store.query("integrity_flags", {"flag_type": FLAG_TYPE_FOUR_EYES})
        assert len(flags) == 1

    async def test_strict_mode_rejects_single_key_approval(self, api, monkeypatch):
        monkeypatch.setenv("CORRECTIONS_FOUR_EYES", "strict")
        client, _, _ = api
        r = await client.post("/api/v1/corrections", json=PROPOSAL)
        correction_id = r.json()["id"]

        r = await client.post(f"/api/v1/corrections/{correction_id}/approve")
        assert r.status_code == 409
        assert "Four-eyes" in r.json()["detail"]
