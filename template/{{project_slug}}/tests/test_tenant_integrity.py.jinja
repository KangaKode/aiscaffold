class TestActivityTenantAttribution:
    async def test_events_carry_callers_tenant(self, tracking_api):
        client, app, switch = tracking_api
        switch.tenant_id = "tenant-a"
        switch.user_id = "user-a"

        r = await client.get("/api/v1/agents")
        assert r.status_code == 200

        rows = app.state.learning_store.query(
            "activity_events", {"route": "/api/v1/agents"}
        )
        assert rows, "expected the request to be recorded"
        assert {row["tenant_id"] for row in rows} == {"tenant-a"}
        assert {row["user_id"] for row in rows} == {"user-a"}

    async def test_unauthenticated_routes_fall_back_to_default(self, tracking_api):
        client, app, _ = tracking_api
        r = await client.get("/health")
        assert r.status_code == 200
        rows = app.state.learning_store.query(
            "activity_events", {"route": "/health"}
        )
        assert rows
        assert {row["tenant_id"] for row in rows} == {"default"}

    async def test_default_tenant_warning_fires_once(
        self, tracking_api, monkeypatch, caplog
    ):
        monkeypatch.setenv("MULTI_TENANT_AUTH_ENABLED", "true")
        client, _, switch = tracking_api
        switch.tenant_id = "default"

        def misattribution_warnings():
            return [
                r for r in caplog.records
                if "MULTI_TENANT_AUTH_ENABLED" in r.message
            ]

        with caplog.at_level("WARNING"):
            assert (await client.get("/api/v1/agents")).status_code == 200
            assert len(misattribution_warnings()) == 1
            # Inert and one-time: later default-tenant events stay silent
            # and are still recorded normally.
            assert (await client.get("/api/v1/agents")).status_code == 200
            assert len(misattribution_warnings()) == 1

    async def test_unauthenticated_fallback_does_not_burn_warning(
        self, tracking_api, monkeypatch, caplog
    ):
        """An unauthenticated request (no auth context, e.g. a /health
        probe) legitimately falls back to the default tenant; it must not
        consume the one-time warning, which still fires for the first
        AUTHENTICATED default-tenant event."""
        monkeypatch.setenv("MULTI_TENANT_AUTH_ENABLED", "true")
        client, _, switch = tracking_api
        switch.tenant_id = "default"

        def misattribution_warnings():
            return [
                r for r in caplog.records
                if "MULTI_TENANT_AUTH_ENABLED" in r.message
            ]

        with caplog.at_level("WARNING"):
            assert (await client.get("/health")).status_code == 200
            assert misattribution_warnings() == []
            assert (await client.get("/api/v1/agents")).status_code == 200
            assert len(misattribution_warnings()) == 1

    async def test_no_warning_without_declared_multi_tenancy(
        self, tracking_api, monkeypatch, caplog
    ):
        monkeypatch.delenv("MULTI_TENANT_AUTH_ENABLED", raising=False)
        client, _, _ = tracking_api
        with caplog.at_level("WARNING"):
            assert (await client.get("/api/v1/agents")).status_code == 200
        assert not any(
            "MULTI_TENANT_AUTH_ENABLED" in r.message for r in caplog.records
        )


