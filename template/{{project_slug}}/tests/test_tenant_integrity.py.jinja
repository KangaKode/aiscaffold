from {{project_slug}}.orchestration.identity_check import verify_agent_identity


class SimpleAgent:
    """Minimal agent satisfying the registry's name/domain protocol."""

    def __init__(self, name, domain="general analysis"):
        self._name = name
        self._domain = domain

    @property
    def name(self) -> str:
        return self._name

    @property
    def domain(self) -> str:
        return self._domain


@pytest.fixture
def registry(tmp_path):
    return AgentRegistry(persist_path=tmp_path / "agents.json")


@pytest.fixture
def store(tmp_path):
    return SqliteLearningStore(db_path=tmp_path / "learning_store.db")


# --- Registry (tenant, name) keying -----------------------------------------


class TestRegistryTenantKeying:
    def test_same_name_coexists_across_tenants(self, registry):
        registry.register_remote(
            "shared_bot", "analysis", "https://a.example.com", tenant_id="tenant-a"
        )
        registry.register_remote(
            "shared_bot", "analysis", "https://b.example.com", tenant_id="tenant-b"
        )
        assert registry.count == 2
        entry_a = registry.get_entry("shared_bot", tenant_id="tenant-a")
        entry_b = registry.get_entry("shared_bot", tenant_id="tenant-b")
        assert entry_a is not entry_b
        assert entry_a.agent._base_url == "https://a.example.com"
        assert entry_b.agent._base_url == "https://b.example.com"

    def test_tenant_scoped_lookup_misses_other_tenant(self, registry):
        registry.register_remote(
            "team_bot", "analysis", "https://a.example.com", tenant_id="tenant-a"
        )
        assert registry.get("team_bot", tenant_id="tenant-b") is None
        assert registry.get_entry("team_bot", tenant_id="tenant-b") is None
        assert registry.rotate_credentials("team_bot", tenant_id="tenant-b") is None
        assert registry.revoke_credentials("team_bot", tenant_id="tenant-b") is False
        assert registry.suspend("team_bot", tenant_id="tenant-b") is False
        assert registry.unregister("team_bot", tenant_id="tenant-b") is False
        # The owning tenant still resolves it.
        assert registry.get("team_bot", tenant_id="tenant-a") is not None

    def test_tenant_scoped_unregister_leaves_other_tenants_agent(self, registry):
        registry.register_remote(
            "shared_bot", "analysis", "https://a.example.com", tenant_id="tenant-a"
        )
        registry.register_remote(
            "shared_bot", "analysis", "https://b.example.com", tenant_id="tenant-b"
        )
        assert registry.unregister("shared_bot", tenant_id="tenant-a") is True
        assert registry.get("shared_bot", tenant_id="tenant-a") is None
        assert registry.get("shared_bot", tenant_id="tenant-b") is not None

    def test_ambiguous_tenantless_lookup_resolves_to_none(self, registry):
        """A bare-name lookup must never guess between two tenants."""
        registry.register_remote(
            "shared_bot", "analysis", "https://a.example.com", tenant_id="tenant-a"
        )
        registry.register_remote(
            "shared_bot", "analysis", "https://b.example.com", tenant_id="tenant-b"
        )
        assert registry.get_entry("shared_bot") is None

    def test_tenant_keying_survives_persistence_reload(self, tmp_path):
        path = tmp_path / "agents.json"
        registry = AgentRegistry(persist_path=path)
        registry.register_remote(
            "shared_bot", "analysis", "https://a.example.com", tenant_id="tenant-a"
        )
        registry.register_remote(
            "shared_bot", "analysis", "https://b.example.com", tenant_id="tenant-b"
        )
        reloaded = AgentRegistry(persist_path=path)
        assert reloaded.count == 2
        assert (
            reloaded.get_entry("shared_bot", tenant_id="tenant-b").agent._base_url
            == "https://b.example.com"
        )

    def test_single_tenant_behavior_unchanged(self, registry):
        """Default-tenant deployments keep the historical name-keyed flow:
        tenant-less registration and lookups all resolve the same entry."""
        registry.register_local(SimpleAgent("solo_agent"), capabilities=["testing"])
        assert registry.get("solo_agent") is not None
        assert registry.get_entry("solo_agent").tenant_id == "default"
        assert registry.get("solo_agent", tenant_id="default") is not None
        assert registry.suspend("solo_agent") is True
        assert registry.get_entry("solo_agent").suspended is True
        assert registry.unsuspend("solo_agent") is True
        token = registry.rotate_credentials("solo_agent")
        assert token is None or isinstance(token, str)
        assert registry.unregister("solo_agent") is True

    def test_mutated_entry_tenant_still_resolves_by_tenant(self, registry):
        """PLATFORM_GUIDE documents mutating entry.tenant_id in place after
        register_local; tenant-scoped lookups must honor the attribute."""
        registry.register_local(SimpleAgent("team_local"), capabilities=["testing"])
        registry.get_entry("team_local").tenant_id = "tenant-a"
        assert registry.get_entry("team_local", tenant_id="tenant-a") is not None
        assert registry.get_entry("team_local", tenant_id="tenant-b") is None


# --- Dispatch gates under cross-tenant name collision -------------------------


@dataclass
class GateTask:
    """Minimal dataclass task for gate_agents (scope filter uses replace())."""

    context: dict[str, Any] = field(default_factory=dict)


def register_shared_bot(registry, tenant_id, **kwargs):
    return registry.register_remote(
        "shared_bot",
        "analysis",
        f"https://{tenant_id}.example.com",
        tenant_id=tenant_id,
        **kwargs,
    )


class TestDispatchGatesUnderCollision:
    """A second tenant registering the same agent name must not weaken
    the gates protecting the first tenant's agent (fail-open regression)."""

    def test_revoked_agent_stays_blocked_after_collision(self, registry):
        agent_a = register_shared_bot(registry, "tenant-a")
        registry.revoke_credentials("shared_bot", tenant_id="tenant-a")
        assert verify_agent_identity(agent_a, registry) is False

        register_shared_bot(registry, "tenant-b")
        # Revocation bypass: pre-fix, the now-ambiguous name lookup made
        # the revoked agent read as unregistered -> allowed.
        assert verify_agent_identity(agent_a, registry) is False

    def test_suspended_agent_stays_blocked_after_collision(self, registry):
        agent_a = register_shared_bot(registry, "tenant-a")
        registry.suspend("shared_bot", tenant_id="tenant-a")
        register_shared_bot(registry, "tenant-b")
        assert verify_agent_identity(agent_a, registry) is False

    def test_registered_but_unresolvable_agent_fails_closed(self, registry):
        """An agent OBJECT the registry does not hold, with a name that is
        registered ambiguously, must be blocked -- not treated as
        unregistered."""
        register_shared_bot(registry, "tenant-a")
        register_shared_bot(registry, "tenant-b")
        outsider = SimpleAgent("shared_bot")
        assert verify_agent_identity(outsider, registry) is False
        # Truly unregistered names keep the historical allow.
        assert verify_agent_identity(SimpleAgent("ghost"), registry) is True

    def test_capability_still_resolves_after_collision(self, registry):
        agent_a = register_shared_bot(
            registry, "tenant-a", access_scopes=["sales_data"]
        )
        register_shared_bot(registry, "tenant-b")
        capability = get_capability(registry, agent_a)
        assert capability is not None
        assert capability.access_scopes == ["sales_data"]

    def test_scope_filter_still_applies_after_collision(self, registry):
        """Pre-fix, the collision resolved capability to None and ScopeFilter
        passed the FULL task context to the scoped agent."""
        agent_a = register_shared_bot(
            registry, "tenant-a", access_scopes=["sales_data"]
        )
        register_shared_bot(registry, "tenant-b")
        task = GateTask(context={"sales_data": [1], "hr_records": [2]})

        gated, skipped = gate_agents([agent_a], task, registry, None, "Test")

        assert skipped == 0 and len(gated) == 1
        _, gated_task, capability = gated[0]
        assert capability is not None
        assert "sales_data" in gated_task.context
        assert "hr_records" not in gated_task.context

    def test_touch_last_active_updates_owning_entry(self, registry):
        agent_a = register_shared_bot(registry, "tenant-a")
        register_shared_bot(registry, "tenant-b")
        entry_a = registry.get_entry("shared_bot", tenant_id="tenant-a")
        entry_b = registry.get_entry("shared_bot", tenant_id="tenant-b")
        stale = "2000-01-01T00:00:00+00:00"
        entry_a.last_active = stale
        entry_b.last_active = stale

        gate_agents([agent_a], GateTask(), registry, None, "Test")

        assert entry_a.last_active != stale, "dispatched entry must be touched"
        assert entry_b.last_active == stale, "other tenant's entry untouched"


# --- Four-eyes enforceability posture ----------------------------------------


def propose(mgr, created_by="alice", tenant_id="default"):
    return mgr.propose(
        agent_id="analyst",
        original_claim="rate limit is 100",
        corrected_claim="rate limit is 60",
        reason="vendor docs",
        evidence_level="documented",
        created_by=created_by,
        tenant_id=tenant_id,
    )


class TestFourEyesModes:
    def test_default_warn_mode_allows_and_flags_self_approval(
        self, store, monkeypatch, caplog
    ):
        monkeypatch.delenv("CORRECTIONS_FOUR_EYES", raising=False)
        mgr = CorrectionsManager(store)
        correction = propose(mgr, created_by="alice")

        with caplog.at_level("WARNING"):
            approved = mgr.approve(correction.id, approved_by="alice")

        assert approved.status == STATUS_APPROVED
        assert any("NOT enforceable" in r.message for r in caplog.records)
        flags = store.query(
            "integrity_flags", {"flag_type": FLAG_TYPE_FOUR_EYES}
        )
        assert len(flags) == 1
        assert flags[0]["subject_id"] == "alice"

    def test_warn_mode_flags_once_per_subject(self, store, monkeypatch):
        monkeypatch.setenv("CORRECTIONS_FOUR_EYES", "warn")
        mgr = CorrectionsManager(store)
        for _ in range(2):
            correction = propose(mgr, created_by="alice")
            mgr.approve(correction.id, approved_by="alice")
        flags = store.query(
            "integrity_flags", {"flag_type": FLAG_TYPE_FOUR_EYES}
        )
        assert len(flags) == 1  # unresolved flag arms the cooldown

    def test_strict_mode_rejects_self_approval(self, store, monkeypatch):
        monkeypatch.setenv("CORRECTIONS_FOUR_EYES", "strict")
        mgr = CorrectionsManager(store)
        correction = propose(mgr, created_by="alice")
        with pytest.raises(ValueError, match="Four-eyes"):
            mgr.approve(correction.id, approved_by="alice")
        assert mgr.get(correction.id).status == STATUS_PROPOSED
        # No unenforceability flag: strict mode enforced, nothing degraded.
        assert store.query(
            "integrity_flags", {"flag_type": FLAG_TYPE_FOUR_EYES}
        ) == []

    def test_strict_mode_still_allows_distinct_approver(self, store, monkeypatch):
        monkeypatch.setenv("CORRECTIONS_FOUR_EYES", "strict")
        mgr = CorrectionsManager(store)
        correction = propose(mgr, created_by="alice")
        assert mgr.approve(correction.id, approved_by="bob").status == STATUS_APPROVED

    def test_explicit_booleans_override_env(self, store, monkeypatch):
        monkeypatch.setenv("CORRECTIONS_FOUR_EYES", "warn")
        strict_mgr = CorrectionsManager(store, require_four_eyes=True)
        correction = propose(strict_mgr, created_by="alice")
        with pytest.raises(ValueError, match="Four-eyes"):
            strict_mgr.approve(correction.id, approved_by="alice")

        monkeypatch.setenv("CORRECTIONS_FOUR_EYES", "strict")
        off_mgr = CorrectionsManager(store, require_four_eyes=False)
        correction = propose(off_mgr, created_by="alice")
        approved = off_mgr.approve(correction.id, approved_by="alice")
        assert approved.status == STATUS_APPROVED
        # Silent-off records no unenforceability flag.
        assert store.query(
            "integrity_flags", {"flag_type": FLAG_TYPE_FOUR_EYES}
        ) == []

    def test_invalid_mode_falls_back_to_warn(self, store, monkeypatch):
        monkeypatch.setenv("CORRECTIONS_FOUR_EYES", "sideways")
        mgr = CorrectionsManager(store)
        correction = propose(mgr, created_by="alice")
        assert mgr.approve(correction.id, approved_by="alice").status == STATUS_APPROVED


