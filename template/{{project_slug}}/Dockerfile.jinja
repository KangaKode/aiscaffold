# {{ project_name }} - Multi-stage Docker build
# Generated by aiscaffold v3

# =============================================================================
# Stage 1: Builder -- install dependencies
# =============================================================================
FROM python:{{ python_version }}-slim AS builder

WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# =============================================================================
# Stage 2: Runtime -- minimal image with non-root user
# =============================================================================
FROM python:{{ python_version }}-slim

# Security: run as non-root user
RUN useradd --create-home --shell /bin/bash appuser

WORKDIR /app

# Copy installed dependencies from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY . .

# Install the generated src-layout package so imports work without PYTHONPATH.
RUN pip install --no-cache-dir --no-deps -e .

# Switch to non-root user
USER appuser

{% if include_api_gateway -%}
# Expose API port
EXPOSE 8000

# Health check (used by Docker and orchestrators). Only meaningful when the
# API gateway is included -- a gateway-off image runs no HTTP server.
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Start the API gateway (python -m reads API_HOST/API_PORT/LOG_LEVEL)
ENV API_HOST=0.0.0.0
CMD ["python", "-m", "{{ project_slug }}"]
{% else -%}
# No API gateway in this project: no port, no HTTP health check.
# Default entrypoint prints usage -- override in docker-compose or K8s
# with your own long-running command.
CMD ["python", "-m", "{{ project_slug }}"]
{% endif -%}
