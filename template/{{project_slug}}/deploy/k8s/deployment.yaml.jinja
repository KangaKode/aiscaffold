# {{ project_name }} - Kubernetes Deployment
# Generated by aiscaffold v3
#
# Apply: kubectl apply -f deploy/k8s/
# Status: kubectl get pods -l app={{ project_slug }}

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ project_slug }}
  labels:
    app: {{ project_slug }}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: {{ project_slug }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    metadata:
      labels:
        app: {{ project_slug }}
    spec:
      containers:
        - name: {{ project_slug }}
          # Replace `latest` with an immutable release tag in production.
          image: {{ project_slug }}:latest
          ports:
            - containerPort: 8000
              name: http
          envFrom:
            - configMapRef:
                name: {{ project_slug }}-config
            - secretRef:
                name: {{ project_slug }}-secrets
                optional: true
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
            limits:
              cpu: "1000m"
              memory: "1Gi"
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
          readinessProbe:
            # Starter readiness uses liveness so fresh deployments become ready
            # before agents are registered. Use /health/ready after bootstrapping
            # required agents and dependencies for your environment.
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          securityContext:
            runAsNonRoot: true
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: data
              mountPath: /app/data
            - name: artifacts
              mountPath: /app/.aiscaffold
      volumes:
        - name: data
          emptyDir: {}
          # For persistent storage, replace emptyDir with a PVC:
          # persistentVolumeClaim:
          #   claimName: {{ project_slug }}-data
        - name: artifacts
          emptyDir: {}
          # For persistent artifacts/state, replace emptyDir with a PVC:
          # persistentVolumeClaim:
          #   claimName: {{ project_slug }}-artifacts
